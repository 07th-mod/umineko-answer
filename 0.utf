;キャラボタンを押した時の処理。主に、キャラの絵を変えるのに役立つ。
	*change_btn_m
		;画像の切り替えと、ポイントのやりとり。チェックを外すと-100。チェックをつけると+100
		if ?m_sys[%btnres] = 2 : mov ?m_sys[%btnres],1 : sub %murder_check,100 : jumpf
		if ?m_sys[%btnres] = 1 : mov ?m_sys[%btnres],2 : add %murder_check,100
		~
	return

;キャラボタンを押した時の処理。主に、キャラの絵を変えるのに役立つ。＠犯人たち
	*change_btn_m_2
		;画像の切り替えと、ポイントのやりとり。チェックを外すと-100。チェックをつけると+100
		if ?m_sys[%btnres] = 2 : mov ?m_sys[%btnres],1 : dec %murder_check : jumpf
		if ?m_sys[%btnres] = 1 : mov ?m_sys[%btnres],2 : inc %murder_check
		~
	return



