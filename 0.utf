_ld r,":b;sprites\wil\1\wil_a11_majime1.png",24
advsetwindow "-1"

langjp「そうだな、俺たちは異端審問官だ。@邪悪な魔女を討つ、それが商売さ。@だが、万一にも市民を傷つけてはならない。@疑ってはならない…！@　人間は誰しも自分だけの真実を持つ。@それは、罪を犯した時にのみ暴かれる。@俺たちにはそれを暴く資格が与えられている。@/
langen:dwave 0, "voice\54\75400053.ogg":^"That's right, we are Inquisitors of Heresy.^@:dwave 0, "voice\54\75400054.ogg":^  Felling evil witches is our job.^@:dwave 0, "voice\54\75400055.ogg":^  However, we mustn't risk hurting the innocent.^@:dwave 0, "voice\54\75400056.ogg":^  We mustn't put them under suspicion...!^\:dwave 0, "voice\54\75400057.ogg":^  All humans have their own personal truths.^@:dwave 0, "voice\54\75400058.ogg":^  Those should only be exposed when they commit crimes.^@:dwave 0, "voice\54\75400059.ogg":^  We've been given the right to expose them.^@/
advsetwindow "-1"

;ld r,WIL_MajimeA1,80

