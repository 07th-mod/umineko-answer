 inc %flg_number_o

 if %flg_number_o = 1 mov $flg_pass1,"bmp\efe\number\1.bmp" : jumpf
 if %flg_number_o = 2 mov $flg_pass1,"bmp\efe\number\2.bmp" : jumpf
 if %flg_number_o = 3 mov $flg_pass1,"bmp\efe\number\3.bmp" : jumpf
