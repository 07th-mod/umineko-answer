*bgm_mode_ride_on
	if %bgm_mood_demo = 1 goto *demo_hyouji
	gosub *bgm_mode_k : print 22
	gosub *bgm_play

	rnd2 %ran2,1,2
	notif %ran2 = 1 goto *bgm_mode_ride_on_2000
		trap *bgm_mode_ride_on_1000
		mov %free1,8000
		lsp 510,r_black,0,0 : print 24
		mov $tmp,":c;" : add $tmp,OP0101 : lsp 510,$tmp,0,0 : print 2
		delay %free1
		delay 1000
		lsp 510,r_white,0,0 : print 24
		mov $tmp,":c;" : add $tmp,OP0102 : lsp 510,$tmp,0,0 : print 2
		delay %free1
		lsp 510,r_white,0,0 : print 24
		mov $tmp,":c;" : add $tmp,OP0103 : lsp 510,$tmp,0,0 : print 2
		delay %free1
		lsp 510,r_white,0,0 : print 24
		mov $tmp,":c;" : add $tmp,OP0104 : lsp 510,$tmp,0,0 : print 2
		delay %free1
		lsp 510,r_white,0,0 : print 24
		mov $tmp,":c;" : add $tmp,OP0105 : lsp 510,$tmp,0,0 : print 2
		delay %free1
