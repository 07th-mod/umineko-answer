_ld r,":b;sprites\en2\1\en2_a15_def2b.png",2

delay 500

;cl l,23
_ld c,":b;sprites\bea\1\bea_b14_1_warai1.png",24
advsetwindow "-1"

langjp　魔女は、可愛らしく包装されたその飴玉を、縁寿にプレゼントする。@
langen^The witch gave the cutely wrapped candy to Ange as a present.^@
advsetwindow "-1"
;br
langjp　縁寿はそれを受け取り、何か仕掛けがあるはずだと躍起になるが、それは何の変哲もない、本当にただの飴玉だった……。\
langen^Ange took it and desperately searched for some kind of trick on it, but it was just an everyday, ordinary candy...^\

_ld r,":b;sprites\en2\1\en2_a15_def2a.png",80
advsetwindow "11"

langjp「どうして？！@　手品でしょ、お兄ちゃん？！@　お兄ちゃん！！」\
;＜縁寿
langen:dwave 0, "voice\11\82000239.ogg":^"How?!^@:dwave 0, "voice\11\82000240.ogg":^  That was a trick, wasn't it, Onii-chan?!^@:dwave 0, "voice\11\82000241.ogg":^  Onii-chan?!!"^\

_ld l,":b;sprites\but\1\but_b11_futeki5.png",23
advsetwindow "10"

langjp「いいや。魔法だよ。@縁寿も、ずっと見てただろ？」@
;＜戦人
langen:dwave 0, "voice\10\80100248.ogg":^"Nope.  That was magic.^@:dwave 0, "voice\10\80100249.ogg":^  You were watching the whole time, weren't you?"^\

_ld r,":b;sprites\en2\1\en2_a15_def3a.png",80
advsetwindow "11"

langjp「ん、………んんんんん…………！」\
;＜縁寿
langen:dwave 0, "voice\11\82000242.ogg":^"Nng, ...nnnnnnnn......!"^\

_ld c,":b;sprites\bea\1\bea_b11_warai2.png",80

bg black,22
advsetwindow "-1"
langjp　ずっと見ていたはずなのに、……どうして……。@
langjp　納得は行かないが、少なくとも魔法でないとは、見破れなかった。@
langen^Since I was watching the whole time, ...how did it happen...?^@
advsetwindow "-1"
langen^Ange didn't like it, but she was unable to see how that could have been anything other than magic.^@
advsetwindow "-1"
;br
langjp　眉を歪めて下唇を噛む妹に、兄は、魔法だってばと、もう一度やさしく言う。\
langen^As the little sister furrowed her brow and bit her lower lip, her brother gently told her again that it was magic.^\

bg new_garden_1c,22
;bg M_o1b,26

_ld r,":b;sprites\bea\1\bea_b11_def1.png",24
advsetwindow "27"
langjp「そろそろ、屋敷へ挨拶に行く。@戦人も付き合うが良い。@妾一人では窒息してしまうわ。」\
;＜ベアト
langen:dwave 0, "voice\27\80700061.ogg":^"It's about time for me to head to the mansion to pay my respects.^@:dwave 0, "voice\27\80700062.ogg":^  You should come along, Battler.^@:dwave 0, "voice\27\80700063.ogg":^  I'll suffocate if I have to go alone."^\

_ld c,":b;sprites\but\1\but_b11_futeki1.png",24
advsetwindow "10"

langjp「そうか？　じゃあお供させてもらうかな。@……縁寿はどうする。@ゲストハウスに戻ってるか？」@
;＜戦人
langen:dwave 0, "voice\10\80100250.ogg":^"You sure?  Then I'll join you.^@:dwave 0, "voice\10\80100251.ogg":^  ...What about you, Ange?^@:dwave 0, "voice\10\80100252.ogg":^  Will you go back to the guesthouse?"^\

_ld l,":b;sprites\en2\1\en2_a11_def2a.png",23
advsetwindow "11"

langjp「…………お、お兄ちゃんと一緒がいい。」\
;＜縁寿
langen:dwave 0, "voice\11\82000243.ogg":^"......I-I wanna stay with you, Onii-chan."^\

bg black,22
advsetwindow "-1"
langjp　未だに納得は出来ない。@/
langen^She still couldn't accept it.^@/
advsetwindow "-1"
;bg different_spiral_1a,22
langjpでも、……ひょっとすると本当に……。\
langen^  However, ...could it really be...?^\
advsetwindow "-1"

langjp　表情は相変わらず不機嫌なままだけど、@………魔女にわずかの、興味も湧いてきたようだった。\
langen^She still looked grumpy,^@^ ...but it looked like she was getting interested in this witch.^\

bg black,22
bg new_garden_1c,0
_ld c,":b;sprites\bea\1\bea_b11_akuwarai1.png",24
advsetwindow "27"

langjp「さぁ、では行こうではないか。@黄金の魔女の帰還であるぞ…！」\
;＜ベアト
langen:dwave 0, "voice\27\80700064.ogg":^"Then let us go.^@:dwave 0, "voice\27\80700065.ogg":^  The Golden Witch returns...!"^\

_ld l,":b;sprites\but\1\but_b11_warai2.png",23
advsetwindow "10"

langjp「黄金の魔女の、孫の帰還だけどな。」@
;＜戦人
langen:dwave 0, "voice\10\80100253.ogg":^"The Golden Witch's...grandchild returns, you mean."^\

_ld c,":b;sprites\bea\1\bea_b11_odoroki1.png",80
advsetwindow "27"

langjp「そのキャッチコピー、もう少し何とかならぬものか…！」\
;＜ベアト
langen:dwave 0, "voice\27\80700066.ogg":^"We really need to do something about that name...!"^\

_ld l,":b;sprites\but\1\but_b11_warai1.png",80
_ld c,":b;sprites\bea\1\bea_b11_fukigen2.png",80
advsetwindow "-1"

langjp　兄と魔女は、本当に仲良し。@
langjp　漫才コンビのように意気投合しながら、歩き出す。\
langen^The big brother and the witch really did seem close.^@
advsetwindow "-1"
langen^With kindred spirits like a pair of comedians, they started walking.^\

;bg black,22

cl a,4
_ld r,":b;sprites\en2\1\en2_a11_def2.png",24
advsetwindow "-1"

langjp　縁寿は、自分のことを兄に忘れられないように、兄の服の裾をずっと握っているのだった…。\
langen^Ange held onto the corner of her brother's sleeve, trying to make sure he didn't forget about her...^\

textoff

