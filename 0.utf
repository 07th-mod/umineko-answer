;＜霧江
langen:dwave 0, "voice\09\81300079.ogg":^"I'm sorry, but you'll have to let me draw the line there."^\

;cl l,0
_ld l,":b;sprites\rud\1\rud_a11_nayamu1.png",80
advsetwindow "08"

langjp「違う。@俺と、お前の子なんだ。」@
;＜留弗夫
langen:dwave 0, "voice\08\81200074.ogg":^"You don't get it.^@:dwave 0, "voice\08\81200075.ogg":^  He's my kid...and yours."^\

_ld r,":b;sprites\kir\1\kir_a11_majime1.png",80
