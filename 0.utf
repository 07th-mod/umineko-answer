bg new_Wsan_1a,22
;bg Wclo_1c,0
_ld c,":b;sprites\eri\1\eri_a11_majime2.png",24
advsetwindow "46"

langjp「私は、真実の魔女です。@……私の潜った地獄には、ただ、真実がありました。@………真実という冷酷な現実の前には、一切の意思も、そして奇跡さえも介在できません。@私は、その真実を、踏み越えてここへ至ったのです。@……この、真実に堪えるという力において、私はあなたにも、我が主にも引けを取るつもりは、@……ありません。」\
;＜ヱリカ
langen:dwave 0, "voice\46\64501310.ogg":^"I am the Witch of Truth.^@:dwave 0, "voice\46\64501311.ogg":^  ...My hell was nothing more or less than the truth.^@:dwave 0, "voice\46\64501312.ogg":^  ......When faced with the harsh reality of truth, no sort of willpower or miracle matters.^@:dwave 0, "voice\46\64501313.ogg":^  I reached this place by overcoming that truth.^@:dwave 0, "voice\46\64501314.ogg":^  ...I don't believe my power of withstanding the truth ^@:dwave 0, "voice\46\64501315.ogg":^is in any way inferior to yours or my master's."^\

_ld l,":b;sprites\lam\1\lam_a11_odoroki3.png",23
advsetwindow "29"

langjp「真実に堪える力って何よ。」\
;＜ラムダ
langen:dwave 0, "voice\29\62200414.ogg":^"So what is this `power to withstand the truth'?"^\

