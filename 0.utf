langjp「この鍵はお兄ちゃんがくれた。@でも、使うべき時に使い方がわかる、みたいなことを言って、何に使えばいいのかは教えてくれなかったわ。@……あんたたちは知ってるの？@　この鍵は何？@　お兄ちゃんは、とても大切なものだと言っていた。」\
;＜縁寿
langen:dwave 0, "voice\11\82000882.ogg":^"Onii-chan did give me this key.^@:dwave 0, "voice\11\82000883.ogg":^  But then, he just said something about how I'd know how to use it when the time was right.^@:dwave 0, "voice\11\82000884.ogg":^  He didn't say a word about what it was used for.^@:dwave 0, "voice\11\82000885.ogg":^  ...Do you two know?^@:dwave 0, "voice\11\82000886.ogg":^  What is this key for?  Onii-chan said it was something very precious."^\

bg black,22
bg new_fea_r1ap,0
_ld l,":b;sprites\fea\1\fea_b11_def1.png",22
advsetwindow "50"

langjp「我が巫女よ、説明せよ。」@
;＜フェザ
langen:dwave 0, "voice\50\85000011.ogg":^"Explain, my miko."^\

_ld r,":b;sprites\ber\1\ber_a21_def2.png",24
advsetwindow "28"

langjp「嫌よ。@あんたが説明しなさい。」\
;＜ベルン
langen:dwave 0, "voice\28\82100288.ogg":^"No way.^@:dwave 0, "voice\28\82100289.ogg":^  You explain."^\

_ld l,":b;sprites\fea\1\fea_b11_def2.png",80
advsetwindow "50"

langjp「……主に説明をさせようというのか？」@
;＜フェザ
langen:dwave 0, "voice\50\85000012.ogg":^"...You demand that your master explain?"^\

_ld r,":b;sprites\ber\1\ber_a21_odoroki2.png",80
advsetwindow "28"

langjp「たまには、その程度の舞台参加もしなさいよ。@ボケ防止にいいわよ。」\
;＜ベルン
langen:dwave 0, "voice\28\82100290.ogg":^"You've got to go on stage every now and then.^@:dwave 0, "voice\28\82100291.ogg":^  Otherwise you'll just get senile all the faster."^\


_ld l,":b;sprites\fea\1\fea_b11_def1.png",80
advsetwindow "50"

langjp「やれやれ……。@縁寿の朗読の時に、久々の舞台を堪能したので、もう数百年は充分だと思っていたのだがな。」\
;＜フェザ
langen:dwave 0, "voice\50\85000013.ogg":^"My, my...^@:dwave 0, "voice\50\85000014.ogg":^  And yet, I just enjoyed some long-overdue time on the stage when Ange was Reader, which should last me several centuries at least."^\



