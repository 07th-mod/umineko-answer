setwindow 165,16,25,20,26,26,0,2,20,1,1,#999999,0,0,960,540;utmeta-start;<NO_TEXT_START>170697
;advsetwindow "19"
;locate 1,4;utmeta-setwindow
langjp　……事故の時、すぐに源次さんから連絡が入り、秘密裏に診察するように念を押されました。\
;＜南條
locate 0, 6 ;<CENTER_TEXT>
langen:dwave 0, "voice\19\71900074.ogg":^...I was contacted by Genji-san immediately after the accident...and asked to conduct an examination in secrecy.^\
bg black,22
bg new_the_2b,0
;se1 20
_ld r,":b;sprites\zep\1\zep_a11_warai4.png",22
beginADVSection
advsetwindow "-1"
advsetwindow "51"
langjp「秘密裏に？」@
;＜ゼパル
langen:dwave 0, "voice\51\75100032.ogg":^"In secrecy?"^\

;se2 48
_ld l,":b;sprites\fur\1\fur_a11_warai2.png",24
advsetwindow "52"

langjp「どうして？」\
;＜フルフル
langen:dwave 0, "voice\52\75200035.ogg":^"Why?"^\

;bg the_2b,0
;ld l,FUR_WaraiA2,0
;ld r,ZEP_WaraiA4,0
ut_mld c,":b;sprites\nan\1\nan_a1_fumu1.png",22
advsetwindow "19"

langjp「……九羽鳥庵のベアトリーチェさんも、そしてその子供である赤ん坊も、戸籍のない、存在しないはずの人間でした。@公になれば、色々とまずいこともあるでしょうな…。」\
;＜南條
langen:dwave 0, "voice\19\71900075.ogg":^"...Both the Beatrice of Kuwadorian and her child were unregistered people who weren't supposed to exist.^@:dwave 0, "voice\19\71900076.ogg":^  It would lead to various problems if it went public..."^\

mcl c,0
cl a,0
_ld r,":b;sprites\nan\1\nan_a1_fumu1.png",0
_ld l,":b;sprites\gen\1\gen_a11_majime1.png",23
advsetwindow "14"

langjp「赤ん坊に戸籍を与える準備は進めておりましたが、その時点ではまだ、至っておりませんでした。@/
langen:dwave 0, "voice\14\71600028.ogg":^"I had started the procedures to have the baby registered, but they were not complete at that time.^@/

_ld l,":b;sprites\gen\1\gen_a11_komaru1.png",80
advsetwindow "14"

langjp……死なれては、どうにも困る時期だったのです。」\
;＜源次
langen:dwave 0, "voice\14\71600029.ogg":^  ...It was a very unfortunate time for the baby to die."^\

bg new_the_2a,23
;se1 48
_ld l,":b;sprites\fur\1\fur_a11_def1.png",24
advsetwindow "52"

langjp「では、落ちた使用人は単独事故の扱いに？」@
;＜フルフル
langen:dwave 0, "voice\52\75200036.ogg":^"So, the servant who fell was treated as having died alone in an accident?"^\

;se2 47
_ld r,":b;sprites\zep\1\zep_a11_warai1.png",23
advsetwindow "51"

langjp「夏妃は黙して語らない。@簡単な工作さ！」@
;＜ゼパル
langen:dwave 0, "voice\51\75100033.ogg":^"Natsuhi wouldn't talk to anyone.^@:dwave 0, "voice\51\75100034.ogg":^  It would've been easy to set up!"^\

_ld l,":b;sprites\fur\1\fur_a11_majime2.png",80
advsetwindow "52"

langjp「でも、その赤ん坊は生きてたのね？」\
;＜フルフル
langen:dwave 0, "voice\52\75200037.ogg":^"But that baby was alive, wasn't it?"^\

bg new_the_2b,0
_ld r,":b;sprites\nan\1\nan_a1_def1.png",24
_ld r,":b;sprites\nan\1\nan_a1_majime1.png",80
advsetwindow "19"

langjp「左様です。@……無論、大怪我でしたとも。@あれだけの怪我をして、生き永らえたのは奇跡でした。@もう少し何かの角度が違えば。@あるいは、もう少し源次さんが運び込んでくるのが遅かったら。@……あらゆる奇跡が集って、その赤ん坊は生き永らえていたのです。」\
;＜南條
langen:dwave 0, "voice\19\71900077.ogg":^"Correct.^@:dwave 0, "voice\19\71900078.ogg":^  ...Of course, the child was gravely injured.^@:dwave 0, "voice\19\71900079.ogg":^  It was a miracle that it survived that wound.^@:dwave 0, "voice\19\71900080.ogg":^  If the angle had been slightly different,^@:dwave 0, "voice\19\71900081.ogg":^ or if Genji-san had been any slower in carrying the baby to me...^@:dwave 0, "voice\19\71900082.ogg":^  That baby only managed to survive thanks to a series of miracles."^\

_ld c,":b;sprites\gen\1\gen_a11_majime1.png",24
advsetwindow "14"

langjp「………私は諦めていました。@まさか、生きているはずがないと思ったのです。」\
;＜源次
langen:dwave 0, "voice\14\71600030.ogg":^"......I had given up.^@:dwave 0, "voice\14\71600031.ogg":^  I didn't believe the baby could have survived that."^\

bg new_the_2a,0
;se1 48
_ld l,":b;sprites\fur\1\fur_a11_warai8.png",23
advsetwindow "52"

langjp「でも、生きていた。」@
;＜フルフル
langen:dwave 0, "voice\52\75200038.ogg":^"But it did."^\

cl r,22
;se1 47
_ld r,":b;sprites\zep\1\zep_a11_warai3.png",23
advsetwindow "51"

langjp「生命の何と力強きこと！」@
;＜ゼパル
langen:dwave 0, "voice\51\75100035.ogg":^"How strong and resilient is life!"^\

_ld l,":b;sprites\fur\1\fur_a11_majime1.png",80
advsetwindow "52"

langjp「うぅん、これは運命だわ。」@
;＜フルフル
langen:dwave 0, "voice\52\75200039.ogg":^"No, this is fate."^\

_ld r,":b;sprites\zep\1\zep_a11_warai7.png",80
advsetwindow "51"

langjp「運命！@　生き延びて、やがては何かを成せという運命？！」\
;＜ゼパル
langen:dwave 0, "voice\51\75100036.ogg":^"Fate!^@:dwave 0, "voice\51\75100037.ogg":^  So the baby was fated to live on and eventually accomplish something great?!"^\

bg new_the_2b,25
_ld r,":b;sprites\gen\1\gen_a11_def1.png",26
advsetwindow "14"

langjp「………………。@……はい。@私は、これを何かの運命だと思いました。@六軒島で生涯を終えられた九羽鳥庵のベアトリーチェさまの血が、この子に何かを託し、@生き延びさせたに違いないと、そう思ったのです。」\
;＜源次
langen:dwave 0, "voice\14\71600033.ogg":^"............^@:dwave 0, "voice\14\71600034.ogg":^...Yes,^@:dwave 0, "voice\14\71600035.ogg":^ I did think it was fate.^@:dwave 0, "voice\14\71600036.ogg":^  I thought the blood of the Kuwadorian Beatrice-sama, whose life ended on Rokkenjima, ^@^must have imparted something onto this child to make it survive."^\

bg new_the_2a,2
_ld c,":b;sprites\cur\1\cur_a11_houshin3star.png",4
advsetwindow "55"

langjp「しかし源次は、赤ん坊が生き永らえたことを主人の金蔵には伝えなかった。@不幸な事故で転落し死亡したと、短く伝えた。@金蔵は嘆き悲しんだが、その嘆きは悲しみよりも狂気に彩られたものだった……。」\
;＜クレル
langen:dwave 0, "voice\55\75500054.ogg":^"However, Genji did not tell his master, Kinzo, that the child had survived.^@:dwave 0, "voice\55\75500055.ogg":^  He simply said that it had fallen to its death in an unfortunate accident.^@:dwave 0, "voice\55\75500056.ogg":^  Kinzo mourned, but his mourning was more one of madness than of sorrow..."\

bg new_the_2b,23
;se1 20
_ld l,":b;sprites\zep\1\zep_a12_akire1.png",24
advsetwindow "51"

langjp「おぉ、ベアトリーチェよ、なぜに再び我が下より逃げ去るのかッ！」@
;＜ゼパル
langen:dwave 0, "voice\51\75100038.ogg":^"Ooh, Beatrice, why have you run away from me once more?!"^\

;se2 20
_ld r,":b;sprites\fur\1\fur_a12_majime2.png",23
advsetwindow "52"

langjp「今度こそ過ちを繰り返すまいと誓ったのに、なぜに、なぜにッ！！」\
;＜フルフル
langen:dwave 0, "voice\52\75200040.ogg":^"Why, even though I swore I'd never make the same mistake again, why?!!"^\

ut_mld c,":b;sprites\cur\1\cur_a11_houshin3star.png",22
advsetwindow "55"

langjp「源次は尊敬する主人のことを、ただ一つだけ信じていないことがあった。@それは、ベアトリーチェの孫を、果たして本当に孫として迎え入れられるのか、である。」\
langen:dwave 0, "voice\55\75500057.ogg":^"There was one matter in which Genji did not trust the master he so respected.^@:dwave 0, "voice\55\75500058.ogg":^  That matter was whether Kinzo would be capable of accepting Beatrice's grandchild as her grandchild."^\

ut_mld c,":b;sprites\cur\1\cur_a11_houshin1star.png",80
advsetwindow "55"

langjp「源次は九羽鳥庵のベアトリーチェにもずっと仕えていた。@その胸中についても詳しかった。@彼女が金蔵の寵愛を一身に受け、父として敬愛していたことも。」\
;＜クレル
langen:dwave 0, "voice\55\75500059.ogg":^"Genji had served the Kuwadorian Beatrice for many years as well.^@:dwave 0, "voice\55\75500060.ogg":^  He was very aware of what she had felt.^@:dwave 0, "voice\55\75500061.ogg":^  He knew that she had accepted the favor Kinzo had bestowed on her and respected him as a father."^\

me1v 16,50

mcl c,0
bg new_the_1c,22
advsetwindow "55"

langjp「しかしそれは金蔵のそれとは異なった。@金蔵は彼女を、ベアトリーチェの生まれ変わりと思い、@亡きベアトリーチェへの万感の思いの慰み者にしようとした。@その思いを、九羽鳥庵のベアトリーチェが受け入れきれるわけもない。@彼女は父と思い、唯一の家族と思い尊敬してきた金蔵自らに、@純潔を奪われることになるのである……。」\
;＜クレル
langen:dwave 0, "voice\55\75500062.ogg":^"However, her love was not the same as Kinzo's love.^@:dwave 0, "voice\55\75500063.ogg":^  Kinzo thought her to be Beatrice reborn...^@:dwave 0, "voice\55\75500064.ogg":^and tried to use her to satisfy the many feelings he had felt for the late Beatrice.^\:dwave 0, "voice\55\75500065.ogg":^  Of course, the Kuwadorian Beatrice could not accept those feelings.^@:dwave 0, "voice\55\75500066.ogg":^  In the end, she had her chastity stolen ^@:dwave 0, "voice\55\75500067.ogg":^by the one she thought of as her only family and respected as a father..."^\

bg new_the_2a,26
;se1 47
_ld r,":b;sprites\zep\1\zep_a11_warai4.png",24
advsetwindow "51"

langjp「自分は父と思ってたのに、向こうは妻と思ってた！」@
;＜ゼパル
langen:dwave 0, "voice\51\75100039.ogg":^"She thought he was her father, and he thought she was his wife!"^\

;se2 48
_ld l,":b;sprites\fur\1\fur_a11_warai7.png",23
advsetwindow "52"

langjp「あぁ、それは両立出来ぬ禁じられた恋！」\
;＜フルフル
langen:dwave 0, "voice\52\75200041B.ogg":^"Oh, what irreconcilable, forbidden love!"^\

_ld c,":b;sprites\gen\1\gen_a11_majime1.png",80
advsetwindow "14"

langjp「………金蔵さまのお気持ちも、わからぬわけではありません。@金蔵さまとて、彼女が生まれた時から、亡きベアトリーチェさまの面影を映して慰み者にしようなどと、@思っていたわけではありません。」\
;＜源次
langen:dwave 0, "voice\14\71600037.ogg":^"...This is not to say that I was incapable of understanding how Kinzo-sama felt.^@:dwave 0, "voice\14\71600038.ogg":^  At the moment of her birth, even he did not plan on taking advantage of her...^@:dwave 0, "voice\14\71600039.ogg":^due to her resemblance to the late Beatrice-sama."^\

cl r,23
_ld r,":b;sprites\nan\1\nan_a1_def1.png",24
advsetwindow "19"

langjp「私も、……お酒を飲みながら聞かされたことはあります。@私は、笑い話と思って聞いておりましたが。」\
;＜南條
langen:dwave 0, "voice\19\71900083.ogg":^"He...even spoke to me about it a few times when we were drinking.^@:dwave 0, "voice\19\71900084.ogg":^  I always thought he was just joking."^\

bg new_the_2b,24
_ld l,":b;sprites\zep\1\zep_a11_akire1.png",23
advsetwindow "51"

langjp「娘が育つほどに、母に生き写しになる驚きを？」@
;＜ゼパル
langen:dwave 0, "voice\51\75100040.ogg":^"Was he surprised to find that the daughter grew to look more and more like the mother?"^\

_ld c,":b;sprites\fur\1\fur_a11_majime1.png",23
advsetwindow "52"

langjp「娘が育つほどに、抑えられぬ禁じられた感情を？」\
;＜フルフル
langen:dwave 0, "voice\52\75200042B.ogg":^"As the daughter grew, did he suffer from a forbidden emotion he couldn't suppress?"^\

bg new_the_2a,0
_ld l,":b;sprites\nan\1\nan_a1_komaru3.png",23
;ld r,GEN_DefA1,23
_ld r,":b;sprites\gen\1\gen_a11_def1.png",24
_ld r,":b;sprites\gen\1\gen_a21_kashikomari1.png",80
advsetwindow "14"

langjp「……同じ過ちが、/
langjp!d800……繰り返されるのではないか。@……私はそう、思いました。」@
;＜源次
langen:dwave 0, "voice\14\71600040B.ogg":^"...I thought...^@/
advsetwindow "14"
langen:delay 1100:dwave 0, "voice\14\71600041B.ogg":^...that he might commit the same mistake again.^@:dwave 0, "voice\14\71600042.ogg":^  ...That was my view."^\

_ld l,":b;sprites\nan\1\nan_a1_fumu1.png",80
advsetwindow "19"

langjp「……………………………。」\
;＜南條
langen:dwave 0, "voice\19\71900085.ogg":^"............"^\

cl a,0
_ld c,":b;sprites\gen\1\gen_a21_kashikomari1.png",24
_ld c,":b;sprites\gen\1\gen_a11_komaru1.png",80
advsetwindow "14"

langjp「ベアトリーチェさまは、苦しんでおられました。@しかしついに、ご自身の気持ちと、金蔵さまの気持ちが違うことに、理解が及ばなかったのです。@/
langen:dwave 0, "voice\14\71600043.ogg":^"Beatrice-sama suffered much.^@:dwave 0, "voice\14\71600044.ogg":^  And yet, she never truly understood the difference between her feelings and Kinzo's.^@/
advsetwindow "14"

;ld c,GEN_KomaruA1,80

langjp………私はベアトリーチェさまより何度も、胸の内を打ち明けられ、相談を受けました。@しかし私には申し上げられませんでした。」\
;＜源次
langen:dwave 0, "voice\14\71600045.ogg":^  ...Beatrice-sama consulted me many times, laying bare her deepest feelings.^@:dwave 0, "voice\14\71600046.ogg":^  However, I was unable to tell her."^\

;se1 20
_ld r,":b;sprites\zep\1\zep_a11_warai3.png",23
advsetwindow "51"

langjp「それは確かに言えないね！」@
;＜ゼパル
langen:dwave 0, "voice\51\75100041.ogg":^"That would be hard to say!"^\

;se2 20
_ld l,":b;sprites\fur\1\fur_a11_warai5.png",24
advsetwindow "52"

langjp「父と敬愛する人が、あなたを死んだ母の代用品にしようと思ってるなんて！」\
;＜フルフル
langen:dwave 0, "voice\52\75200043.ogg":^"Imagine telling her that the one she respects as a father wants to use her as a replacement for her dead mother!"^\

bg new_the_2b,22
_ld c,":b;sprites\nan\1\nan_a1_def1.png",24
advsetwindow "19"

langjp「……一応、金蔵さんの名誉のために申し上げる。@金蔵さんも苦しんでおられた。@生き写しになる娘が、娘と思えなくなると苦しんでおられた。@/
langen:dwave 0, "voice\19\71900086.ogg":^"...Let me say this for the sake of Kinzo-san's honor.^@:dwave 0, "voice\19\71900087.ogg":^  He also suffered greatly.^@:dwave 0, "voice\19\71900088.ogg":^  It pained him when he found that he could no longer think of his daughter as a daughter.^@/

_ld c,":b;sprites\nan\1\nan_a1_komaru3.png",80
advsetwindow "19"

langjp……私は、父として愛しなさいと助言した。@金蔵さんも、理性と良心に従い、抗われたと思う…。」\
;＜南條
langen:dwave 0, "voice\19\71900089.ogg":^  ...I told him to love her as a father.^@:dwave 0, "voice\19\71900090.ogg":^  I think Kinzo-san followed his logic and his conscience...and fought for quite some time..."^\

bg black,22
bg new_the_1a,2
_ld r,":b;sprites\cur\1\cur_a11_houshin1star.png",4
advsetwindow "55"

langjp「金蔵は愛した。@亡きベアトリーチェの忘れ形見である娘に、愛情を注いだ。@父として注いだ。@しかし、ならばなぜに娘に、母と同じ名を与えたのか。」\
langen:dwave 0, "voice\55\75500068.ogg":^"Kinzo loved her.^@:dwave 0, "voice\55\75500069.ogg":^  He poured his affection onto the daughter that Beatrice had left behind.^@:dwave 0, "voice\55\75500070.ogg":^  He did so as a father.^@:dwave 0, "voice\55\75500071.ogg":^  And yet, if so, why did he give the daughter the same name as the mother?"^\

_ld r,":b;sprites\cur\1\cur_a11_nayamu1.png",80
advsetwindow "55"

langjp「あぁ、金蔵の罪は彼女が生を受けた時より始まっているのだ。@彼女を出産し、その引き換えのように死んだベアトリーチェ。@……その名を、そのまま娘に与えた。@金蔵は、彼女が生まれたその瞬間から、彼女をベアトリーチェの生まれ変わりだと決めていたのである…。」\
;＜クレル
langen:dwave 0, "voice\55\75500072A.ogg":^"Yes, Kinzo's sin started from the moment she received life.^@:dwave 0, "voice\55\75500073A.ogg":^  She was born, and Beatrice died.^@:dwave 0, "voice\55\75500074A.ogg":^  ...He passed the name down from mother to daughter.^@:dwave 0, "voice\55\75500075A.ogg":^  From the moment of her birth, Kinzo had already decided that she was Beatrice reborn..."^\

;■礼拝堂
