;＜ウィル
langen:dwave 0, "voice\54\75400591.ogg":^"A piece of candy...melted?"^\

_ld l,":b;sprites\mar\1\mar_b11_komaru1.png",80
advsetwindow "13"

langjp「飴、というよりはキャラメルだったと思う。@溶け掛かって、ぐにゃぐにゃだった。」\
;＜真里亞
langen:dwave 0, "voice\13\70400173.ogg":^"I think it was more of a caramel than a normal candy.^@:dwave 0, "voice\13\70400174.ogg":^  It was all lumpy, just starting to melt."^\

_ld r,":b;sprites\wil\1\wil_a11_nayamu1.png",80
advsetwindow "54"

