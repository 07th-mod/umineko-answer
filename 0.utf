;＜源次
langen:dwave 0, "voice\14\81600079.ogg":^"As you wish.^@:dwave 0, "voice\14\81600080.ogg":^  ...Shall I take her to the guesthouse?"^\

_ld c,":b;sprites\bea\1\bea_a12_1_warai8.png",24
