_ld r,":b;sprites\gap\1\gap_a11_warai2.png",80
advsetwindow "32"

langjp「……あいつらのことは、よーく知ってるわ。@……素直に力を貸してくれる連中じゃないのは、あんたもよーく知ってるでしょうが。」\
;＜ガァプ
langen:dwave 0, "voice\32\63700016.ogg":^"...I know all about those two.^@:dwave 0, "voice\32\63700017.ogg":^  ...I think you know as well as me that they won't hand over their power easily."^\

_ld l,":b;sprites\ron\1\ron_a11_akuwarai1.png",23
advsetwindow "31"

langjp「ですな。@……しかしだからこそ、……奇跡にも通ずる力を与えられるのです。」\
;＜ロノウェ
langen:dwave 0, "voice\31\63100015.ogg":^"True.^@:dwave 0, "voice\31\63100016.ogg":^  ...However, ...that is precisely why they are capable of granting a power can lead to miracles."^\

