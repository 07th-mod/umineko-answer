_ld l,":b;sprites\gap\1\gap_a11_akuwarai3.png",80
advsetwindow "27"

langjp「孤島に犠牲者を呼び寄せし犯人であろうが。」\
;＜ガァプ
langen:dwave 0, "voice\32\73700168.ogg":^"The culprit who lured the victims to the island, of course."^\

