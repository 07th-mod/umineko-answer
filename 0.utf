mov %BUT_Isyou,2

bgm1 29

bg new_different_space_1a,22
_ld c,":b;sprites\but\1\but_d11_majime4.png",26
advsetwindow "10"

langjp「わかった！！@　やられたぜ。@犯人が確実に６人を殺したの意味がわかった…！！」@
;＜戦人
langen:dwave 0, "voice\10\80100763.ogg":^"I've got it!!^@:dwave 0, "voice\10\80100764.ogg":^  We've been fooled.^@:dwave 0, "voice\10\80100765.ogg":^  I know what she meant by saying the culprit killed six people...!!"^\

_ld r,":b;sprites\bea\1\bea_a11_1_odoroki3.png",24
advsetwindow "27"

langjp「意味がわかったとはどういうことか。@説明せよ…！」\
;＜ベアト
langen:dwave 0, "voice\27\80700543.ogg":^"What do you mean, you know what she meant?^@:dwave 0, "voice\27\80700544.ogg":^  Explain yourself...!"^\

cl c,0
_ld l,":b;sprites\but\1\but_d11_majime2.png",24
advsetwindow "10"

langjp「“第一の晩の犯人は確実に６人を殺している”。@もしこいつを、第一の晩の時点で言われていたなら、俺は素直に受け取っていたかもしれない。@しかし、第二の晩の時点で言われたことを加味すると、別の意味も見えてくる…！」\
;＜戦人
langen:dwave 0, "voice\10\80100766.ogg":^"The culprit of the first twilight really did kill six people.^@:dwave 0, "voice\10\80100767.ogg":^  If she'd said this right after the first twilight, I probably wouldn't have found anything odd about it.^@:dwave 0, "voice\10\80100768.ogg":^  However, since she said it after the second twilight, a new possibility shows itself...!"^\


_ld r,":b;sprites\bea\1\bea_a11_odoroki1.png",80
advsetwindow "27"

langjp「まさか、………第二の晩の殺人までを含めて、@“確実に６人を殺している”という意味なのか…？！」\
;＜ベアト
langen:dwave 0, "voice\27\80700545.ogg":^"You don't mean...^@:dwave 0, "voice\27\80700546.ogg":^...that the `six people who were killed' includes the murders of the second twilight...?!"^\

cl l,0
_ld l,":b;sprites\but\1\but_d11_majime7.png",23
advsetwindow "10"

langjp「そういうことだ！@　やはり、食堂の６人の中に犯人が混じって死んだフリをしていたんだ！@　そしてそいつは食堂を抜け出し、夏妃伯母さんの部屋で２人を殺して、内側から施錠して室内に隠れたんだ…！」\
;＜戦人
langen:dwave 0, "voice\10\80100769.ogg":^"That's it!^@:dwave 0, "voice\10\80100770.ogg":^  The culprit really was hiding among the six in the dining hall!^@:dwave 0, "voice\10\80100771.ogg":^  Later on, they snuck out of the dining hall, killed the two people in Aunt Natsuhi's room, locked the door from the inside, and hid somewhere in the room...!"^\

mcl c,0
bg black,22
advsetwindow "-1"

langjp　犯人は食堂では５人しか殺せなかったろう。@
langen^The culprit could only have killed five people at most in the dining hall.^@
advsetwindow "-1"
;br
langjp　しかし、第二の晩の犠牲者を足せば、確実に６人は殺していることになると言い切れる…！\
langen^However, if we add on the victims of the second twilight, they would definitely have killed at least six times...!^\

bg new_different_space_1c,0
_ld c,":b;sprites\bea\1\bea_a11_iiwake3.png",22
advsetwindow "27"

langjp「なるほど、それで辻褄は合うぞ…！@　第一の晩も第二の晩も、どちらの密室もマスターキーなしで構築できる…！！」\
;＜ベアト
langen:dwave 0, "voice\27\80700547.ogg":^"I see, now it all adds up...!^@:dwave 0, "voice\27\80700548.ogg":^  You can construct the closed rooms of both the first and second twilights without using master keys...!!"^\

_ld r,":b;sprites\but\1\but_d11_odoroki3.png",24
advsetwindow "10"

langjp「と、……思ったところで、おかしなことも思い出しちまったぜ。@……夏妃伯母さんの部屋は、すぐに封印しちまったんだったな…。」@
;＜戦人
langen:dwave 0, "voice\10\80100772.ogg":^"Well, ...you'd think so, but that reminds me of something else.^@:dwave 0, "voice\10\80100773.ogg":^  ...Aunt Natsuhi's room was sealed immediately afterwards..."^\

_ld c,":b;sprites\bea\1\bea_a11_iiwake1.png",80
advsetwindow "27"

langjp「そういえばそうだったな…。@ベルンカステル卿に赤き真実で、“一同は退出と同時に部屋を封印した。@その退出に犯人は加われない”と言われている。」\
;＜ベアト
langen:dwave 0, "voice\27\80700549.ogg":^"Yes, come to think of it...^@:dwave 0, "voice\27\80700550.ogg":^  Lady Bernkastel used the red truth to say this:^@:dwave 0, "voice\27\80700551.ogg":^ the group sealed the room at the same time they left.  No culprit joined the group as they left."^\

_ld r,":b;sprites\but\1\but_d11_nayamu4.png",80
advsetwindow "10"

langjp「さらにこうも言った。@“全ての封印は、決して破られることはない”ともな。」@
;＜戦人
langen:dwave 0, "voice\10\80100774.ogg":^"And she also said this:^@:dwave 0, "voice\10\80100775.ogg":^ all of the seals will not be broken."^\

cl c,0
_ld l,":b;sprites\bea\1\bea_a11_odoroki2.png",24
advsetwindow "27"

langjp「つまり、……再び密室に閉じ込められた、ということなのか。」\
;＜ベアト
langen:dwave 0, "voice\27\80700552.ogg":^"In other words, ...the culprit is trapped in a closed room again."^\

_ld r,":b;sprites\but\1\but_d11_aseru4.png",80
advsetwindow "10"

langjp「今の推理で、確かに第一の晩と第二の晩は説明できる。@……しかし、その犯人は夏妃伯母さんの部屋に閉じ込められ、二度と出られなくなっちまうんだ。」\
;＜戦人
langen:dwave 0, "voice\10\80100776.ogg":^"That theory might explain the first and second twilights.^@:dwave 0, "voice\10\80100777.ogg":^  ...However, the culprit would be sealed inside Aunt Natsuhi's room, unable to leave."^\

_ld l,":b;sprites\bea\1\bea_a11_komaru3.png",80
advsetwindow "27"

langjp「それでは、第四の晩以降の事件を起こせなくなってしまうではないか！@　……うぅむ、良い推理だと思ったのだが……、やはり、違うのか……。」\
;＜ベアト
langen:dwave 0, "voice\27\80700553.ogg":^"And that means they wouldn't be able to carry out the fourth twilight and onwards!^@:dwave 0, "voice\27\80700554.ogg":^  ...Gyah, I thought it was such a nice theory, ...but I guess it's wrong..."^\

_ld r,":b;sprites\but\1\but_d11_aseru2.png",80
advsetwindow "10"

langjp「この推理で間違っていないはずなんだが……。@……もう一捻り………。」\
;＜戦人
langen:dwave 0, "voice\10\80100778.ogg":^"I don't think we're wrong about this theory, but...^@:dwave 0, "voice\10\80100779.ogg":^  ...Maybe it just needs some more tweaking..."^\

bg black,2

fede 0,1000
E_A

