langen:dwave 0, "voice\13\80400123.ogg":^"Kihihihihihihi!!^@:dwave 0, "voice\13\80400124.ogg":^  Wrong!^@:dwave 0, "voice\13\80400125.ogg":^  You can't even do this one?!^@:dwave 0, "voice\13\80400126.ogg":^  You suck, Ange, kihihihihihihihihihi, ^@/

se1 8
quakey 2,200
