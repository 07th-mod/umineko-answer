;＜戦人
langen:dwave 0, "voice\10\80100890.ogg":^"Murder as a family, huh?^@:dwave 0, "voice\10\80100891.ogg":^  How sweet."^\

_ld l,":b;sprites\bea\1\bea_a11_akuwarai1.png",80
advsetwindow "27"

