;＜真里亞
langen:dwave 0, "voice\13\80400196.ogg":^"...No matter how we lock ourselves in, someone always gets killed.^@:dwave 0, "voice\13\80400197.ogg":^  ...Uu-!  It's the work of a witch after all!"^\

cl c,0
ut_mld c,":b;sprites\geo\1\geo_a12k_majime3k.png",23
advsetwindow "07"

langjp「みんな落ち着いて…！@　落ち着いて考えよう。@……この島には、右代宮家の人間以外は存在しないんだ。」\
;＜譲治
langen:dwave 0, "voice\07\80300133.ogg":^"Everyone, calm down...!^@:dwave 0, "voice\07\80300134.ogg":^  Let's calm down and think.^@:dwave 0, "voice\07\80300135.ogg":^  ...No one exists on this island except those with a direct relation to the Ushiromiya family."^\

_ld r,":b;sprites\but\1\but_b11_odoroki1.png",80
advsetwindow "10"

