;＜夏妃
langen:dwave 0, "voice\03\80900066.ogg":^"............"^\
advsetwindow "27"

;ld r,BEA_DefA1,80

langjp「もはや、恨みはない。@それでも、そなたの十字架は軽くはならぬか。」\
;＜ベアト
langen:dwave 0, "voice\27\80700271.ogg":^"I no longer hate you.^@:dwave 0, "voice\27\80700272.ogg":^  Doesn't that make the cross you bear feel any lighter?"^\
advsetwindow "03"

;ld l,NAT_DefA1,80

