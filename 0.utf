;ld c,FEA_DefA1,80
;gggg
langjp「そして筆者は、これを誰にも明かさずに逝った。@……私は物書きの端くれとして、それを尊重したいと思うのだ。」\
;＜八城
langen:dwave 0, "voice\56\84900069.ogg":^"Furthermore, the one who wrote this passed away without revealing it to anyone.^@:dwave 0, "voice\56\84900070.ogg":^  ...Being the humble writer that I am, I would like to respect that."^\

