gosub *medaru
;★合流地点へ



;★合流地点
*Mar_quiz

fede 0,1000
E_A


mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2

bg new_mhal_h1a,22
_ld l,":b;sprites\mar\1\mar_a11_akuwarai1.png",22

bgm1 96
advsetwindow "13"

langjp「ようやく真里亞の番だね。@きっひひひひ、ママの簡単な問題にずいぶん時間を掛けるから心配になっちゃったよ。@縁寿には無理だね、絶対に無理！」\
;＜真里亞
langen:dwave 0, "voice\13\80400088.ogg":^"So, it's finally my turn.^@:dwave 0, "voice\13\80400089.ogg":^  Kihihihihi, you took so long on Mama's easy puzzle that I got a little worried.^@:dwave 0, "voice\13\80400090.ogg":^  There's no way you'll ever solve this one!"^\


_ld r,":b;sprites\en2\1\en2_a11_def2b.png",24
advsetwindow "11"

langjp「絵羽伯母さんがいるもん、二人で解くもん！」@
;＜縁寿
langen:dwave 0, "voice\11\82000670.ogg":^"I've got Aunt Eva with me, and we'll solve it together!"^\

_ld l,":b;sprites\mar\1\mar_a11_akuwarai2.png",80
advsetwindow "13"

langjp「きひひひひひ、無理だよ無理無理！@　絵羽伯母さんにだって解けたりはしない！@　狼と羊のパズルはものすごい難しいんだからね…！」\
;＜真里亞
langen:dwave 0, "voice\13\80400091.ogg":^"Kihihihihihi, impossible, impossible, impossible!^@:dwave 0, "voice\13\80400092.ogg":^  Even Aunt Eva can't solve this one!^@:dwave 0, "voice\13\80400093.ogg":^  Wolves and Sheep puzzles are incredibly hard...!"^\

bg black,22
bg new_book1,22
advsetwindow "-1"

langjp　真里亞は手提げカバンより、擦り切れて使い込まれ、@まるで魔導書のような貫禄を持った「狼と羊のパズル」の本を取り出す。\
langen^From her handbag, Maria pulled out a "Wolves and Sheep Puzzle Book" that was worn-out, well-used, and had a majestic feel to it, like a grimoire.^\

bg black,22
bg new_mhal_h1a,0
_ld c,":b;sprites\mar\1\mar_a22_niyari1.png",22
advsetwindow "13"

langjp「狼と羊のパズルはわかるよね？」@
;＜真里亞
langen:dwave 0, "voice\13\80400094.ogg":^"You know what a Wolves and Sheep puzzle is, right?"^\

_ld r,":b;sprites\en2\1\en2_a11_def2a.png",24
advsetwindow "11"

langjp「わかるよ。@何度も出されたもん。」\
;＜縁寿
langen:dwave 0, "voice\11\82000671.ogg":^"I know.^@:dwave 0, "voice\11\82000672.ogg":^  You show me those all the time."^\

bg new_mhal_h1c,23
_ld l,":b;sprites\ros\1\ros_a11_def1.png",23
advsetwindow "12"

langjp「こちらの岸から向こうの岸へ、船を使ってみんなを移動させるパズルよ。」@
;＜楼座
langen:dwave 0, "voice\12\81400048.ogg":^"They're puzzles about using a boat to take everyone from one shore of a river to another."^\

_ld c,":b;sprites\eva\1\eva_a11_akire1.png",24
advsetwindow "05"

langjp「大抵、おかしなルールがあるのよね。@狼と羊の場合だと、それぞれの岸で、狼が羊の数を上回ってはならない、だっけ？」\
;＜絵羽
langen:dwave 0, "voice\05\81000376.ogg":^"They usually have a few bizarre rules.^@:dwave 0, "voice\05\81000377.ogg":^  When there's wolves and sheep, you can't let the number of wolves on either shore get bigger than the number of sheep, right?"^\

_ld r,":b;sprites\mar\1\mar_a11_akuwarai1.png",24
advsetwindow "13"

langjp「そう、その通り！@　狼が羊を上回らないように気を付けながら、船を往復させて全員を対岸へ移動させるパズルなの…！！@　でもね、狼と羊しかないのは、一番シンプルで単純で簡単な、入門編の基礎編の練習問題程度なんだよ…！！」\
;＜真里亞
langen:dwave 0, "voice\13\80400095.ogg":^"Yeah, that's right!^@:dwave 0, "voice\13\80400096.ogg":^  Send a boat back and forth, moving everyone to the other side while making sure that there are never more wolves than sheep...!!^@:dwave 0, "voice\13\80400097.ogg":^  But the ones with just wolves and sheep are the simplest, easiest, plainest beginner's basic practice puzzles...!"^\

_ld l,":b;sprites\ros\1\ros_a11_warai1.png",80
advsetwindow "12"

langjp「上級編になるとね、狼や羊以外にも色々出てくるのよ。@面白いわよ。」\
;＜楼座
langen:dwave 0, "voice\12\81400049.ogg":^"When you get to the higher levels, you have many things other than wolves and sheep.^@:dwave 0, "voice\12\81400050.ogg":^  It's pretty clever."^\

_ld c,":b;sprites\eva\1\eva_a11_def1.png",80
advsetwindow "05"

langjp「………紙に書いた方がいい問題？」@
;＜絵羽
langen:dwave 0, "voice\05\81000378.ogg":^"...Should we write this down on a piece of paper?"^\

_ld l,":b;sprites\ros\1\ros_a11_warai2.png",80
advsetwindow "12"

langjp「そうね、その方がきっと、整理がしやすいわよ。」\
;＜楼座
langen:dwave 0, "voice\12\81400051.ogg":^"Good idea.  That'll definitely make it easier for you to sort out your thoughts."^\

_ld c,":b;sprites\eva\1\eva_a11_akire1.png",80
advsetwindow "05"

langjp「参ったわね、……この問題、かなりてこずりそうよ。」\
;＜絵羽
langen:dwave 0, "voice\05\81000379.ogg":^"*sigh*  ...Sounds like this puzzle will be a handful."^\

_ld r,":b;sprites\mar\1\mar_a11_akuwarai2.png",80
advsetwindow "13"

langjp「このメダルは、ぜーったい、縁寿にはあげないの！@　きひひひひひひひひひひ！！」\
;＜真里亞
langen:dwave 0, "voice\13\80400098.ogg":^"There's no way you're getting my medal, Ange!^@:dwave 0, "voice\13\80400099.ogg":^  Kihihihihihihi!!"^\

bg black,23
bg new_mhal_h1a,23
_ld c,":b;sprites\en2\1\en2_a11_def2b.png",23
advsetwindow "11"

langjp「負けないもん、絶対に負けないもんっ！！」\
;＜縁寿
langen:dwave 0, "voice\11\82000673.ogg":^"I won't lose.  I'm not gonna lose!!"^\



goto *quiz
;■真里亞の出題
;　２人乗りの船を使い、全員が対岸に渡らなけ;ればならない。@
;　こちらの岸には、農夫とその妻と羊飼いと羊と牛と肉と野菜がある。@
;;（これらはそれぞれ、船では１人分として扱う）


;　;船は、農夫と妻と羊飼いの３人にしか漕げない。@
;　妻は、農夫と一緒でない時に羊飼いがいると、駆け落ちをしてしまう。@
;　羊飼いは、農夫か妻が一緒にいない時に肉があると、盗み食いしてしまう。@
;　羊は、羊飼いと一緒にいない時に野菜があると、それを食べてしまう。@
;　牛は、人間が誰か一緒にいない時に野菜があると、それを食べてしまう。@
;　肉は、積み下ろしが大変なので、一度船から降ろしたら、もう積めない。@
;　野菜は、傷みやすいので、一度しか船に乗せられない。@
; You must use a two-passenger boat to carry every person to the opposite bank of the river.
; On the near bank, there is a peasant, his wife, a shepherd, a sheep, a cow, some meat, and some vegetables.
; (all of these count as one passenger on the boat)

; The boat can only be rowed by the peasant, his wife, or the shepherd.
; If the wife is with the shepherd while the peasant isn't around, they'll run away together.
; If the shepherd is near the meat when both the peasant and his wife are not around, he'll eat it.
; If the sheep is near the vegetables when the shepherd isn't around, he'll eat them.
; If the cow is near the vegetables when none of the humans are around, he'll eat them.
; It's a lot of trouble to unload the meat, so once it's been unloaded once, it can't be unloaded again.
; The vegetables are easily bruised, so they can only ride on the boat once.

;　最低何手で達成することができるだろうか…？@
; Can you achieve the objective in the smallest number of steps...?

;選択肢５つ。@「１０手未満」「１０手以上１５手未満」「１５手以上２０手未満」「２０手以上２５手未満」「それ以外」
; A. "Less than ten steps" B. "In 10 to 14 steps" C. "In 15 to 20 steps" D. "In 20 to 25 steps" E. "Something else"
;■選択後、以下に進む



;■ヒント
*eva_hinto_10
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2

bg new_mhal_h1a,22
_ld l,":b;sprites\eva\1\eva_b23_komaru4.png",22
advsetwindow "05"

langjp「ちょ、ちょっと待って…。@こんな条件が複雑なパズルってあるの？！」@
;＜絵羽
langen:dwave 0, "voice\05\81000380.ogg":^"W-Wait a second...^@:dwave 0, "voice\05\81000381.ogg":^  Who ever heard of a puzzle with such complicated rules?!"^\

_ld r,":b;sprites\mar\1\mar_a11_akuwarai1.png",80
advsetwindow "13"
langjp「狼と羊のしか知らなかった？@　色々な応用の、複雑なパズルがいっぱいあるんだよ！@　ね？@　縁寿にはわからないでしょ？！@　きっひひひひひひ！」\
;＜真里亞
langen:dwave 0, "voice\13\80400100.ogg":^"Did you only know about the ones with wolves and sheep?^@:dwave 0, "voice\13\80400101.ogg":^  It's got lots of complicated puzzles that you've got to deal with in different ways!^@:dwave 0, "voice\13\80400102.ogg":^  See?^@:dwave 0, "voice\13\80400103.ogg":^  You don't get it either, right, Ange?!^@:dwave 0, "voice\13\80400104.ogg":^  Kihihihihihi!"^\

_ld c,":b;sprites\en2\1\en2_a11_def2b.png",80
advsetwindow "11"

langjp「ヒントちょうだい、ヒント！」\
;＜縁寿
langen:dwave 0, "voice\11\82000674.ogg":^"Please, give me a hint!"^\

bg new_mhal_h1c,23
_ld l,":b;sprites\mar\1\mar_a11_akuwarai2.png",23
advsetwindow "13"

langjp「よく整理することだね。@船は人間の３人にしか漕げない。@あと鬼門を覚えること。@妻は農夫がいない時に羊飼いと一緒にいちゃいけない。@羊飼いは農夫か妻がいない時に肉と一緒にいちゃいけない。@羊は羊飼いが一緒でない時に野菜と一緒にいちゃいけない。@牛も同じだけど、人間なら誰でもＯＫ。@でも、一番のポイントは肉かな？」\
;＜真里亞
langen:dwave 0, "voice\13\80400105.ogg":^"You have to organize your thoughts carefully.^@:dwave 0, "voice\13\80400106.ogg":^  Only the three humans can row the boat.^@:dwave 0, "voice\13\80400107.ogg":^  Then, you have to memorize all the things to look out for.^@:dwave 0, "voice\13\80400108.ogg":^  When the peasant is away, you can't leave his wife with the shepherd.^\:dwave 0, "voice\13\80400109.ogg":^  When both the peasant and his wife are away, you can't leave the shepherd with the meat.^@:dwave 0, "voice\13\80400110.ogg":^  When the shepherd is away, you can't leave the sheep with the veggies.^@:dwave 0, "voice\13\80400111.ogg":^  You also need someone to watch the cow, but any of the humans can do that.^@:dwave 0, "voice\13\80400112.ogg":^  Still, I guess the meat is the real key to the whole thing."^\

_ld r,":b;sprites\eva\1\eva_b25_akire1go.png",24
advsetwindow "05"

langjp「……あぁ、なるほど。@一度船から降ろしたらもう積めないってのは、一度しか船に乗せられないって意味じゃないわね。」\
;＜絵羽
langen:dwave 0, "voice\05\81000382.ogg":^"...Ah, I see.^@:dwave 0, "voice\05\81000383.ogg":^  You can't put it on the boat again once you take it off, but that doesn't mean you can only take it across once."^\

_ld l,":b;sprites\mar\1\mar_a11_akuwarai1.png",80
advsetwindow "13"

langjp「そういうこと。@野菜は本当に片道しか載せられないから、一度船に乗せて対岸に送ったら、もう戻すことは出来ない。@でも肉は、船から降ろしさえしなければ、何度でも行き来は出来る。」\
;＜真里亞
langen:dwave 0, "voice\13\80400113.ogg":^"That's right.^@:dwave 0, "voice\13\80400114.ogg":^  The veggies really can make only one trip, so once you've sent them across, you can't get them back.^@:dwave 0, "voice\13\80400115.ogg":^  But as long as you don't take the meat off the boat, you can take it back and forth as much as you want."^\

bg new_mhal_h1a,24
_ld r,":b;sprites\en2\1\en2_a11_def3a.png",24
advsetwindow "11"

langjp「………すごい複雑。@考えても全然わからない…。」@
;＜縁寿
langen:dwave 0, "voice\11\82000675.ogg":^"...It's so complicated.^@:dwave 0, "voice\11\82000676.ogg":^  Even after thinking about it, I don't get it at all..."^\

_ld l,":b;sprites\eva\1\eva_b25_odoroki1.png",23
advsetwindow "05"

langjp「紙に書いて整理するしかないわ。@縁寿ちゃんもいる？@　メモと筆記用具。」\
;＜絵羽
langen:dwave 0, "voice\05\81000384.ogg":^"We'll have to write it down and sort out our ideas.^@:dwave 0, "voice\05\81000385.ogg":^  Do you want a pen and paper too, ^@:dwave 0, "voice\05\81000386.ogg":^Ange-chan?"^\

ut_mld c,":b;sprites\mar\1\mar_a11_akuwarai2.png",24
advsetwindow "13"

langjp「無理無理、絶対に解けやしないよ！@　降参しちゃえば？@　無能は思考するだけ時間の無駄だってば！@　きっひひひひひひひひひひ…！」\
;＜真里亞
langen:dwave 0, "voice\13\80400116.ogg":^"Impossible, impossible!  You'll never solve it!^@:dwave 0, "voice\13\80400117.ogg":^  If only you'd just give up.^@:dwave 0, "voice\13\80400118.ogg":^  Thinking is a waste of time for the incompetent!^@:dwave 0, "voice\13\80400119.ogg":^  Kihihihihihihihihi...!"^\

_ld l,":b;sprites\eva\1\eva_b25_komaru4.png",80
advsetwindow "05"

langjp「これ、本当に解けるの？@　実は解けない矛盾した問題ってことはないでしょうね？」@
;＜絵羽
langen:dwave 0, "voice\05\81000387.ogg":^"Can this really be solved?^@:dwave 0, "voice\05\81000388.ogg":^  Don't tell me there's actually some contradiction that makes it unsolvable..."^\

ut_mld c,":b;sprites\mar\1\mar_a11_akuwarai1.png",80
advsetwindow "13"

langjp「うーーー？@　さぁ、どうかなぁ？@　きーっひっひっひっひ！」\
;＜真里亞
langen:dwave 0, "voice\13\80400120.ogg":^"Uuu---?^@:dwave 0, "voice\13\80400121.ogg":^  Who knows?^@:dwave 0, "voice\13\80400122.ogg":^  Kiiihihihihihihi!"^\

mcl c,0
bg black,2

return



