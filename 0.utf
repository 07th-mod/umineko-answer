langen:dwave 0, "voice\53\75300412.ogg":^"...I-I heard...^@/
advsetwindow "53"
langen:delay 1900:dwave 0, "voice\53\75300413.ogg":^...that I was the child they were finally blessed with after so long...^@:dwave 0, "voice\53\75300414.ogg":^and that Jessica was born the next year..."^\


