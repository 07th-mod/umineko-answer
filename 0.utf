_ld r,":b;sprites\cur\1\cur_a11_majime3star.png",24
advsetwindow "55"

langjp「……私も、そこに引っ掛かりました。@しかし、きっとこれを指し示すに違いないという、強い信念がありました。」\
;＜クレル
langen:dwave 0, "voice\55\75500839.ogg":^"...I was also stuck on that part.^@:dwave 0, "voice\55\75500840.ogg":^  However, by then, I was very confident that this station was what the epitaph referred to."^\


;ld r,RIO_FumanA1,35
