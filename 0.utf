;▲第１３アイキャッチ　１３Ｐ（計１７５Ｐ）時計２時２２分


*umi6_14
mov %play_scene,60090
;■ゲストハウス、ラウンジ

mov %BUT_Isyou,2
me1v 13,70

textoff
dllefe 1,1
bg new_g_o1ar,22
wait 2000
bg black,22
dllefe_off
bg black,80

fedexx 0,50,0,0,0,0,1000

bg new_glob_1ar,0

_ld r,":b;sprites\cla\1\cla_a11_nayamu2.png",23

se1 30
_ld r,":b;sprites\cla\1\cla_a15_komaru4.png",26

bgm1 32
advsetwindow "02"

langjp「………た、…確かに考えられん話ではない…。@使用人が、一番怪しい…。」\
;＜蔵臼
langen:dwave 0, "voice\02\60800043.ogg":^"......Tr-True, it isn't unthinkable...^@:dwave 0, "voice\02\60800044.ogg":^  The servants are the most suspicious..."^\

_ld l,":b;sprites\eri\1\eri_a11_majime1.png",23
advsetwindow "46"

langjp「物的証拠があるわけではありませんから、縛ってクローゼットに放り込むわけにも行きません。@ですから、銃を持った皆さんの常に目に届くところにおいて、よく見張る必要があります。」\
;＜ヱリカ
langen:dwave 0, "voice\46\64500797.ogg":^"It isn't as though we have any physical evidence, so we can't tie them up and throw them in a closet.^@:dwave 0, "voice\46\64500798.ogg":^  So, we need to make sure that they're always within sight of those with guns, and that we keep an eye on them all the time."^\

_ld c,":b;sprites\rud\1\rud_a14_ikari1.png",24
advsetwindow "08"

langjp「兄貴、マスターキーも回収した方がいい。@……あの密室も、使用人たち以外には作れるわけがないんだ。@使用人たちしか知らない構造や、道具などで、きっとチェーンロックをどうにか出来たに違いない。」\
;＜留弗夫
langen:dwave 0, "voice\08\61200071.ogg":^"Aniki, we should also gather the master keys.^@:dwave 0, "voice\08\61200072.ogg":^  ...Only the servants could've created those closed rooms.^@:dwave 0, "voice\08\61200073.ogg":^  They must've done something with the chain locks using some tool or arrangement that only the servants know about."^\

_ld r,":b;sprites\cla\1\cla_a15_nayamu2.png",80
advsetwindow "02"

langjp「……皆、長く勤めてくれている者ばかりだ。@私には到底、彼らが殺人を犯すとは思えんのだが…。」\
;＜蔵臼
langen:dwave 0, "voice\02\60800045.ogg":^"...They have all served us for a long time.^@:dwave 0, "voice\02\60800046.ogg":^  I can hardly imagine that they would commit murder..."^\

cl l,24

bg new_glob_1dr,24
_ld c,":b;sprites\eri\1\eri_a11_majime2.png",24
advsetwindow "46"

langjp「金蔵さんの寿命もわずかで、遺産問題で大きく揺れているそうですね。@……それに加え、１０ｔの黄金がどこかに隠されている、なんて話もあるそうじゃないですか。@それらの分け前にありつけるなら、人は罪を犯せるかもしれません…。」\
;＜ヱリカ
langen:dwave 0, "voice\46\64500799.ogg":^"Kinzo-san's life is nearly over, and I hear that the inheritance problem is still very shaky.^@:dwave 0, "voice\46\64500800.ogg":^  ...Add on that story about 10 tons of gold being hidden somewhere.^@:dwave 0, "voice\46\64500801.ogg":^  A possible payoff like that might be enough to convince certain people to commit a crime..."^\

_ld r,":b;sprites\rud\1\rud_a14_majime2.png",24
advsetwindow "08"

langjp「考えたくはないが、………クソ親父のおかしなオカルト儀式って可能性もある。@片翼の使用人たちは親父の手先で、殺人の実行者かもな。@……親父はどうなんだ。@まだ連絡は取れないのか。」\
;＜留弗夫
langen:dwave 0, "voice\08\61200074.ogg":^"I don't want to think about it, ...but there's also a chance that the old bastard is running some bizarre occult ceremony.^@:dwave 0, "voice\08\61200075.ogg":^  The servants of the One Wing are his pawns, and they might've been the ones to carry out the murders.^@:dwave 0, "voice\08\61200076.ogg":^  ...How about Dad, anyway?^@:dwave 0, "voice\08\61200077.ogg":^  Have we been able to contact him yet?"^\

bg black,23

me5v 16,50

bg new_glob_1ar,0
_ld l,":b;sprites\cla\1\cla_a15_nayamu2.png",23
advsetwindow "02"

langjp「う、うむ…。@内線電話も通じないのだ…。@犯人に壊されたのかもしれない。@……それに親父殿は不機嫌になると、電話の受話器を外していることがよくある…。@ノックをしても、その、……不機嫌な返事があるだけ、…だった。@……連絡は取れんが、あの書斎はシェルターも同然だ。@むしろ安全だから、閉じ篭ってくれた方がいいだろう…。」\
;＜蔵臼
langen:dwave 0, "voice\02\60800047.ogg":^"N-No...^@:dwave 0, "voice\02\60800048.ogg":^  The extension line isn't working either...^@:dwave 0, "voice\02\60800049.ogg":^  The culprits may have broken it.^@:dwave 0, "voice\02\60800050.ogg":^  ...And Father does sometimes leave the receiver off the hook when he's in a bad mood...^\:dwave 0, "voice\02\60800051.ogg":^  When I knocked, umm, ...I only received a grumpy reply...^@:dwave 0, "voice\02\60800052.ogg":^   ...We can't contact him, but that study is well protected.^@:dwave 0, "voice\02\60800053.ogg":^  It's probably safer there, so it might be best to have him stay there..."^\

;bg black,22
bg new_glob_1er,2
advsetwindow "-1"

langjp　蔵臼はしどろもどろに、金蔵のことを誤魔化そうと試みている。@
langen^Flustered, Krauss tried to explain away Kinzo's silence.^@
advsetwindow "-1"
;br
langjp　ゲームマスターの戦人は、今回のゲームでは「金蔵の死」を特にキーワードとはしていないようなので、話はそれ以上続かない。@
langen^Battler, the Game Master, hadn't made `Kinzo's death' a major theme for this game, so the conversation didn't progress any further at this point.^\
advsetwindow "-1"
;br
langjp　留弗夫は特に不審には思わず、それで金蔵の話を終えた。\
