_ld l,":b;sprites\cur\1\cur_a11_komaru4.png",23
advsetwindow "27"

langjp「見事であるぞ…。@そうだ、その意気であるぞ…！@　よくぞ、その境地に達した。」@
;＜クレル
langen:dwave 0, "voice\55\75500724.ogg":^"Well done.^@:dwave 0, "voice\55\75500725.ogg":^  Yes, that's the right attitude...!^@:dwave 0, "voice\55\75500726.ogg":^  You have done well to reach this understanding."^\

_ld r,":b;sprites\sha\1\sha_a11_warai1.png",24
advsetwindow "15"

