*umi_start

;右クリック第三サイドフラグｏｆｆ
	mov %side_flg,0

csp -1
seplay 9,17
bg white,10
E_MA
delay 2000

;現在はシナリオが一つのため強制的にｅｐ５へ

if %scenario_Number = 5 goto *umi5_standby
if %scenario_Number = 6 goto *umi6_standby
if %scenario_Number = 7 goto *umi7_standby
if %scenario_Number = 8 goto *umi8_standby

;多分、シナリオ選択画面になる予定

*umi5_standby
 if %UMINEKOEND >= 51 goto *scenario_jump_q
 gosub *jump_sysdata_set1_1
 goto *umi5_opning

*umi6_standby
 if %UMINEKOEND >= 61 goto *scenario_jump_q
