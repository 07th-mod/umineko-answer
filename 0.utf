goto *quiz
;■南條の問題
;「？」@に救急を足すと、赤いランプの救急車になる。@;
;１３０から「？」@を引いても、赤いランプの車になるが、救急車ではない。@
;When you're in Japan, the word meaning emergency happens to sound the same as the number nine twice.
;If you add an emergency to ???, you'll get an ambulance with flashing red lights.
;If ??? is subtracted from 130, you'll get another car with flashing lights, but this time it'll be a police car.

;What number goes in the `???'...?
;Hint: The difference between the two cars is half an emergency.

;A. "5" B. "10" C. "15" D. "20" E. "25"



;■ヒント
*eva_hinto_3
bg new_mhal_h1c,0
_ld l,":b;sprites\en2\1\en2_a11_def2.png",22
advsetwindow "11"

langjp「“？”は数字なの？@　でも“救急”は文字でしょ？@　数字＋文字なんて計算できないよ？」\
;＜縁寿
langen:dwave 0, "voice\11\82000523.ogg":^"The ??? is a number?^@:dwave 0, "voice\11\82000524.ogg":^  But emergency is a word.^@:dwave 0, "voice\11\82000525.ogg":^  You can't add a number to a word, right?"^\

_ld r,":b;sprites\eva\1\eva_a11_hohoemi1.png",23
advsetwindow "05"

langjp「救急ってのが、何だかダジャレっぽいわねぇ。@ほら、キューキューって“９９”とも聞こえない？」\
;＜絵羽
langen:dwave 0, "voice\05\81000198.ogg":^"That part sounds like some kind of word game.^@:dwave 0, "voice\05\81000199.ogg":^  After all, `kyu-kyu-' means emergency, and `kyu-' means nine.  If you write two nines together, it looks like 99, doesn't it?"^\

_ld l,":b;sprites\en2\1\en2_a11_def1.png",80
advsetwindow "11"

langjp「つまり、？に９９を足すと救急車になるってこと？」\
;＜縁寿
langen:dwave 0, "voice\11\82000526.ogg":^"So, if you add something to 99, you get an ambulance?"^\

_ld r,":b;sprites\eva\1\eva_a11_def1.png",80
advsetwindow "05"

langjp「？＋９９で出てくる数字が、どうして救急車になるのかしら。@/
langen:dwave 0, "voice\05\81000200.ogg":^"Hmm.  Why does some number added to 99 get you an ambulance?^@/
_ld r,":b;sprites\eva\1\eva_a11_warai1.png",80
advsetwindow "05"
langjp…………あ、わーかった！」\
;＜絵羽
langen:dwave 0, "voice\05\81000201.ogg":^  ......Ah, I've got it!"^\

_ld l,":b;sprites\en2\1\en2_a11_def1b.png",80
advsetwindow "11"

langjp「え、本当？！@　何々、どうして？！」@
;＜縁寿
langen:dwave 0, "voice\11\82000527.ogg":^"Huh, really?!^@:dwave 0, "voice\11\82000528.ogg":^  Hey, what is it?!"^\

_ld r,":b;sprites\eva\1\eva_a11_def1.png",80
advsetwindow "05"

langjp「ヒントね。@救急車じゃない赤いランプの車とは、パトカーのことよ？@　くすくす、もうわかったんじゃない？」\
;＜絵羽
langen:dwave 0, "voice\05\81000202.ogg":^"I'll give you a hint.^@:dwave 0, "voice\05\81000203.ogg":^  You've got a big advantage here that most people around the world don't have.^@:dwave 0, "voice\05\81000204.ogg":^  *giggle*  Then again, even people from other countries could narrow it down to two answers with a little math."^\

bg black,2

return



