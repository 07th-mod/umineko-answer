_ld r,":b;sprites\ber\1\ber_a21_shian1.png",80
advsetwindow "28"

langjp「…………別に深い意味はないわ。@単なる気紛れよ。」@
;＜ベルン
langen:dwave 0, "voice\28\72100188.ogg":^"......It's not like I had any deep reason for it.^@:dwave 0, "voice\28\72100189.ogg":^  It was just a whim."^\

_ld l,":b;sprites\wil\1\wil_a11_ikari1.png",24
advsetwindow "54"

langjp「誰にも理解できない動機だから、理御。せめてお前だけは理解しろ。@この物語の主役は俺じゃない。@/
langen:dwave 0, "voice\54\75400982.ogg":^"This is a motive that no one else can understand, Lion, so you need to be the one to understand it.^@:dwave 0, "voice\54\75400983.ogg":^  I'm not the main character in this tale.^@/
advsetwindow "54"

;ld l,WIL_MajimeA1,80

langjpお前だ。@………俺は、お前の理解を助けるための、介助役に過ぎねェ。」\
;＜ウィル
langen:dwave 0, "voice\54\75400984.ogg":^  You are.^@:dwave 0, "voice\54\75400985.ogg":^  ...I'm just here to help you understand."^\

