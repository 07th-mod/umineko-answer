lspnewold_trans_diff 916,$varlsp116,"",%varlspx116,%varlspy116,%varlspnx116,%varlspny116,%varlsptrans116,%varlspcenter116
~

print 1

return

; params $witchh2
; uses $witchh12, $witchh10, $witchh11
*ld_inner

	notif %is_old_sprites = 1 goto *ld_inner_postold
	mov $witchh12, ":b;"
	add $witchh12, $witchh2
	add $witchh12, ".png"
	mov $witchh10, $witchh2
	add $witchh10, ".png"

	fileexist %witchh11, $witchh10
	if %witchh11 = 1 goto *ld_inner_postold
		mov $witchh12, ":a;"
		add $witchh12, $witchh2
		add $witchh12, ".bmp"
	*ld_inner_postold

	if %is_old_sprites = 1 jumpf
	mov $witchh12, ":b;big\"
	add $witchh12, $witchh2
	add $witchh12, ".png"
	~
return

*ld_old
	getparam %witchh1,$witchh2,%witchh3  ;立ち絵位置（l左　C中央　ｒ右）、立ち絵、表示方法

	gosub *ld_inner

	mov $witchh15,$witchh12
	mov %witchh16,%witchh3
	if %hide_new_sprites = 1 && %is_old_sprites = 0 mov $witchh15,":r;bmp\placeholder.png" : mov %witchh16,1

	;左の画像が前に来るようにする。
	notif %witchh1 = l jumpf
	_ld l,$witchh15,%witchh3 : mov $last_l, $witchh2
	~
	if %witchh1 = c _ld c,$witchh15,%witchh16 : mov $last_c, $witchh2
	if %witchh1 = r _ld r,$witchh15,%witchh16 : mov $last_r, $witchh2

return

*ld4
	getparam %witchh1,$witchh2,%witchh3,%witchh5  ;立ち絵位置（l左　C中央　ｒ右）、立ち絵、表示方法
	gosub *ld_inner

	mov $witchh15,$witchh12
	if %hide_new_sprites = 1 && %is_old_sprites = 0 mov $witchh15,":r;bmp\placeholder.png"

	;左の画像が前に来るようにする。
	if %witchh1 = l _ld l,$witchh15,%witchh3,%witchh5 : mov $last_l, $witchh2
	if %witchh1 = c _ld c,$witchh15,%witchh3,%witchh5 : mov $last_c, $witchh2
	if %witchh1 = r _ld r,$witchh15,%witchh3,%witchh5 : mov $last_r, $witchh2

return

*ld5
	getparam %witchh1,$witchh2,%witchh3,%witchh5,$witchh6  ;立ち絵位置（l左　C中央　ｒ右）、立ち絵、表示方法
	gosub *ld_inner

	;左の画像が前に来るようにする。

	mov $witchh15,$witchh12
	if %hide_new_sprites = 1 && %is_old_sprites = 0 mov $witchh15,":r;bmp\placeholder.png"


	if %witchh1 = l _ld l,$witchh15,%witchh3,%witchh5,$witchh6 : mov $last_l, $witchh2
	if %witchh1 = c _ld c,$witchh15,%witchh3,%witchh5,$witchh6 : mov $last_c, $witchh2
	if %witchh1 = r _ld r,$witchh15,%witchh3,%witchh5,$witchh6 : mov $last_r, $witchh2

return

*showchartiptachi
	;(表示処理）
	notif %is_old_sprites = 1 jumpf
	mov $witchh4, ":ba;"
	add $witchh4, $r_cha_tati_path
	add $witchh4, ".png"
	lsp cha_lsp,$witchh4,?r[%scenario_Number][%witchh5][tati_x],0
	~
	if %is_old_sprites = 1 jumpf
	mov $witchh4, ":ba;big\"
	add $witchh4, $r_cha_tati_path
	add $witchh4, ".png"
	lsp cha_lsp,$witchh4,363,-6
	~
return

*set_achievement
	getparam $witchh14

steamsetachieve $witchh14

if $witchh14 == "UMC51" mov %achieve_51,1
if $witchh14 == "UMC52" mov %achieve_52,1
if $witchh14 == "UMC53" mov %achieve_53,1
if $witchh14 == "UMC54" mov %achieve_54,1
if $witchh14 == "UMC55" mov %achieve_55,1
if $witchh14 == "UMC61" mov %achieve_61,1
if $witchh14 == "UMC62" mov %achieve_62,1
if $witchh14 == "UMC63" mov %achieve_63,1
if $witchh14 == "UMC64" mov %achieve_64,1
if $witchh14 == "UMC65" mov %achieve_65,1
if $witchh14 == "UMC71" mov %achieve_71,1
if $witchh14 == "UMC72" mov %achieve_72,1
if $witchh14 == "UMC73" mov %achieve_73,1
if $witchh14 == "UMC74" mov %achieve_74,1
if $witchh14 == "UMC75" mov %achieve_75,1
if $witchh14 == "UMC81" mov %achieve_81,1
if $witchh14 == "UMC82" mov %achieve_82,1
if $witchh14 == "UMC83" mov %achieve_83,1
if $witchh14 == "UMC84" mov %achieve_84,1
if $witchh14 == "UMC85" mov %achieve_85,1
if $witchh14 == "UMC86" mov %achieve_86,1
if $witchh14 == "UMC87" mov %achieve_87,1

if %achieve_51 == 1 && %achieve_52 == 1 && %achieve_53 == 1 && %achieve_54 == 1 && %achieve_55 == 1 && %achieve_61 == 1 && %achieve_62 == 1 && %achieve_63 == 1 && %achieve_64 == 1 && %achieve_65 == 1 && %achieve_71 == 1 && %achieve_72 == 1 && %achieve_73 == 1 && %achieve_74 == 1 && %achieve_75 == 1 && %achieve_81 == 1 && %achieve_82 == 1 && %achieve_83 == 1 && %achieve_84 == 1 && %achieve_85 == 1 && %achieve_86 == 1 && %achieve_87 == 1 steamsetachieve "UMC88" : mov %achieve_88,1

return

;----------------------- 07th mod Custom functions --------------------------------------
;                                      0    1       2        3        4     5
;note- array spinfo has three parts [life, xspeed, yspeed, spriteno, xpos, ypos]

*drojf_snow_init
if %textboxType == 0 setwindow 73,368,32,17,24,24,0,0,20,1,1,":b;textbox\-1.png",47,315
if %textboxType == 1 setwindow 73,368,32,17,24,24,0,0,20,1,1,":b;textbox_black\-1.png",47,315
if %textboxType == 2 setwindow 73,368,32,17,24,24,0,0,20,1,1,":b;textbox_clean\-1.png",47,315
advsetwindow "-1"
;<NO_TEXT_END>

resettimer
mov %Free4, 10  ;normal sprite number
mov %Free5, 900 ;background sprite number

for %Free3 = 0 to drojf_numballs-1
	;all sprites start deactivated
	mov ?spinfo[%Free3][0], -1

	;initialize foreground orbs
	if (%Free3 mod 2) == 0 jumpf
		lsp %Free4, ":ab;bmp\background\efe\orb.png", -100, -100 ;this is not used
		
		;save sprite number
		mov ?spinfo[%Free3][3], %Free4
		
		;probably need a better way to calculate random velocity to ensure constant speed
		rnd2 ?spinfo[%Free3][1], 5, 6
		rnd2 ?spinfo[%Free3][2], 2, 3

		inc %Free4
	~

	;initialize background orbs
	if (%Free3 mod 2) == 1 jumpf
		lsp %Free5, ":ab;bmp\background\efe\orb_small.png", -100, -100
		
		;save sprite number
		mov ?spinfo[%Free3][3], %Free5 
		
		;background sprites move slower
		rnd2 ?spinfo[%Free3][1], 4, 5
		rnd2 ?spinfo[%Free3][2], 1, 2

		inc %Free5
	~

	;counter for orb spawn rate
	mov %Free8, 0

next
return

*drojf_snow_off
for %Free3 = 0 to drojf_numballs-1
	msp ?spinfo[%Free3][3], 0, 0, -255
next
return

*drojf_snow_on
for %Free3 = 0 to drojf_numballs-1
	msp ?spinfo[%Free3][3], 0, 0, 255
next
return

*drojf_snow_finish
erasetextwindow 1
if %textboxType == 0 setwindow 73,368,32,17,24,24,0,0,20,1,1,":b;textbox\-1.png",47,315
if %textboxType == 1 setwindow 73,368,32,17,24,24,0,0,20,1,1,":b;textbox_black\-1.png",47,315
if %textboxType == 2 setwindow 73,368,32,17,24,24,0,0,20,1,1,":b;textbox_clean\-1.png",47,315
advsetwindow "-1"
;<NO_TEXT_END>
return

*drojf_snow_loop
	getparam %Free6
	
	;resettimer
	gettimer %Free7

	if %Free6 == -1 jumpf
		add %Free6, %Free7
	~

	mov %Free9, %Free7 / 30
	*drojf_snow_loop_inner
		gettimer %Free7 
		if %Free7 < %Free9 * 30 jumpf
			gosub *drojf_do_snow
			print 1
			mov %Free9, %Free9 + 1 
		~

		if %Free6 == -1 jumpf
			if %Free7 > %Free6 goto *drojf_snow_loop_finished
		~

		if	%Free6 != -1 jumpf
			trap *drojf_snow_loop_finished
		~

		;if %Free7 > 60000 goto *drojf_snow_loop_finished

	goto *drojf_snow_loop_inner

	*drojf_snow_loop_finished
return


*drojf_print_snow
	erasetextwindow 0

	mov %witchh9, 1 ;type of clear to be performed


	getparam $witchh5
	langen
	textspeed 0	;required otherwise text displays slowly
	len %Free2, $witchh5 ;length of string
	
	;for some reason if you use ^^ the ^ is included in string, so skip first character
	mov %Free1, 1 

	*drojf_loop_print
		gettimer %Free7 
		if %Free7 < %Free1 * 30 jumpf
			gosub *drojf_do_snow
			mid $witchh4,$witchh5, %Free1, 1

			if $witchh4 == "@" drojf_snow_loop -1 : jumpf
			if $witchh4 == "\" mov %witchh9, 2 : jumpf
			if $witchh4 == "/" mov %witchh9, 0 : jumpf
			if $witchh4 == "|" br : br : jumpf

			$witchh4/			
			~

			; insert linebreak if char is space and too far to rhs
			getcursorpos %witchh8, %witchh10
			if %witchh8 < 750 jumpf ;adv_drojf_snow_wrap_threshold
				if $witchh4 == " " br : br
			~		
			print 1
			mov %Free1, %Free1 + 1 
		~
		;break once all characters are printed
		if %Free1 >= %Free2 jumpf

		;trap *drojf_print_clicked

	goto *drojf_loop_print
	~

	;if last character not forward slash, insert br
	if %witchh9 == 0 jumpf
	if %witchh9 == 1 br : br : jumpf
	if %witchh9 == 2 drojf_snow_loop -1 : textclear : jumpf		
	~

	;jumpf
	;*drojf_print_clicked
	;if %Free1 >= %Free2 jumpf
	;	mid $witchh4,$witchh5, %Free1, %Free2-1
	;	$witchh4
	;~

	;trap off

	erasetextwindow 1
return

*drojf_do_snow
	for %Free3 = 0 to drojf_numballs-1

		; if particle spawned then update it 
		if ?spinfo[%Free3][0] == -1 goto *particledead
		  	;add speed to current position
		  	add ?spinfo[%Free3][4], ?spinfo[%Free3][1]
		  	add ?spinfo[%Free3][5], ?spinfo[%Free3][2]

		  	;set sprite to new position
		  	amsp ?spinfo[%Free3][3], ?spinfo[%Free3][4], ?spinfo[%Free3][5]

			; kill particle if out of bounds
		  	if ?spinfo[%Free3][4] > 1000 goto *drojf_respawn_ball
		  	if ?spinfo[%Free3][5] > 600 goto *drojf_respawn_ball

		*particledead

		;handle initial spawning of particles
		if %Free8 < 200 jumpf
			if ?spinfo[%Free3][0] != -1 jumpf 
				mov %Free8, 0
				*drojf_respawn_ball
				
				gosub drojf_get_random_spawn
				mov ?spinfo[%Free3][4], %witchh10
				mov ?spinfo[%Free3][5], %witchh11

				;amsp ?spinfo[%Free3][3], %witchh10, %witchh11
				mov ?spinfo[%Free3][0], 250
		~
		inc %Free8
	next
return

*drojf_get_random_spawn
	rnd %witchh10, 100

	if %witchh10 < 50 jumpf
		;spawn ball on top side of screen
		rnd %witchh10, 960
		mov %witchh11, -40
		return
	~

	;spawn ball on lhs of screen
	mov %witchh10, -40
	rnd %witchh11, 540
return


;load a standing sprite so that its center is at the 'x'
;variable and the y is offset by the 'y' variable
*ut_lsp

    getparam %meta_tmp1,$witchh2,%x,%y

    lsp %meta_tmp1,$witchh2,0,0

    getspsize %meta_tmp1,%meta_tmp5,%meta_tmp6,%meta_tmp7

    _amsp %meta_tmp1, %x-(%meta_tmp5/4), (1080 - %meta_tmp6) / 2 + %y + ut_mld_offset

return

*mpegplay_custom_vol
	getparam $witchh2,%witchh10,%witchh11

	;force volume - witchh11 not used for bgmvol after this line 
	_bgmvol %witchh11

	;play the movie
	fileexist %witchh11,$witchh2 + ".mpg"
	if %witchh11 = 1 _mpegplay $witchh2 + ".mpg",%witchh10
	if %witchh11 = 0 _mpegplay $witchh2,%witchh10

	;restore the volume
	bgmvol_safe %BGM_v_Ch

return

*mpegplay
    getparam $witchh2,%witchh10
    mpegplay_custom_vol $witchh2,%witchh10,55
return

*chvol
    getparam %witchh6,%witchh7
    mov %witchh7, %witchh7 * %musicVolume / volY
    if %witchh7 > 100  mov %witchh7, 100
    if %witchh7 < 0    mov %witchh7, 0
    _chvol %witchh6, %witchh7
return

*bgmvol_safe
    getparam %witchh7
    mov %witchh7, %witchh7 * %musicVolume / volY
    if %witchh7 > 100  mov %witchh7, 100
    if %witchh7 < 0    mov %witchh7, 0
    _bgmvol %witchh7
return

*seventh_change_voice_level
    getparam %witchh7

    ;get sum of parameter and voice volume, then limit it to 0-60
    add %witchh7, %voiceVolume
    if %witchh7 > 70  mov %witchh7, 70
    if %witchh7 < 0   mov %witchh7, 0

    mov %voiceVolume, %witchh7
    voicevol %voiceVolume
return


*drojf_jump_sysdata_set1_1   ;シナリオ１-１システム設定

btndef ""
textoff
gosub *DATA_SET

csp -1
bg black,22
windoweffect 50,200
langjp!sd
langen!sd
return


*advsetwindow
    getparam $Free28

    ; if named textbox not enabled, this function just returns
    if %Free28 == 0 return

    ; the image -1.png is the no-named textbox
    if $Free28 == "00" mov $Free28, "-1"
    if $Free28 == "99" mov $Free28, "-1"

    ; calculate the filename
    mov $Free29, ":b;textbox\"

    if %textboxType != 1 jumpf
    mov $Free29, ":b;textbox_black\"
    ~

	if %textboxType != 2 jumpf
	mov $Free29, ":b;textbox_clean\"
	~

    add $Free29, $Free28
    add $Free29, ".png"

    ; only update the window if it is different to the current one and adv mode enabled
	if %adv_call_state == 0 jumpf
    if $Free26 != $Free29   setwindow2 $Free29 : mov $Free26,$Free29
	~
return

*beginADVSection
	mov %adv_call_state, 1
	if %textboxType == 0 setwindow 73,368,32,17,24,24,0,0,20,1,1,":b;textbox\-1.png",47,315      : return
	if %textboxType == 1 setwindow 73,368,32,17,24,24,0,0,20,1,1,":b;textbox_black\-1.png",47,315 : return
	if %textboxType == 2 setwindow 73,368,32,17,24,24,0,0,20,1,1,":b;textbox_clean\-1.png",47,315 : return

*changeTextboxType
	if %textboxType == 0 mov %textboxType, 1 : mov $textboxName, "Black (with logo)" : return
	if %textboxType == 1 mov %textboxType, 2 : mov $textboxName, "Black (without logo)" : return
	if %textboxType == 2 mov %textboxType, 0 : mov $textboxName, "Red" : return

*spoiler_play_movie
	getparam $witchh3
	if %movieSpoilerLevel != 2 jumpf
		mov $witchh3, "movie\op.mpg"
	~
	fileexist %Free1, $witchh3
	if %Free1 == 1 mpegplay $witchh3, 1 : return

^Warning: movie not found!\
return

*indicateNVLSection
	mov %adv_call_state, 0
return

