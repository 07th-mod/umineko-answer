advsetwindow "16"

langjp「ドジらないでよ。」@
;＜嘉音
langen:dwave 0, "voice\16\50600021.ogg":^"Don't screw up."^\

_ld c,":b;sprites\sha\1\sha_a11_fuman1.png",80
