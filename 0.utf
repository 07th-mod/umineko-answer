advsetwindow "27"

langjp「そろそろやって来る頃合だな。@しかし、良いのか？@　縁寿にまた誤解されるぞ？」@
;＜ベアト
langen:dwave 0, "voice\27\80700212.ogg":^"It's almost time.^@:dwave 0, "voice\27\80700213.ogg":^  But, are you sure?^@:dwave 0, "voice\27\80700214.ogg":^  Ange might get the wrong idea again, right?"^\

;cl c,0
