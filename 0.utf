mov %play_scene,80110 ;シーン変数の入力

mov %r_hyouji_side,0
mov %r_hyouji_cha,but
;■紗音は譲治以外の誰にでも殺せる
mov %BUT_Isyou,2

bgm1 95

bg new_different_space_1a,22
_ld l,":b;sprites\but\1\but_d24_komaru2.png",22
advsetwindow "10"

langjp「続く事件は第四の晩だ。@殺されたのは紗音ちゃん。@全員にアリバイがないが、１人だけ例外がいる。」\
;＜戦人
langen:dwave 0, "voice\10\80100797.ogg":^"The next crime is the fourth twilight.^@:dwave 0, "voice\10\80100798.ogg":^  Shannon-chan was the one killed.^@:dwave 0, "voice\10\80100799.ogg":^  No one has an alibi, with one exception."\

_ld r,":b;sprites\bea\1\bea_a11_majime2.png",24
advsetwindow "27"

langjp「譲治であるな。@シロが確定している朱志香が紫発言にて、譲治には紗音殺しは不可能であると断言している。@となれば、殺したのは戦人か真里亞のどちらかということか？」\
;＜ベアト
langen:dwave 0, "voice\27\80700567.ogg":^"George.^@:dwave 0, "voice\27\80700568.ogg":^  Jessica, who has been confirmed innocent, used the purple text to say that it was impossible for George to kill Shannon.^@:dwave 0, "voice\27\80700569.ogg":^  So, doesn't that mean either Battler or Maria must have killed her?"^\

_ld l,":b;sprites\but\1\but_d11_majime6.png",80
advsetwindow "10"

langjp「そう思いたいところだが早計だ。@戦人と真里亞、そして譲治以外の人物にだって、アリバイはない。@俺は単独犯説を否定したが、犯人が二人であることを断言したつもりもない。@現時点では、それを断言するにはまだ早過ぎるからな。」\
;＜戦人
langen:dwave 0, "voice\10\80100800.ogg":^"I'd like to think that, but it's too soon to be sure.^@:dwave 0, "voice\10\80100801.ogg":^  Battler, Maria, and every other person except George lacks an alibi.^@:dwave 0, "voice\10\80100802.ogg":^  I've managed to prove that the crime wasn't committed by a single person, but I didn't prove that there were exactly two culprits.^@:dwave 0, "voice\10\80100803.ogg":^  At this point in time, it's still too soon to be sure."^\

_ld r,":b;sprites\bea\1\bea_a11_komaru4.png",80
advsetwindow "27"

langjp「なるほどな。@第一の晩と第二の晩の犯人と、その死んだフリを虚偽の検死で助けたもう１人の犯人と。@……さらに、それとは無関係の犯人が存在する可能性があるというわけか。@……なるほど、これは盲点であった…。」\
;＜ベアト
langen:dwave 0, "voice\27\80700570.ogg":^"I see.^@:dwave 0, "voice\27\80700571.ogg":^  There might be a culprit for the first and second twilights, a culprit who lied about the first culprit's death,^@:dwave 0, "voice\27\80700572.ogg":^ ...and another completely separate culprit as well.^@:dwave 0, "voice\27\80700573.ogg":^  ...Yes, it was a mistake to overlook that..."^\

_ld l,":b;sprites\but\1\but_d11_nayamu4.png",80
advsetwindow "10"

langjp「紗音ちゃんの事件は、譲治の兄貴ただ一人の例外を除いて、誰にでも犯行可能だ。@そして、その事実だけを以って、譲治の兄貴がシロであることを証明するわけでもない。」\
;＜戦人
langen:dwave 0, "voice\10\80100804.ogg":^"The murder of Shannon-chan was possible for anyone, with only one single exception.^@:dwave 0, "voice\10\80100805.ogg":^  Also, that fact alone isn't enough to prove that George-aniki is innocent."^\

_ld r,":b;sprites\bea\1\bea_a11_futeki2.png",80
advsetwindow "27"

langjp「……密室殺人ではないから気楽だなどと思っていたが。@むしろ、おかしな条件がない分、犯人の絞り込みに使える情報もない、というわけであるな…。」\
;＜ベアト
langen:dwave 0, "voice\27\80700574.ogg":^"...I thought this would be an easy one since there's no closed room,^@:dwave 0, "voice\27\80700575.ogg":^ but on the contrary, we have no suspicious circumstances and no information to lead us to the culprit..."^\

_ld l,":b;sprites\but\1\but_d11_oya1.png",80
advsetwindow "10"

langjp「ここからは事件のペースが早い。@これだけに固執せず、次の第五の晩の事件も見てみようぜ。」\
;＜戦人
langen:dwave 0, "voice\10\80100806.ogg":^"The pace of the crimes picks up starting here.^@:dwave 0, "voice\10\80100807.ogg":^  Instead of getting stuck on this one part, we should start taking a look at the fifth twilight too."^\

bg black,2
fede 0,1000
E_A

if %hinto_point = 11 : inc %hinto_point

goto *quest_mode



*hinto_13
mov %play_scene,80110 ;シーン変数の入力

mov %r_hyouji_side,0
mov %r_hyouji_cha,but
;■死んだフリをした犯人がいる。そしてもう１人犯人がいる。
mov %BUT_Isyou,2

bgm1 71

bg new_different_space_1c,22
_ld r,":b;sprites\bea\1\bea_a11_1_majime5star.png",22
advsetwindow "27"

langjp「第五、第六の晩であるが、厄介であるぞ…！@　信頼できる朱志香の紫発言がこう言っている！@　“いとこ４人と南條には、郷田と熊沢は殺せない”とな…！」\
;＜ベアト
langen:dwave 0, "voice\27\80700576.ogg":^"It seems we have a problem with the fifth and sixth twilights...!^@:dwave 0, "voice\27\80700577.ogg":^  We can trust Jessica's purple statements, and she said this:^@:dwave 0, "voice\27\80700578.ogg":^ the four cousins and Doctor Nanjo couldn't have killed Gohda-san or Kumasawa-san...!"^\

_ld l,":b;sprites\but\1\but_d11_futeki1.png",23
advsetwindow "10"

langjp「いとこ４人と南條先生。@これはつまり、この時点での生存者全員を指す。@普通に考えたら不可能犯罪だ。」\
;＜戦人
langen:dwave 0, "voice\10\80100808.ogg":^"The four cousins and Nanjo.^@:dwave 0, "voice\10\80100809.ogg":^  In other words, all of the survivors at this point in time.^@:dwave 0, "voice\10\80100810.ogg":^  On the face of it, that makes this crime impossible."^\

_ld r,":b;sprites\bea\1\bea_a11_akuwarai1.png",80
advsetwindow "27"

langjp「しかし、そこでチェス盤を引っ繰り返すわけであるな？」@
;＜ベアト
langen:dwave 0, "voice\27\80700579.ogg":^"However, that's where we can spin the chessboard around, correct?"^\

cl l,0
_ld c,":b;sprites\but\1\but_d11_futeki3.png",23
advsetwindow "10"

langjp「あぁ。@ってことはあるシンプルな答えが現れる。@いとこ４人と南條先生以外の何者かが犯人だってことを、この事件は証明しているってわけだ。」\
;＜戦人
langen:dwave 0, "voice\10\80100811.ogg":^"You've got it.^@:dwave 0, "voice\10\80100812.ogg":^  This actually gives us a simple answer.^@:dwave 0, "voice\10\80100813.ogg":^  This twilight proves that there's a culprit who isn't Doctor Nanjo or one of the cousins."^\

_ld r,":b;sprites\bea\1\bea_a11_1_majime6.png",80
advsetwindow "27"

langjp「生存者以外は、全員が死亡していることになっている。@にもかかわらず、生存者には犯行不能ということは……。」\
;＜ベアト
langen:dwave 0, "voice\27\80700580.ogg":^"Other than these survivors, everyone is supposed to be dead.^@:dwave 0, "voice\27\80700581.ogg":^  And yet, it was impossible for the survivors to commit the crime..."^\

_ld c,":b;sprites\but\1\but_d11_futeki1.png",80
advsetwindow "10"

langjp「死んだフリをした犯人が、１００％存在することの証明ってわけだ。」@
;＜戦人
langen:dwave 0, "voice\10\80100814.ogg":^"It's absolute proof that one of the culprits faked their death."^\

_ld r,":b;sprites\bea\1\bea_a11_futeki1.png",24
advsetwindow "27"

langjp「そして、死んだフリをした犯人の存在は、犯人が複数であることも１００％証明する。@検死を偽りウソをつくこともまた、犯人にしか出来ないからな…！」\
;＜ベアト
langen:dwave 0, "voice\27\80700582.ogg":^"And, since there exists a culprit who faked his or her death, that's absolute proof that there were multiple culprits.^@:dwave 0, "voice\27\80700583.ogg":^  Only a culprit can fake an examination and lie...!"^\

cl c,0
_ld c,":b;sprites\but\1\but_d11_futeki2.png",23
advsetwindow "10"

langjp「この一見、完全な不可能犯罪に見える第五、第六の晩は、@ただそれだけで雄弁にこれだけのことを語っちまうわけだ。」\
;＜戦人
langen:dwave 0, "voice\10\80100815.ogg":^"The fifth and sixth twilights may seem to be perfect impossible crimes,^@:dwave 0, "voice\10\80100816.ogg":^ but this one incident alone tells us so much."^\

_ld r,":b;sprites\bea\1\bea_a31_akuwarai2.png",80
advsetwindow "27"

langjp「不可能犯罪は、相手を屈服させる力も持つが、逆に一気に推理を切り込まれる危険性も持つ諸刃の刃よ。@……昔のそなたなら、きっと屈服していただろうに。@本当に逞しくなったものよ。」\
;＜ベアト
langen:dwave 0, "voice\27\80700584.ogg":^"Impossible crimes are a double-edged sword.  They have the power to make your opponents surrender, but they also make it possible for theories to break deep into your lines of defense.^@:dwave 0, "voice\27\80700585.ogg":^  ...Long ago, you would surely have surrendered.^@:dwave 0, "voice\27\80700586.ogg":^  How far you've come."^\

_ld c,":b;sprites\but\1\but_d23_futeki1.png",80
advsetwindow "10"

langjp「へへ。@お前にはだいぶ鍛えられたからな。」@
;＜戦人
langen:dwave 0, "voice\10\80100817.ogg":^"Heheh.^@:dwave 0, "voice\10\80100818.ogg":^  It's all because you've trained me so well."^\
advsetwindow "-1"
;br
langjp　戦人たちはニヤリと笑い合う。@
langen^The pair grinned at each other.^@
advsetwindow "-1"
;br
langjp　数々の知的ゲームにて死線を潜った。@
langjp　これくらの謎で、へこたれるわけにはいかない。\
langen^They had been to the brink of death and back in their many intellectual games before now.^@
advsetwindow "-1"
langen^They wouldn't be discouraged by a riddle like this.^\

mcl c,0
bg black,23
bg new_different_space_1a,23
_ld l,":b;sprites\but\1\but_d11_oya1.png",23
advsetwindow "10"

langjp「さらに続けて、第七、第八の晩の事件も見てみよう。@もう、かなり核心に踏み込んでるはずだ。」@
;＜戦人
langen:dwave 0, "voice\10\80100819.ogg":^"Now let's move on to the crimes of the seventh and eighth twilights.^@:dwave 0, "voice\10\80100820.ogg":^  I think we're getting pretty close to the core of things."^\

_ld r,":b;sprites\bea\1\bea_a11_1_majime3star.png",80
advsetwindow "27"

langjp「そうだな、気を引き締めて行こう！」\
;＜ベアト
langen:dwave 0, "voice\27\80700587.ogg":^"Yes, let's get ourselves ready and go!"^\

bg black,2
fede 0,1000
E_A


if %hinto_point = 12 : inc %hinto_point
goto *quest_mode



*hinto_14
mov %play_scene,80110 ;シーン変数の入力

mov %r_hyouji_side,0
mov %r_hyouji_cha,but
;■さらにもう１人犯人がいる？
mov %BUT_Isyou,2

bgm1 39

bg new_different_space_1c,22
_ld l,":b;sprites\but\1\but_d24_komaru2.png",22
advsetwindow "10"

langjp「第七の晩も、状況はまったく同じだ。@信頼できる朱志香の紫発言が、いとこ４人、即ち、生存者の誰にも殺せないと断言している。」\
;＜戦人
langen:dwave 0, "voice\10\80100821.ogg":^"The situation's exactly the same on the seventh twilight.^@:dwave 0, "voice\10\80100822.ogg":^  Since we can trust Jessica's purple statement, the four cousins--or in other words, all of the survivors--couldn't have committed the crime."^\

_ld r,":b;sprites\bea\1\bea_a11_majime2.png",24
advsetwindow "27"

langjp「しかし、……少しわからぬのだ。@第一の晩、第二の晩の犯人は、第一の晩の犠牲者５人の中の誰かだ。@そやつは夏妃の部屋に閉じ込められたが、検死を偽った、そやつの子供もまた犯人であることがわかっている。@……しかし、犯人である可能性のある子供は、戦人、譲治、真里亞の３人のみだ。」\
;＜ベアト
langen:dwave 0, "voice\27\80700588.ogg":^"And yet, ...there's something I don't quite get.^@:dwave 0, "voice\27\80700589.ogg":^  The culprit of the first two twilights was someone in that group of five victims from the first twilight.^\:dwave 0, "voice\27\80700590.ogg":^  Though that first culprit was sealed in Natsuhi's room, their child was also a culprit, who lied when confirming their death.^@:dwave 0, "voice\27\80700591.ogg":^  ...However, the only kids who can be a culprit are Battler, George, and Maria."^\

_ld l,":b;sprites\but\1\but_d11_oya1.png",80
advsetwindow "10"

langjp「そうだな。@その３人は、第五、第六、第七の３つの事件において、殺人不能であると断言されている。」@
;＜戦人
langen:dwave 0, "voice\10\80100823.ogg":^"That's right.^@:dwave 0, "voice\10\80100824.ogg":^  And we've proven that they couldn't have committed murder for the fifth, sixth, and seventh twilights."^\

_ld r,":b;sprites\bea\1\bea_a11_1_majime6.png",80
advsetwindow "27"

langjp「つまりこれは、@………さらにもう１人犯人がいることを指し示すのではないか。」\
;＜ベアト
langen:dwave 0, "voice\27\80700592.ogg":^"In other words,^@:dwave 0, "voice\27\80700593.ogg":^ ......this shows us that yet another culprit exists."^\

_ld l,":b;sprites\but\1\but_d11_futeki2.png",80

bg black,24
bg new_different_space_1a,24
_ld c,":b;sprites\but\1\but_d11_futeki2.png",24
advsetwindow "10"

langjp「面白い。@しかも妥当な推理だな。@そして、その３人目の犯人もまた、死んだフリをした何者かってことになるな。@……これはひょっとすると、犯人が４人、５人ということもありえるかもしれねぇぜ。」\
;＜戦人
langen:dwave 0, "voice\10\80100825.ogg":^"Interesting.^@:dwave 0, "voice\10\80100826.ogg":^  It also happens to be a theory that makes sense.^@:dwave 0, "voice\10\80100827.ogg":^  It would mean that the third culprit was also one of those who played dead.^@:dwave 0, "voice\10\80100828.ogg":^  ...It might even be possible to have four or five culprits this way."^\

_ld l,":b;sprites\bea\1\bea_a11_futeki2.png",23
advsetwindow "27"

langjp「くっくっく、それはどうだかわからぬが。@とにかく、いずれにせよ、犯人が２人だけでは、郷田、熊沢、南條を殺すことは出来ぬのだ。@それだけは間違いない…！」\
;＜ベアト
langen:dwave 0, "voice\27\80700594.ogg":^"*cackle*  I'm not sure about that.^@:dwave 0, "voice\27\80700595.ogg":^  At any rate, Gohda, Kumasawa, and Nanjo couldn't have been killed if there were only two culprits.^@:dwave 0, "voice\27\80700596.ogg":^  There can be no doubt of that...!"^\

_ld c,":b;sprites\but\1\but_d11_futeki1.png",80
advsetwindow "10"

langjp「こりゃ、ややこしいことになって来たぜ。@３人組が犯人なのか。@それとも２人組と単独犯なのか。@……いやいや、３人以上犯人がいる可能性だって否定しちゃいけねぇな？」\
;＜戦人
langen:dwave 0, "voice\10\80100829.ogg":^"This is getting complicated.^@:dwave 0, "voice\10\80100830.ogg":^  Was it a group of three culprits?^@:dwave 0, "voice\10\80100831.ogg":^  Or was it a pair working together and someone else on their own?^@:dwave 0, "voice\10\80100832.ogg":^  ...Ah, right, we can't forget the possibility that there are more than three culprits."^\

_ld l,":b;sprites\bea\1\bea_a11_1_majime3star.png",80
advsetwindow "27"

langjp「１７人の登場人物の内、シロは９人。@残る８人の内、戦人、譲治、真里亞の３人は生存しているから除く。@シロが確定せず、死んだことになっているのは、５人。@絵羽、秀吉、留弗夫、霧江、楼座。@全て、第一の晩の犠牲者だ。」\
;＜ベアト
langen:dwave 0, "voice\27\80700597.ogg":^"Of the 17 people who appear in the story, 9 have been confirmed innocent.^@:dwave 0, "voice\27\80700598.ogg":^  Let's put Battler, George, and Maria to the side, since they survived.^@:dwave 0, "voice\27\80700599.ogg":^  The group of people who were supposedly dead, but not proved innocent,^@:dwave 0, "voice\27\80700600.ogg":^ includes Eva, Hideyoshi, Rudolf, Kyrie, and Rosa, ^@:dwave 0, "voice\27\80700601.ogg":^all victims in the first twilight."^\

_ld c,":b;sprites\but\1\but_d11_futeki3.png",80
advsetwindow "10"

langjp「この、食堂の犠牲者５人の中の、何人が死んだフリをしていたかって問題なわけか。@……いよいよだな。@面白くなってきたぜ…！」\
;＜戦人
langen:dwave 0, "voice\10\80100833.ogg":^"Now, the question is which of those five victims in the dining hall were playing dead.^@:dwave 0, "voice\10\80100834.ogg":^  ...We're close now.^@:dwave 0, "voice\10\80100835.ogg":^  This is starting to get interesting...!"^\

bg black,2
fede 0,1000
E_A

if %hinto_point = 13 : inc %hinto_point

goto *quest_mode



*hinto_15
mov %play_scene,80110 ;シーン変数の入力

mov %r_hyouji_side,0
mov %r_hyouji_cha,but
;■譲治と真里亞はニワトリとタマゴ
mov %BUT_Isyou,2

bgm1 32

bg new_different_space_1a,22
_ld r,":b;sprites\but\1\but_d11_oya1.png",22
advsetwindow "10"

langjp「最後の、第八の晩についても、@状況はまったく変わらないな。」\
;＜戦人
langen:dwave 0, "voice\10\80100836.ogg":^"As for the eighth twilight in the end,^@:dwave 0, "voice\10\80100837.ogg":^ the layout's exactly the same."^\

_ld l,":b;sprites\bea\1\bea_a11_majime1.png",23
advsetwindow "27"

langjp「うむ。@ト書きにて、譲治、戦人、真里亞には、朱志香は殺せないと断言されている。@朱志香は、生存者の３人には殺せないのだ。」\
;＜ベアト
langen:dwave 0, "voice\27\80700602.ogg":^"Indeed.^@:dwave 0, "voice\27\80700603.ogg":^  The narration says that George, Battler, and Maria could not have killed Jessica.^@:dwave 0, "voice\27\80700604.ogg":^  The three survivors couldn't have done it."^\

_ld r,":b;sprites\but\1\but_d11_nayamu3.png",80
advsetwindow "10"

langjp「ここの紫発言は、結構、ヒントになりそうなことを色々と喋ってるんだよな。」@
;＜戦人
langen:dwave 0, "voice\10\80100838.ogg":^"The purple statements here sound like they should hold a lot of hints for us."^\

_ld l,":b;sprites\bea\1\bea_a11_1_majime6.png",80
advsetwindow "27"

langjp「譲治と真里亞の紫発言が興味深いな。@信頼できるなら、強力な手掛りになりそうなのだが……。」\
;＜ベアト
langen:dwave 0, "voice\27\80700605.ogg":^"George's and Maria's purple statements are particularly interesting.^@:dwave 0, "voice\27\80700606.ogg":^  If only we could trust them, they would be quite a powerful clue..."^\

_ld r,":b;sprites\but\1\but_d11_nayamu4.png",80
advsetwindow "10"

langjp「譲治の兄貴がシロなら、“真里亞には誰も殺せない”って紫発言が有効になって、真里亞のシロも確定できる。@同様に真里亞がシロなら、“譲治に大人は殺せない”が有効になって、結果的に譲治の兄貴のシロも確定できる。」\
;＜戦人
langen:dwave 0, "voice\10\80100839.ogg":^"If George-aniki is innocent, then his purple statement about Maria being unable to kill anyone would be true, and Maria would be confirmed innocent.^@:dwave 0, "voice\10\80100840.ogg":^  In the same way, if Maria is innocent, then her statement about George being unable to kill an adult would be true, and in the end, that proves George-aniki innocent."^\

_ld l,":b;sprites\bea\1\bea_a11_komaru3.png",80
advsetwindow "27"

langjp「ではあるが、どちらもシロであると確定できぬ…。」\
;＜ベアト
langen:dwave 0, "voice\27\80700607.ogg":^"It would, but we cannot confirm that either of them is innocent..."^\

bg black,24
bg new_different_space_1a,24
_ld c,":b;sprites\but\1\but_d11_nayamu2.png",24
advsetwindow "10"

langjp「譲治の兄貴と真里亞は、互いに相手が先にシロであることを証明できれば、自分もシロになるという、@まるでニワトリとタマゴのようなジレンマに陥ってる。@ヒントになりそうでならない。@何とももどかしい話だ。」\
;＜戦人
langen:dwave 0, "voice\10\80100841.ogg":^"If either George-aniki or Maria could prove that the other was innocent, they would be innocent too.^@:dwave 0, "voice\10\80100842.ogg":^  It's like a chicken and egg dilemma.^@:dwave 0, "voice\10\80100843.ogg":^  It almost feels like a useful hint, but not quite.^@:dwave 0, "voice\10\80100844.ogg":^  Pretty annoying."^\

_ld r,":b;sprites\bea\1\bea_a11_1_majime3star.png",80
advsetwindow "27"

langjp「その二人の潔白は、容易には証明できないだろう。@それにもはや、容疑者は少数に絞り込まれている。@ここからは、もしも誰々が犯人だったならと、個別に検証していくしかないだろうな。」\
;＜ベアト
langen:dwave 0, "voice\27\80700608.ogg":^"Proving innocence for either of them probably won't be easy.^@:dwave 0, "voice\27\80700609.ogg":^  At least we've gotten the suspects down to a small number.^@:dwave 0, "voice\27\80700610.ogg":^  From here on out, there's probably nothing left to do except check each one to see if they could have been a culprit."^\

cl c,0
_ld l,":b;sprites\but\1\but_d11_futeki3.png",24
advsetwindow "10"

langjp「そうだな。@いよいよ最後の詰めに入ってきたようだぜ！」\
;＜戦人
langen:dwave 0, "voice\10\80100845.ogg":^"You're right.^@:dwave 0, "voice\10\80100846.ogg":^  It feels like we're getting to the final stretch!"^\

bg black,22
bg new_different_space_1c,22
se1 57
mbg white,1
_ld r,":b;sprites\lam\1\lam_a11_akuwarai3.png",0
mcbg 22
advsetwindow "29"

langjp「いよいよ、推理も大詰めへ、って感じ……？」@
;＜ラムダ
langen:dwave 0, "voice\29\82200135.ogg":^"Looks like they've almost made it, doesn't it...?"^\

;se1 52
_ld l,":b;sprites\ber\1\ber_a21_warai4.png",22
advsetwindow "28"
;print 99,800,"breakup.dll/llp"
langjp「…………まな板の上の何とやらの心境よ。」\
;＜ベルン
langen:dwave 0, "voice\28\82100168.ogg":^"......I feel like a fish on the chopping board."^\

bg black,2
fede 0,1000
E_A

if %hinto_point = 14 : inc %hinto_point
goto *quest_mode



*hinto_16
mov %play_scene,80110 ;シーン変数の入力

mov %r_hyouji_side,0
mov %r_hyouji_cha,but
;■真里亞犯人説検証
mov %BUT_Isyou,2

bgm1 19

bg new_different_space_1a,22
_ld c,":b;sprites\but\1\but_d11_majime1.png",22
advsetwindow "10"

langjp「まず、真里亞犯人説から検証してみよう。@真里亞が犯人なら、楼座を死んだフリに出来る。@楼座には第一、第二の晩の殺人が実行可能。@そして、夏妃伯母さんの部屋に閉じ込められ、真里亞が第四の晩以降の殺人を引き継ぐことになる。」\
;＜戦人
langen:dwave 0, "voice\10\80100847.ogg":^"First, let's try checking theories with Maria as a culprit.^@:dwave 0, "voice\10\80100848.ogg":^  If she's guilty, then Rosa could've been playing dead.^@:dwave 0, "voice\10\80100849.ogg":^  She could've carried out the crimes on the first and second twilights.^@:dwave 0, "voice\10\80100850.ogg":^  Then, she gets locked in Aunt Natsuhi's room, and Maria does the rest of the murders."^\

_ld r,":b;sprites\bea\1\bea_a11_majime1.png",24
advsetwindow "27"

langjp「真里亞には、ゲストハウスでの全ての殺人が不可能だ。@よって、真里亞は紗音を殺すのが精一杯ということになるな。」\
;＜ベアト
langen:dwave 0, "voice\27\80700611.ogg":^"It was impossible for Maria to commit any of the murders in the guesthouse.^@:dwave 0, "voice\27\80700612.ogg":^  So, the most Maria could do was kill Shannon."^\

_ld c,":b;sprites\but\1\but_d11_komaru2.png",80
advsetwindow "10"

langjp「となると、ゲストハウスでの殺人のために３人目の犯人が必要になる。」@
;＜戦人
langen:dwave 0, "voice\10\80100851.ogg":^"Which means a third culprit would be needed for the guesthouse murders."^\

cl r,0
_ld l,":b;sprites\bea\1\bea_a11_majime2.png",24
advsetwindow "27"

langjp「３人目は、絵羽、秀吉、留弗夫、霧江の中の誰かということになるな。@そしてそれは、さらに４人目の犯人を必要としてしまうぞ？」\
;＜ベアト
langen:dwave 0, "voice\27\80700613.ogg":^"The third one would have to be Eva, Hideyoshi, Rudolf, or Kyrie.^@:dwave 0, "voice\27\80700614.ogg":^  That means we would need a fourth culprit too, correct?"^\

_ld c,":b;sprites\but\1\but_d11_nayamu4.png",80
advsetwindow "10"

langjp「……そうだな。@絵羽伯母さんたち４人の誰かが死んだフリをするためには、それを検死する子供も犯人でなくてはならない。@つまり、真里亞が犯人である時点で、犯人は４人にまで膨れ上がるわけだ。」\
;＜戦人
langen:dwave 0, "voice\10\80100852.ogg":^"...You're right.^@:dwave 0, "voice\10\80100853.ogg":^  In order for one of those four adults to play dead, the child who checked them would have to be a culprit too.^@:dwave 0, "voice\10\80100854.ogg":^  In other words, if Maria is a culprit, we'll need to have at least four culprits total."^\

bg black,24
bg new_different_space_1c,24
_ld c,":b;sprites\bea\1\bea_a11_majime2.png",24
advsetwindow "27"

langjp「４人が犯人であるためには、４人全員がそれぞれ、最低１人は殺していなくてはならない。」@
;＜ベアト
langen:dwave 0, "voice\27\80700615.ogg":^"If there are four culprits, then each one of them must kill at least one person."^\
advsetwindow "-1"
;br
langjp　犯人の定義とは、殺人犯であること。\
langen^The definition of `culprit' is `one who murders'.^\

_ld r,":b;sprites\but\1\but_d11_nayamu2.png",24
advsetwindow "10"

langjp「……だとするとだ。@……ちょいとおかしくなってくるんだよな。」\
;＜戦人
langen:dwave 0, "voice\10\80100855.ogg":^"...In which case,^@:dwave 0, "voice\10\80100856.ogg":^ ...things don't quite seem to add up."^\

_ld c,":b;sprites\bea\1\bea_a11_1_majime6.png",80
advsetwindow "27"

langjp「犯人４人の内訳は、大人２人、子供２人となる。@大人１人は第一、第二の晩の殺人を担当。@もう１人の大人は、ゲストハウスの殺人を担当する。@そう、ここで矛盾が生じるのだ。」\
;＜ベアト
langen:dwave 0, "voice\27\80700616.ogg":^"The four culprits would then be two adults and two children.^@:dwave 0, "voice\27\80700617.ogg":^  One adult is in charge of the murders on the first and second twilights.^@:dwave 0, "voice\27\80700618.ogg":^  The other adult handles the murders from the guesthouse onwards.^@:dwave 0, "voice\27\80700619.ogg":^  Yes, that creates a contradiction."^\

_ld r,":b;sprites\but\1\but_d11_majime2.png",80
advsetwindow "10"

langjp「犯人は殺人者であるという定義。@……これは即ち、犯人は絶対に、殺人をしなくてはならないという義務も意味する。」\
;＜戦人
langen:dwave 0, "voice\10\80100857.ogg":^"A culprit is defined as `one who murders'.^@:dwave 0, "voice\10\80100858.ogg":^  ...That means every culprit must commit murder at least once."^\

cl c,0
_ld l,":b;sprites\bea\1\bea_a11_fukigen1.png",24
advsetwindow "27"

langjp「実は、子供の犯人は、殺人可能な相手がほとんど存在しないのだ。@第一、第二の晩は、子供には犯行不能。@そしてゲストハウス以降も犯行不能。@唯一可能なのは、紗音殺しの第四の晩だけ。」\
;＜ベアト
langen:dwave 0, "voice\27\80700620.ogg":^"Simply put, there are very few people that a child culprit could murder.^@:dwave 0, "voice\27\80700621.ogg":^  The children could not have killed in the first and second twilights.^@:dwave 0, "voice\27\80700622.ogg":^  They also can't commit murder after the first deaths in the guesthouse take place.^@:dwave 0, "voice\27\80700623.ogg":^  The only one they can possibly commit is Shannon's murder on the fourth twilight."^\

_ld r,":b;sprites\but\1\but_d11_komaru3.png",80
advsetwindow "10"

langjp「……子供の犯人は紗音１人しか殺せない。@つまり、２人目の子供の犯人は、誰も殺せないから、犯人にはなれないんだ。@……子供の犯人は、２人以上存在できないってことになる。」\
;＜戦人
langen:dwave 0, "voice\10\80100859.ogg":^"...A child culprit can only kill Shannon.^@:dwave 0, "voice\10\80100860.ogg":^  A second child culprit couldn't kill anyone, so they couldn't be a culprit at all.^@:dwave 0, "voice\10\80100861.ogg":^  ...It means there can be only one child culprit."^\

cl l,0
_ld l,":b;sprites\bea\1\bea_a11_1_majime6.png",23
advsetwindow "27"

langjp「真里亞が犯人である時点で、楼座以外にもう１人大人が必要になる。@だが、その検死を偽れるもう１人の子供の犯人は、存在できないのだ。@……つまり、真里亞が犯人であることはありえない…！」\
;＜ベアト
langen:dwave 0, "voice\27\80700624.ogg":^"As soon as we pick Maria as a culprit, we need another adult culprit besides Rosa.^@:dwave 0, "voice\27\80700625.ogg":^  However, it's impossible for there to be a second child culprit to lie about their parent's death.^@:dwave 0, "voice\27\80700626.ogg":^  ...In other words, it's impossible for Maria to be a culprit...!"^\

bg black,2
fede 0,1000
E_A

