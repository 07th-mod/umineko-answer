					mov %tmp2,?r[%scenario_Number][%tmp][condition] : dec %tmp2 : mov ?r[%scenario_Number][%tmp][condition],%tmp2
				*rmenu_custom_btlp_190_ep5
			next
			seplay 9,1023
		*rmenu_custom_btlp_200_ep5

