*sp_check
	if %intro_prog_flg = off jumpf       ;スプライトプログラムが動いているかの確認

		mov %intro_prog_flg,off           ;スプライトプログラムのフラグをオフ
		layermessage 10,"clear/10"           ;スプライトプログラムのスプライト消去
		layermessage 10,"program_end/10"           ;スプライトプログラムのプログラム停止
		csp 10
	~
return




























*m_clear
return


*teatime_5


btndef ""
csp -1
;setwindow 84,36,31,20,26,26,0,2,20,1,1,#999999,0,0,960,540 ;utmeta-delete
windoweffect 50,200
beginADVSection
advsetwindow "-1"
textoff
E_A

mono 0
;E_A
mov %r_hyouji_side,1
mov %scenario_Number,5
mov %play_scene,50100

bg white,8
se2 17
bg new_Wsan_1a,10
wait 2000
bg black,23

bgm1 131

bg new_Wclo_1c,23

;■お茶会
se1 52
_ld c,":b;sprites\ber\1\ber_a21_def1.png",0
print 99,1000,"breakup.dll/llB"

langjp!sd/
langen!sd/
advsetwindow "28"
langjp「……ヱリカ、ドラノール。」\
;＜ベルン
langen:dwave 0, "voice\28\52100771.ogg":^"...Erika, Dlanor."^\

bg new_wclo_1a,23

_ld r,":b;sprites\eri\1\eri_a12_warai5.png",26
advsetwindow "46"

langjp「はい、我が主。」@
;＜ヱリカ
langen:dwave 0, "voice\46\54501274.ogg":^"Yes, my master."^\

se1 52
_ld l,":b;sprites\dla\1\dla_a11_def3.png",0
print 99,1000,"breakup.dll/lrp"
advsetwindow "47"

langjp「お呼びデスカ。」\
;＜ドラノール
langen:dwave 0, "voice\47\54600344.ogg":^"You CALLED?"^\

bg new_wclo_1b,0
;se1 52
_ld r,":b;sprites\ber\1\ber_a21_warai1.png",24
advsetwindow "28"

langjp「……あなたたちは、引き続きこのカケラに留まり、@残る第１から第４のゲーム全てを解明しなさい。@/
langen:dwave 0, "voice\28\52100772.ogg":^"...I want you two to stay in this Fragment ^@:dwave 0, "voice\28\52100773.ogg":^and explain everything in the remaining 1st through 4th games.^@/

_ld r,":b;sprites\ber\1\ber_a21_warai4.png",80
advsetwindow "28"

langjpもはや、魔女幻想を主張する哀れな仮初魔女は存在しない。@……剥き出しの真実を、徹底的に暴いてやりなさい。」\
;＜ベルン
langen:dwave 0, "voice\28\52100774.ogg":^  That pitiful transient witch who supports the Illusion of the Witch no longer exists herself.^@:dwave 0, "voice\28\52100775.ogg":^  Expose the naked truth thoroughly."^\

_ld l,":b;sprites\eri\1\eri_a11_warai5.png",23
advsetwindow "46"

langjp「くすくす！　お任せを、我が主ッ。@この古戸ヱリカに、解けぬ謎はありません。」@
;＜ヱリカ
langen:dwave 0, "voice\46\54501275.ogg":^"*giggle*!  Leave it to me, my master.^@:dwave 0, "voice\46\54501276.ogg":^  There is no riddle that I, Furudo Erika, cannot solve."^\

_ld r,":b;sprites\ber\1\ber_a21_warai1.png",80
