;ボタンに機能を持たせる
btndef ""
exbtn_d "P800P704,C705" ;背景用 ;背景用右クリックのため
;bbbb
;this was commented out for breaking stuff
;exbtn 800,800,"P800P705P704,C705" ;800は背景。そこにマウスが乗ったとき、ボタンをデフォに。
exbtn 704,704,"P705,C704S1,(sys_se\zyosys1.WAV)" ;透明ボタン
exbtn 788, 788,"S1,(sys_se\zyosys1.WAV)" ;透明ボタン
