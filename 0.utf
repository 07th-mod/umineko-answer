;**************************************************************
; 右クリック、Tipsボタンの表示
;**************************************************************
*r_tips_botann_ep5

	for %tmp2 = kin_btn_lsp to si_btn_lsp : csp %tmp2 :next
	for %tmp2 = tips1_lsp to tips1_lsp : csp %tmp2 :next

	csp r_tips_txt_lsp
	csp tips_next_lsp
	csp tips_back_lsp
	csp r_cha_back_lsp
	vsp r_hana_lsp,1

	;背景黒枠の表示
	lsp r_tips1_back_lsp,r_tips1_back,13,34,150

	;tipsの表示（tipsナンバーによって表示するtipsの数を変化

	notif %scenario_Number = 5 goto *r_tips_botann_ep5_postep5
	mov %tmp,13 : 	mov %tmp1,34

	;if ?tips[1][tips_flg] = 1 lsp tips1_lsp,r_tips_5_1,%tmp,%tmp1 : add %tmp1,36
	;if ?tips[2][tips_flg] = 1 lsp tips2_lsp,r_tips_5_2,%tmp,%tmp1 : add %tmp1,36
	;if ?tips[3][tips_flg] = 1 lsp tips3_lsp,r_tips_5_3,%tmp,%tmp1 : add %tmp1,36
	;if ?tips[4][tips_flg] = 1 lsp tips4_lsp,r_tips_5_4,%tmp,%tmp1 : add %tmp1,36

	notif ?tips[1][tips_flg] = 1 jumpf
		mov $witchh4, r_tips_5_1
		setRLangString $witchh4, "/2,0,3"
		lsp tips1_lsp,$witchh4,%tmp,%tmp1
		add %tmp1,36
	~
	notif ?tips[2][tips_flg] = 1 jumpf
		mov $witchh4, r_tips_5_2
		setRLangString $witchh4, "/2,0,3"
		lsp tips2_lsp,$witchh4,%tmp,%tmp1
		add %tmp1,36
	~
	notif ?tips[3][tips_flg] = 1 jumpf
		mov $witchh4, r_tips_5_3
		setRLangString $witchh4, "/2,0,3"
		lsp tips3_lsp,$witchh4,%tmp,%tmp1
		add %tmp1,36
	~
	notif ?tips[4][tips_flg] = 1 jumpf
		mov $witchh4, r_tips_5_4
		setRLangString $witchh4, "/2,0,3"
		lsp tips4_lsp,$witchh4,%tmp,%tmp1
		add %tmp1,36
	~
	*r_tips_botann_ep5_postep5

	notif %scenario_Number = 6 goto *r_tips_botann_ep5_postep6

	mov %tmp,13 : 	mov %tmp1,34
	;if ?tips[1][tips_flg] = 1 lsp tips1_lsp,r_tips_6_1,%tmp,%tmp1 : add %tmp1,36
	;if ?tips[2][tips_flg] = 1 lsp tips2_lsp,r_tips_6_2,%tmp,%tmp1 : add %tmp1,36

	notif ?tips[1][tips_flg] = 1 jumpf
		mov $witchh4, r_tips_6_1
		setRLangString $witchh4, "/2,0,3"
		lsp tips1_lsp,$witchh4,%tmp,%tmp1
		add %tmp1,36
	~
