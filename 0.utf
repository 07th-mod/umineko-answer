;＜真里亞
langen:dwave 0, "voice\13\80400082.ogg":^"Kihhihihihi, not now.^@:dwave 0, "voice\13\80400083.ogg":^  I'm the star, so I'll go after Mama!"^\

bg new_mhal_h1a,24
_ld r,":b;sprites\ros\1\ros_a13_warai1.png",24
advsetwindow "12"

langjp「そう？@　じゃあ、ママが先でいい？」@
;＜楼座
langen:dwave 0, "voice\12\81400025.ogg":^"Really?^@:dwave 0, "voice\12\81400026.ogg":^  You're sure it's okay for me to go first?"^\

_ld c,":b;sprites\mar\1\mar_a22_warai2.png",23
advsetwindow "13"

langjp「うー！」\
;＜真里亞
langen:dwave 0, "voice\13\80400084.ogg":^"Yeah!"^\

_ld r,":b;sprites\ros\1\ros_a12_warai2.png",80
advsetwindow "12"

langjp「じゃあ、私から出題するわね。@行くわよ？@　うふふふふふ。」\
;＜楼座
langen:dwave 0, "voice\12\81400027.ogg":^"Then let's begin.^@:dwave 0, "voice\12\81400028.ogg":^  Ready?^@:dwave 0, "voice\12\81400029.ogg":^  Heheheheheh."^\

bg black,22

gosub *quiz
;■楼座の出題
;　もうすぐ爆発する六軒島！@
;;　爆発まであと１時間しかない。@
;　楼座はインゴットの積まれている地下貴賓室まで３分で行ける。@
;　しかしインゴットは重いので、一度に１つしか持ち出せない。@
;　しかも、持って地上に戻るには５分がかかってしまう。@
; Rokkenjima is about to explode!
; There's only 1 hour left until the explosion.
; Rosa can make it to the stack of ingots in the underground VIP room in 3 minutes.
; However, the ingots are heavy, so she can only carry 1 out at a time.
; Furthermore, it takes her 5 minutes to carry it up to the surface.

;　地上よりスタートして地下貴賓室との往復をくり返し、
;　楼座は地下貴賓室より、何個のインゴットを持ち出せるだろう…？@
; She starts at the surface and goes back and forth between the surface and the underground VIP room.
;So, how many ingots can Rosa carry out of the underground VIP room...?

;選択肢は５つ。@「４個」「５個」」「６個」「７個」「８個」
; A. "4 ingots" B. "5 ingots" C. "6 ingots" D. "7 ingots" E. "8 ingots" 
;■選択後、以下に進む



;■ヒント
*eva_hinto_9
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2

bg new_mhal_h1a,22
_ld l,":b;sprites\eva\1\eva_a11_def1.png",22
advsetwindow "05"

langjp「んーー……、この問題はノーヒントでもいいかしら。」@
;＜絵羽
langen:dwave 0, "voice\05\81000369.ogg":^"Hmmmm... I guess you don't need a hint for this one."^\

_ld r,":b;sprites\ros\1\ros_a13_def1.png",24
advsetwindow "12"

langjp「くす、そうね。@縁寿ちゃん用の問題だもの。@姉さんにはちょっとやさしいわ。」\
;＜楼座
langen:dwave 0, "voice\12\81400030.ogg":^"*giggle*  You're right.^@:dwave 0, "voice\12\81400031.ogg":^  I made it for Ange-chan.^@:dwave 0, "voice\12\81400032.ogg":^  It's probably a bit too easy for you, Nee-san."^\

ut_mld c,":b;sprites\en2\1\en2_a15_def3b.png",23
advsetwindow "11"

langjp「１時間は６０分だから、一往復に８分……。」@
;＜縁寿
langen:dwave 0, "voice\11\82000662.ogg":^"An hour is 60 minutes, and it takes 8 minutes for each round trip..."^\

_ld l,":b;sprites\eva\1\eva_a11_hohoemi1.png",80
advsetwindow "05"

langjp「がんばって。@縁寿ちゃんなら解けるわよ。@この問題は、伯母さんからはノーヒントね。」\
;＜絵羽
langen:dwave 0, "voice\05\81000370.ogg":^"Good luck.^@:dwave 0, "voice\05\81000371.ogg":^  I know you can solve it.^@:dwave 0, "voice\05\81000372.ogg":^  I won't give you a hint this time."^\

mcl c,0
bg black,22

return

;■不正解の場合（「８個」以外）
*ROS_hazure
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2

bg new_mhal_h1a,22
ut_mld c,":b;sprites\en2\1\en2_a15_def2b.png",22
advsetwindow "11"

langjp「え？@　どうして違うの…？！」\
;＜縁寿
langen:dwave 0, "voice\11\82000663.ogg":^"Huh?^@:dwave 0, "voice\11\82000664.ogg":^  Why is that wrong...?!"^\

_ld l,":b;sprites\ros\1\ros_a11_warai2.png",23
advsetwindow "12"

langjp「うふふ、ごめんね。@ちょっといやらしい問題だったかしら。」@
;＜楼座
langen:dwave 0, "voice\12\81400033.ogg":^"Heheh, sorry about that.^@:dwave 0, "voice\12\81400034.ogg":^  I guess that was a little mean."^\

_ld r,":b;sprites\eva\1\eva_a11_hohoemi1.png",24
advsetwindow "05"

