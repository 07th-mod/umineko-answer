;★合流地点
*RUD_quiz
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2
;■留弗夫の出題
goto *quiz
;　今度は、美代子、沙都子、梨花の３人に覆面を被ってもらいます。@
;　３人の誰が誰か、わかりません。@
;　声もわからないように、紙に書いてもらいます。@
;右側の子「真ん中の子は美代子です。」@
;真ん中の子「左側の子は美代子です。」@
;左側の子「右側の子は沙都子です。」@
; This time, Miyoko, Satoko, and Rika are all wearing masks.
; None of them know who is who.
; We'll have them write on paper, so no one can recognize the voices of the others.
; Girl on the right: "The girl in the middle is Miyoko."
; Girl in the middle: "The girl on the left is Miyoko."
; Girl on the left: "The girl on the right is Satoko."

;　この中で美代子は、本当のことを言っています。@
;　しかし、沙都子と梨花は、必ず嘘を吐くとは限りません。@
;　さて、この３人はそれぞれ、左から順に誰…？@
; Of these three, Miyoko is telling the truth.
; However, Satoko and Rika aren't necessarily lying.
; So, who are the three girls, from left to right...?

;選択肢６つ。@「梨花・沙都子・美代子」「梨花・美代子・沙都子」「沙都子・梨花・美代子」「沙都子・美代子・梨花」「美代子・梨花・沙都子」「美代子・沙都子・梨花」
; A. "Rika Satoko Miyoko" B. "Rika Miyoko Satoko" C. "Satoko Rika Miyoko" D. "Satoko Miyoko Rika"
; E. "Miyoko Rika Satoko" F. "Miyoko Satoko Rika" 
;■選択後、以下に進む



;■ヒント
*eva_hinto_12
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2

bg new_mhal_h1a,23
_ld c,":b;sprites\en2\1\en2_a15_def3a.png",23
advsetwindow "11"

langjp「覆面被ってて、美代子以外は、嘘か本当かもわからない。@……これ、難しい。」\
;＜縁寿
langen:dwave 0, "voice\11\82000707.ogg":^"They're all wearing masks, ...and except for Miyoko, we can't tell if they're lying or telling the truth.^@:dwave 0, "voice\11\82000708.ogg":^  ...This one's hard."^\

_ld r,":b;sprites\eva\1\eva_a11_def1.png",24
advsetwindow "05"

langjp「そんなことないわ。@伯母さんはもうわかっちゃったけど。@さっきのお母さんの問題より、これもっと簡単よ？」@
;＜絵羽
langen:dwave 0, "voice\05\81000425.ogg":^"No, it isn't.^@:dwave 0, "voice\05\81000426.ogg":^  I've already figured it out.^@:dwave 0, "voice\05\81000427.ogg":^  This is even easier than the one your mom gave a second ago."^\

_ld c,":b;sprites\en2\1\en2_a15_def2a.png",80
advsetwindow "11"

langjp「どうして？」\
;＜縁寿
langen:dwave 0, "voice\11\82000709.ogg":^"Why?"^\

_ld r,":b;sprites\eva\1\eva_a11_hohoemi1.png",80
advsetwindow "05"

langjp「美代子以外の二人は何を言ってるか信用できないから、まずは誰が美代子かを特定しないと。@美代子は絶対に嘘を吐かないんでしょう？」@
;＜絵羽
langen:dwave 0, "voice\05\81000428.ogg":^"You can't trust the two who aren't Miyoko, so you first need to figure out who Miyoko is.^@:dwave 0, "voice\05\81000429.ogg":^  Miyoko doesn't lie, right?"^\

_ld c,":b;sprites\en2\1\en2_a11_def2.png",80
advsetwindow "11"

langjp「うん。@美代子は嘘を吐かない。」\
;＜縁寿
langen:dwave 0, "voice\11\82000710.ogg":^"Yeah.^@:dwave 0, "voice\11\82000711.ogg":^  Miyoko doesn't lie."^\

_ld r,":b;sprites\eva\1\eva_a11_warai1.png",80
advsetwindow "05"

langjp「じゃあ、まずは誰が美代子なのかということに絞って、もう一度問題を読み直して見て？@　きっとすぐに閃くはずよ。」@
;＜絵羽
langen:dwave 0, "voice\05\81000430.ogg":^"So, start off by figuring out who Miyoko is, then read through the puzzle again.^@:dwave 0, "voice\05\81000431.ogg":^  I'm sure you'll see it at once."^\

_ld c,":b;sprites\en2\1\en2_a11_def1.png",80
advsetwindow "11"

langjp「誰が美代子かだけを考えるんだね。@うん、わかったっ。」\
;＜縁寿
langen:dwave 0, "voice\11\82000712.ogg":^"Just think about who Miyoko is...^@:dwave 0, "voice\11\82000713.ogg":^  Okay, I've got it."^\

bg black,24
bg new_mhal_h1c,0
_ld r,":b;sprites\kir\1\kir_a11_warai1.png",24
advsetwindow "09"

langjp「絵羽姉さんの言うことは素直に聞くのね。」@
;＜霧江
langen:dwave 0, "voice\09\81300056.ogg":^"You really do whatever Eva nee-san tells you."^\

_ld l,":b;sprites\en2\1\en2_a11_def1d.png",23
advsetwindow "11"

langjp「うん。@伯母さん、やさしくて頭良くて大好きっ。@だから言うこと聞くのっ。」\
;＜縁寿
langen:dwave 0, "voice\11\82000714.ogg":^"Yeah.^@:dwave 0, "voice\11\82000715.ogg":^  Aunt Eva is nice and smart, and I like her.^@:dwave 0, "voice\11\82000716.ogg":^  So I do what she tells me!"^\

_ld c,":b;sprites\rud\1\rud_a11_akuwarai1.png",24
advsetwindow "08"

langjp「今度からナスやピーマンを食わす時は、姉貴に手伝ってもらわねぇとな？」@
;＜留弗夫
langen:dwave 0, "voice\08\81200055.ogg":^"Next time we try to feed Ange eggplant and bell peppers, we'll need to ask her to lend a hand."^\

_ld r,":b;sprites\kir\1\kir_a11_warai2.png",80
advsetwindow "09"

langjp「くすくすくすくす……。」\
;＜霧江
langen:dwave 0, "voice\09\81300057.ogg":^"*giggle*giggle*..."^\

bg black,22

return



*RUD_hazure
;■不正解の場合（「美代子・梨花・沙都子」以外）
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2

bg new_mhal_h1a,22
_ld c,":b;sprites\rud\1\rud_a11_def1.png",22
_ld c,":b;sprites\rud\1\rud_a11_warai2.png",80
advsetwindow "08"

langjp「ザーンネン！！@　ハズレだ。」\
;＜留弗夫
langen:dwave 0, "voice\08\81200056.ogg":^"Toooo bad!!^@:dwave 0, "voice\08\81200057.ogg":^  That's wrong."^\

bg new_mhal_h1c,23
_ld l,":b;sprites\en2\1\en2_a15_def2b.png",23
advsetwindow "11"

langjp「えー？！@　縁寿間違えた？　間違えた？！」@
;＜縁寿
langen:dwave 0, "voice\11\82000717.ogg":^"Huh?!^@:dwave 0, "voice\11\82000718.ogg":^  I got it wrong?  I got it wrong?!"^\

_ld c,":b;sprites\kir\1\kir_a11_warai1.png",24
advsetwindow "09"

langjp「後で、絵羽伯母さんと一緒に整理してごらんなさい。@すぐにわかるはずよ。」\
;＜霧江
langen:dwave 0, "voice\09\81300058.ogg":^"Later on, try thinking it over with Aunt Eva.^@:dwave 0, "voice\09\81300059.ogg":^  I'm sure you'll figure it out soon."^\

_ld r,":b;sprites\eva\1\eva_a11_def1.png",23
advsetwindow "05"

langjp「考えてみて？@　美代子は本当のことを言うんでしょ？@　だとしたら、隣の人は美代子です、なんて言う人が美代子のことなんて、ありえると思う？」\
;＜絵羽
langen:dwave 0, "voice\05\81000432.ogg":^"Think about it.^@:dwave 0, "voice\05\81000433.ogg":^  Miyoko speaks the truth, right?^@:dwave 0, "voice\05\81000434.ogg":^  So, is it possible for someone to be Miyoko if they say the person next to them is Miyoko?"^\

bg black,22
advsetwindow "-1"

langjp　美代子は本当のことを言う。@
langjp　なら、自分が美代子だと言うはず。@他所の人が美代子だ、などと美代子が言うわけがない。@
langjp　……それに気付けば、美代子を簡単に特定できたかもしれない。@
langen^Miyoko speaks the truth.^@
advsetwindow "-1"
langen^So, she should say that she is Miyoko.^@^  She wouldn't say that someone else was Miyoko.^\
advsetwindow "-1"
langen^...Once you realize that, it's probably easy to figure out who Miyoko is.^@
advsetwindow "-1"
;br
langjp　今頃になってコツを掴めた。@ちょっぴり残念…。\
langen^I've figured out the knack of it, but too late.^@^  Too bad...^\

;★合流地点へ
goto *KIRRUD_quizend



;■正解の場合（「美代子・梨花・沙都子」）
*RUD_atari
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2

bg new_mhal_h1a,22
_ld c,":b;sprites\en2\1\en2_a13_def2.png",22
advsetwindow "11"

langjp「美代子はわかった。@左の子が美代子。@だって、右側と真ん中の子は、他の人が美代子だって言ってる。@自分が美代子だったら、他の人が美代子だなんて嘘は吐かない。」\
;＜縁寿
langen:dwave 0, "voice\11\82000719.ogg":^"I know who Miyoko is.^@:dwave 0, "voice\11\82000720.ogg":^  She's on the left.^@:dwave 0, "voice\11\82000721.ogg":^  After all, the girls in the middle and on the right both say that someone else is Miyoko. ^@:dwave 0, "voice\11\82000722.ogg":^If they were Miyoko, they couldn't lie and say that someone else was Miyoko."^\

_ld l,":b;sprites\eva\1\eva_a11_hohoemi1.png",23
advsetwindow "05"

langjp「その通り。@美代子は正直者のはず。@だから、他人が美代子だ、なんて言う時点で、その子は美代子じゃないってわかるわけ。」\
;＜絵羽
langen:dwave 0, "voice\05\81000435.ogg":^"That's right.^@:dwave 0, "voice\05\81000436.ogg":^  Miyoko is supposed to be honest.^@:dwave 0, "voice\05\81000437.ogg":^  So, once someone says that someone else is Miyoko, they can't be her."^\

_ld c,":b;sprites\en2\1\en2_a13_def1.png",80
advsetwindow "11"

langjp「そうなると、右側と真ん中の子は美代子じゃないから、左側の子が自動的に美代子になる。@そして美代子は本当のことを言ってるんだから、右の子が沙都子というのも本当になる。」\
;＜縁寿
langen:dwave 0, "voice\11\82000723.ogg":^"So, since the middle one and the right one aren't Miyoko, the left one automatically is.^@:dwave 0, "voice\11\82000724.ogg":^  And since Miyoko speaks the truth, then it's also true that the kid on the right is Satoko."^\

_ld l,":b;sprites\eva\1\eva_a11_warai1.png",80
advsetwindow "05"

langjp「となれば、残る真ん中の子は、梨花ってことになるわね。@素晴らしいわ、満点よ！」@
;＜絵羽
langen:dwave 0, "voice\05\81000438.ogg":^"Which means that the only kid left, the one in the middle, is Rika.^@:dwave 0, "voice\05\81000439.ogg":^  Perfect!"^\

_ld r,":b;sprites\rud\1\rud_a11_def2.png",24
advsetwindow "08"

langjp「ケロっと解かれちまったな！@/
langen:dwave 0, "voice\08\81200058.ogg":^"You solved it like it was nothing!^@/

_ld r,":b;sprites\rud\1\rud_a11_warai1.png",80
advsetwindow "08"

langjp　縁寿、お前は母さんに似て本当に賢いぞ！」@
;＜留弗夫
langen:dwave 0, "voice\08\81200059.ogg":^  Ange, you really are smart like your Mom!"^\

;br/

se1 48
quakex 1,400

_ld c,":b;sprites\en2\1\en2_a11_def1.png",80
advsetwindow "-1"

langjp　お父さんは頬擦りをしながら抱き締めてくれた。\
langen^Dad rubbed my cheek and hugged me.^\

bg black,22

