;＜蔵臼
langen:dwave 0, "voice\02\80800107.ogg":^"As an outsider, I hate to barge into this conversation, ...but we seem to have no options left."^\

_ld c,":b;sprites\nat\1\nat_a12_tukare1.png",23
advsetwindow "03"

