;■正解の場合（「８個」）
*ROS_atari
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2

bg new_mhal_h1a,22
ut_mld c,":b;sprites\en2\1\en2_a13_def1c.png",22
advsetwindow "11"

langjp「８個…！」@
;＜縁寿
langen:dwave 0, "voice\11\82000665.ogg":^"8 ingots...!"^\

_ld l,":b;sprites\ros\1\ros_a11_warai1.png",23
advsetwindow "12"

langjp「うふふ、それでいいの？@　黄金を地上に運ぶには、一往復８分かかるのよ？@　８×８じゃ、６０分をはみ出しちゃうわよ。」\
;＜楼座
langen:dwave 0, "voice\12\81400038.ogg":^"Heheh, are you sure?^@:dwave 0, "voice\12\81400039.ogg":^  It takes eight minutes to carry each ingot to the surface, right?^@:dwave 0, "voice\12\81400040.ogg":^  8x8 is more than 60."^\

ut_mld c,":b;sprites\en2\1\en2_a11_def1.png",80
advsetwindow "11"

langjp「うん。@だって、何個持ち出したか、が問題だもん。@インゴットの部屋から一歩でも出れば、“持ち出した”ことになる。」@
;＜縁寿
langen:dwave 0, "voice\11\82000666.ogg":^"That's right.^@:dwave 0, "voice\11\82000667.ogg":^  But the question was `How many can she carry out of the room?'^@:dwave 0, "voice\11\82000668.ogg":^  Rosa only has to take one step out of the room to `carry it out'."^\

_ld r,":b;sprites\eva\1\eva_a11_warai1.png",24
advsetwindow "05"

langjp「さすが、縁寿ちゃん…！@　たくさんの問題ですっかり鍛えられちゃったわ。」\
;＜絵羽
langen:dwave 0, "voice\05\81000374.ogg":^"Nice going, Ange-chan...!^@:dwave 0, "voice\05\81000375.ogg":^  All those puzzles have really warmed you up good."^\

_ld l,":b;sprites\ros\1\ros_a11_def1.png",80
advsetwindow "12"

langjp「そういうこと。@７往復すると８×７で５６分。@あと４分しかない。@でも３分あればまた地下貴賓室に戻って、最後の１分で８個目のインゴットを“持ち出せる”。」\
;＜楼座
langen:dwave 0, "voice\12\81400041.ogg":^"That's right.^@:dwave 0, "voice\12\81400042.ogg":^  To do 7 trips, you need 8X7=56 minutes.^@:dwave 0, "voice\12\81400043.ogg":^  There are only 4 minutes left.^@:dwave 0, "voice\12\81400044.ogg":^  However, you can make it back to the underground room in 3 minutes, then `carry out' the eighth ingot in the last minute."^\

mcl c,0
bg new_mhal_h1c,24
_ld r,":b;sprites\mar\1\mar_a11_akuwarai1.png",24
advsetwindow "13"

langjp「きひひひひひひ…。@/
langen:dwave 0, "voice\13\80400085.ogg":^"Kihihihihihihi...^@/

_ld r,":b;sprites\mar\1\mar_a22_warai2.png",80
advsetwindow "13"

langjp縁寿もやるね！@　すごいよ、うー。」@
;＜真里亞
langen:dwave 0, "voice\13\80400086.ogg":^  Not bad, Ange!^@:dwave 0, "voice\13\80400087.ogg":^  Nice one, uu-."^\

_ld l,":b;sprites\en2\1\en2_a11_def1b.png",23
advsetwindow "11"

langjp「真里亞お姉ちゃんには負けないもんっ。」\
;＜縁寿
langen:dwave 0, "voice\11\82000669.ogg":^"I'm not gonna lose to you, Maria onee-chan!"^\

ut_mld c,":b;sprites\ros\1\ros_a13_warai2.png",24
advsetwindow "12"

langjp「おめでとう。@これが私のメダルよ。@じゃあ、次は真里亞のとっておきの問題に挑戦してあげて。」\
;＜楼座
langen:dwave 0, "voice\12\81400045.ogg":^"Congratulations.^@:dwave 0, "voice\12\81400046.ogg":^  Here's my medal.^@:dwave 0, "voice\12\81400047.ogg":^  Now you can try the puzzle Maria picked out just for you."^\

mcl c,0
bg black,22

