;＜ウィル
langen:dwave 0, "voice\54\75400592.ogg":^"About what time of the year did this happen?"^\

_ld l,":b;sprites\mar\1\mar_b11_fukigen2.png",80
advsetwindow "13"

langjp「詳しく覚えてない。@でも、ミルクティーがアイスだったことは覚えてる。@……それが何？」\
;＜真里亞
langen:dwave 0, "voice\13\70400175.ogg":^"I'm not too sure.^@:dwave 0, "voice\13\70400176.ogg":^  But I remember that the milk tea had ice in it.^@:dwave 0, "voice\13\70400177.ogg":^  ...Why does that matter?"^\

_ld r,":b;sprites\wil\1\wil_a11_def1.png",80
advsetwindow "54"

