;＜八城
langen:dwave 0, "voice\56\84900076.ogg":^"`Knowing' and `not knowing'.^@:dwave 0, "voice\56\84900077.ogg":^  These two things have a one-way relationship."^\
advsetwindow "28"

;ld c,BER_DefA1,80

