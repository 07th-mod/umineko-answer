		if %tips_page = 2 mov $r_tips_txt_path,"bmp\r_click\text\tips\ep6\2_2.png"
		if %tips_page = 3 mov $r_tips_txt_path,"bmp\r_click\text\tips\ep6\2_3.png"
	*tips_ep6_side2_3

	*tips_ep7_side2
	;ＥＰ７　ＴＩＰＳ
	notif %scenario_Number = 7 goto *tips_ep8_side2
	notif %r_hyouji_tips = 1 goto *tips_ep7_side2_2
