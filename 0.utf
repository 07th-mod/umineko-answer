;＜朱志香
langen:dwave 0, "voice\04\80200111.ogg":^"Since the two master keys that exist are here inside the guesthouse,^@:dwave 0, "voice\04\80200112.ogg":^ ...that makes this guesthouse a perfect closed room...!"^\

_ld c,":b;sprites\mar\1\mar_a11_akuwarai2.png",24
