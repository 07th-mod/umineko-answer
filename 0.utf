;＜真里亞
langen:dwave 0, "voice\13\80400192.ogg":^"Kihihi, thanks.^@:dwave 0, "voice\13\80400193.ogg":^  #cc99ffGeorge onii-chan couldn't kill an adult.^@:dwave 0, "voice\13\80400194.ogg":^  He could kill a kid though.#ffffff^@:dwave 0, "voice\13\80400195.ogg":^  Kihihihihihi."^\

_ld c,":b;sprites\but\1\but_b11_naku2.png",24
