advsetwindow "53"

langjp「理御です。@理科の理に、御するの御でリオンと読みます。@……珍しい名前でしょう。」@
;＜理御
langen:dwave 0, "voice\53\75300635.ogg":^"Lion.^@:dwave 0, "voice\53\75300636.ogg":^  Written as `理御', but pronounced `Lee-on'.^@:dwave 0, "voice\53\75300637.ogg":^  ...Pretty strange name, don't you think?"^\

_ld r,":b;sprites\enj\1\enj_a13_nayamu1.png",80
advsetwindow "11"

langjp「……名前の珍しさなら、私も負けないわ。@でも、ごめんなさい。@私はあんたを知らないわ。」\
;＜縁寿
langen:dwave 0, "voice\11\72000007.ogg":^"...No stranger than mine.^@:dwave 0, "voice\11\72000008.ogg":^  But I'll have to apologize.^@:dwave 0, "voice\11\72000009.ogg":^  I don't know who you are."^\


_ld c,":b;sprites\rio\1\rio_a11_akire2.png",80
advsetwindow "53"

langjp「道理でしょうね。@私もあなたを知りませんから。」@
;＜理御
langen:dwave 0, "voice\53\75300638.ogg":^"That's hardly surprising, ^@:dwave 0, "voice\53\75300639.ogg":^since I don't know you either."^\

_ld r,":b;sprites\enj\1\enj_a11_majime1.png",80
advsetwindow "11"

langjp「そうじゃなくて。@あんた誰？@　右代宮家にあんたなんかいないわ。」\
;＜縁寿
langen:dwave 0, "voice\11\72000010.ogg":^"That's not what I meant.^@:dwave 0, "voice\11\72000011.ogg":^  Who are you?^@:dwave 0, "voice\11\72000012.ogg":^  There's no one like you in the Ushiromiya family."^\


_ld c,":b;sprites\rio\1\rio_a11_akire1.png",80
advsetwindow "53"

langjp「どうして、そう決め付けられるんです？@　あなたは当家と何か関わりが？」@
;＜理御
langen:dwave 0, "voice\53\75300640.ogg":^"And why are you so sure?^@:dwave 0, "voice\53\75300641.ogg":^  Do you have something to do with my family?"^\

