*hinto_18
mov %play_scene,80110 ;シーン変数の入力

mov %r_hyouji_side,0
mov %r_hyouji_cha,but
;■譲治の紫発言
mov %BUT_Isyou,2

bgm1 124

bg new_different_space_1a,22
_ld l,":b;sprites\bea\1\bea_a11_1_majime6.png",22
advsetwindow "27"

langjp「譲治がシロであることが確定すると、@自動的に真里亞もシロということになる。」\
;＜ベアト
langen:dwave 0, "voice\27\80700632.ogg":^"Once we're sure that George is innocent,^@:dwave 0, "voice\27\80700633.ogg":^ that automatically makes Maria innocent too."^\

_ld r,":b;sprites\but\1\but_d11_oya1.png",24
advsetwindow "10"

langjp「あぁ。@譲治の兄貴の紫発言“真里亞には誰も殺せない”が有効になるからな。@誰も殺せない以上、犯人にはなれない。@よって、真里亞のシロも確定する。」\
;＜戦人
langen:dwave 0, "voice\10\80100870.ogg":^"Yeah.^@:dwave 0, "voice\10\80100871.ogg":^  It confirms George-aniki's purple statement saying `Maria couldn't kill anyone'.^@:dwave 0, "voice\10\80100872.ogg":^  Since she couldn't kill anyone, she can't be a culprit.^@:dwave 0, "voice\10\80100873.ogg":^  So, Maria is also confirmed innocent."^\

_ld l,":b;sprites\bea\1\bea_a11_majime1.png",80
advsetwindow "27"

langjp「譲治と真里亞がシロである事実は、@自動的にその親の検死も間違いないことを示す。」\
;＜ベアト
langen:dwave 0, "voice\27\80700634.ogg":^"Since George and Maria are innocent,^@:dwave 0, "voice\27\80700635.ogg":^ that also proves that their examinations of their parents' deaths were trustworthy."^\

_ld r,":b;sprites\but\1\but_d11_komaru3.png",80
advsetwindow "10"

langjp「そういうことだ。@検死は誰も誤らない。@そして犯人でない人間はウソをつけない。@よって、二人が検死した大人の死亡は確定し、彼らもまたシロとなる。」\
;＜戦人
langen:dwave 0, "voice\10\80100874.ogg":^"That's right.^@:dwave 0, "voice\10\80100875.ogg":^  No one will mistakenly confirm a death,^@:dwave 0, "voice\10\80100876.ogg":^ and people who aren't culprits can't lie.^@:dwave 0, "voice\10\80100877.ogg":^  So, the deaths of their parents have been confirmed, and those parents are also innocent."^\


_ld l,":b;sprites\bea\1\bea_a11_akuwarai1.png",80
advsetwindow "27"

langjp「もう、ほとんど絞り込まれたな……。@……答えは、もはや明白ではないか…？」\
;＜ベアト
langen:dwave 0, "voice\27\80700636.ogg":^"We've gotten rid of almost everyone...^@:dwave 0, "voice\27\80700637.ogg":^  ...The answer is already clear, is it not...?"^\

_ld r,":b;sprites\but\1\but_d11_futeki1.png",80

bg black,2

fede 0,1000
E_A

