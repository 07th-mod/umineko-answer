advsetwindow "15"

langjp「…………そうだね。」\
;＜紗音
langen:dwave 0, "voice\15\80500073.ogg":^"......Good point."^\

bg new_m1f_p1cr,24
advsetwindow "16"
;ld c,KAN_fumanA1,24

langjp「姉さんは、心残りはないのかい。@………譲治さまのこととか。」@
;＜嘉音
langen:dwave 0, "voice\16\80600053.ogg":^"Don't you have any regrets, Nee-san?^@:dwave 0, "voice\16\80600054.ogg":^  ...About George-sama, for instance?"^\
advsetwindow "15"

;ld l,SHA_fumanA1,23

langjp「…………………………。」\
;＜紗音
langen:dwave 0, "voice\15\80500074.ogg":^"........."^\
advsetwindow "16"

;ld c,KAN_majimeA1,80

langjp「姉さんは譲治さまに、指輪をもらうまでしか出来ない。@…結婚も、添い遂げることも、何も。」\
;＜嘉音
langen:dwave 0, "voice\16\80600055.ogg":^"Receiving that ring is all you can do for George-sama.^@:dwave 0, "voice\16\80600056.ogg":^  As for marriage, living together, and all the rest..."^\
advsetwindow "15"

langjp「それが叶うのが、猫箱の中の、私たちの未来じゃない。@……それは私だけじゃないよ。@嘉音くんだってそう。@朱志香お嬢様と嘉音くんの未来とか、ね。」@
;＜紗音
langen:dwave 0, "voice\15\80500075.ogg":^"Our future inside the cat box is what will make all that come true, isn't it?^@:dwave 0, "voice\15\80500076.ogg":^  ...I'm not the only one.^@:dwave 0, "voice\15\80500077.ogg":^  It's the same for you, right?^@:dwave 0, "voice\15\80500078.ogg":^  What about a future for you and Milady Jessica?"^\
advsetwindow "16"

;ld c,KAN_fumanA2,80

langjp「………僕は……。」\
;＜嘉音
langen:dwave 0, "voice\16\80600057.ogg":^"...I'm..."^\

;bg white,29

bg black,22

bg new_sea_1cf,22
advsetwindow "15"

;ld l,SHA_MajimeA3,80

langjp「私が譲治さまとの婚約を破棄して、島を出て行っていなくなる未来だって、ありえるんだよ。@その世界では、嘉音くんはもう、私のことなんか何も気兼ねしなくていい。@………お嬢様と、青春を謳歌することが出来るんだよ。」\
;＜紗音
langen:dwave 0, "voice\15\80500079.ogg":^"I could break off my engagement with George-sama, then leave the island and disappear.^@:dwave 0, "voice\15\80500080.ogg":^  That future is also possible for me.^@:dwave 0, "voice\15\80500081.ogg":^  In that world, you wouldn't have to hesitate for my sake.  ...You could enjoy your youth to the fullest with Milady."^\

bg black,22
bg new_ment_1br,0
_ld l,":b;sprites\kan\1\kan_a11_komaru1.png",22
advsetwindow "16"

langjp「……姉さんが譲治さまとの婚約を諦められるなら、そういう世界もあるかもね。」\
;＜嘉音
langen:dwave 0, "voice\16\80600058.ogg":^"...If you gave up on your engagement with George-sama, that sort of world might be possible."^\

;bg Different_space_2d,22

_ld c,":b;sprites\sha\1\sha_a11_warai2.png",24
advsetwindow "15"

langjp「だから。@……私が譲治さまと結ばれる世界と。@あなたがお嬢様と結ばれる世界が、同時に存在できるのが、猫箱の中じゃない。」@
;＜紗音
langen:dwave 0, "voice\15\80500082.ogg":^"So,^@:dwave 0, "voice\15\80500083.ogg":^ ...since it's a cat box, ^@:dwave 0, "voice\15\80500084.ogg":^the world where I spend my life with George-sama and the world where you spend your life with Milady can both exist at the same time."^\

_ld l,":b;sprites\kan\1\kan_a11_def2.png",80
advsetwindow "16"

langjp「………どんな矛盾した夢も、全てが同時に存在できる世界。」\
;＜嘉音
langen:dwave 0, "voice\16\80600059.ogg":^"...It's a world where any contradicting dreams can exist at once."^\

_ld c,":b;sprites\sha\1\sha_a11_warai1.png",80
advsetwindow "15"

langjp「それが、私たちという駒がしまわれる世界なの。@……だから、寂しくなんかないし、悲しくもない。@……今ここにいる私は、譲治さまに指輪をもらうところまでしか、観測できないけれど。」\
;＜紗音
langen:dwave 0, "voice\15\80500085.ogg":^"That's the world we'll be put away in as pieces.^@:dwave 0, "voice\15\80500086.ogg":^  ...So, there's no need to be lonely, no need to be sad.^@:dwave 0, "voice\15\80500087.ogg":^  ...Even though the `me' here right now can only observe the part where I accept George-sama's ring."^\

bg black,22
bg new_book1,22
advsetwindow "-1"

langjp　猫箱の中の、私には観測できない世界にいる私は、@その後の、幸せな未来をきっと紡いでいるんだよ…。@
langen^The other `me' who lives in the cat box, in a world I cannot witness,^@^ will surely build a happy life in the future...^@
advsetwindow "-1"
;br
langjp　猫箱は、どんな駒も玩具も夢もしまえる、不思議な箱なの。\
langen^The cat box is such a strange thing, a place where any pieces and toys and dreams can be kept.^\
advsetwindow "-1"

langjp　それは、私たちを閉じ込める檻なんかじゃない。@
langen^It's no cage sealing us in.^@
advsetwindow "-1"
;br
langjp　むしろ、猫箱の中こそが、全てから解放される、無限の世界なんだよ……。\
langen^On the contrary, being inside the cat box means being free from everything in countless worlds...^\

bg black,22
bg new_m1f_p1dr,0
_ld l,":b;sprites\kan\1\kan_a11_fuman1.png",22
advsetwindow "16"

langjp「全てから解放され、全てが同時に叶う世界。@……でも、その世界の僕は、今ここにいる僕じゃない。@……それが何だか、悔しくて。」\
;＜嘉音
langen:dwave 0, "voice\16\80600060.ogg":^"A world where we're freed from everything, and yet where all of our wishes come true.^@:dwave 0, "voice\16\80600061.ogg":^  ...However, the `me' in that world won't be the `me' here and now.^@:dwave 0, "voice\16\80600062.ogg":^  ...That's a bit depressing."^\

_ld r,":b;sprites\sha\1\sha_a11_def1.png",22
advsetwindow "15"

langjp「………ね、嘉音くん。」@
;＜紗音
langen:dwave 0, "voice\15\80500088.ogg":^"...Hey, Kanon-kun."^\

_ld l,":b;sprites\kan\1\kan_a11_komaru1.png",80
advsetwindow "16"

langjp「何……？」\
;＜嘉音
langen:dwave 0, "voice\16\80600063.ogg":^"Yes...?"^\

_ld r,":b;sprites\sha\1\sha_a11_tokui1.png",80
advsetwindow "15"

langjp「しよっか。」@
;＜紗音
langen:dwave 0, "voice\15\80500089.ogg":^"Let's do it."^\

_ld l,":b;sprites\kan\1\kan_a11_def2.png",80
advsetwindow "16"

langjp「………何を。」\
;＜嘉音
langen:dwave 0, "voice\16\80600064.ogg":^"...Do what?"^\

_ld r,":b;sprites\sha\1\sha_a11_warai2.png",80
cl r,22
advsetwindow "15"

langjp「決闘。」@
;＜紗音
langen:dwave 0, "voice\15\80500090.ogg":^"Let's have a duel."^\


_ld l,":b;sprites\kan\1\kan_a11_nayamu1.png",80
cl l,22
advsetwindow "16"

langjp「…………………いいの？」\
;＜嘉音
langen:dwave 0, "voice\16\80600065.ogg":^"......Are you sure?"^\
advsetwindow "15"


langjp「私たちは、もっと早くに決着をつけるべきだった。@なのに、こうしてゲームが終わる最後の瞬間までこうして、それを先送りにしてる。」\
;＜紗音
langen:dwave 0, "voice\15\80500091.ogg":^"We both wish we'd settled this much sooner.^@:dwave 0, "voice\15\80500092.ogg":^  And yet, we've put it off until the last moment, just before the game is going to end."^\
advsetwindow "16"

;ld r,KAN_defA2,24

langjp「……いいよ。@……どうせ終わるゲームさ。@最後の最後くらい。@………僕らは自分たちの決着を、しっかりとこの手でつけるべきなんだ。」\
;＜嘉音
langen:dwave 0, "voice\16\80600066.ogg":^"...Sure.^@:dwave 0, "voice\16\80600067.ogg":^  ...The game is nearly over anyway.^@:dwave 0, "voice\16\80600068.ogg":^  Now, at the very end,^@:dwave 0, "voice\16\80600069.ogg":^ ...it's time for us to settle things by ourselves."^\
advsetwindow "15"

;ld c,SHA_DefA1,80

langjp「そうすれば、猫箱にしまう前に、私たちは未来を見ることが出来るもんね。」\
;＜紗音
langen:dwave 0, "voice\15\80500093.ogg":^"That way, we'll be able to see our future before we're put away in the cat box."^\

bg new_ment_1br,24
_ld r,":b;sprites\kan\1\kan_a11_nayamu1.png",24
advsetwindow "16"

langjp「………いいとも。@やろうじゃないか。@……何で決める？@　コイン？@　それともまた鉄砲で…？」\
;＜嘉音
langen:dwave 0, "voice\16\80600070.ogg":^"...Sure.^@:dwave 0, "voice\16\80600071.ogg":^  Let's do it.^@:dwave 0, "voice\16\80600072.ogg":^  ...How will we decide it?^@:dwave 0, "voice\16\80600073.ogg":^  A coin?^@:dwave 0, "voice\16\80600074.ogg":^  Or with pistols again...?"^\

;cl c,0
_ld l,":b;sprites\sha\1\sha_a11_tokui1.png",24
advsetwindow "15"

langjp「えっとね、@……じゃー、私たちもクイズ大会にしよっか。」@
;＜紗音
langen:dwave 0, "voice\15\80500094.ogg":^"Ummm, ^@:dwave 0, "voice\15\80500095.ogg":^...in that case, why don't we have our own quiz tournament?"^\

_ld r,":b;sprites\kan\1\kan_a11_komaru2.png",80
advsetwindow "16"

langjp「……はぁ？@　………姉さんも物好きだな。」\
;＜嘉音
langen:dwave 0, "voice\16\80600075.ogg":^"...Huh?^@:dwave 0, "voice\16\80600076.ogg":^  ...You're really getting into this."^\

_ld l,":b;sprites\sha\1\sha_a11_warai2.png",80
advsetwindow "15"

langjp「じゃあね、うーん……、@第一問っ。」\
;＜紗音
langen:dwave 0, "voice\15\80500096.ogg":^"Okay, then...^@:dwave 0, "voice\15\80500097.ogg":^  First question-"^\

bg black,42

fede 0,2000
