;mbg white,1
_ld l,":b;sprites\lam\1\lam_a11_akuwarai4.png",23
advsetwindow "29"
;mcbg 22

langjp「この二人、さすがね。@勘も実に冴えてるわ。」\
;＜ラムダ
langen:dwave 0, "voice\29\82200133.ogg":^"Can't underestimate these two.^@:dwave 0, "voice\29\82200134.ogg":^  Even their instincts are sharp."^\

