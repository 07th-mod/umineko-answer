_ld l,":b;sprites\cla\1\cla_a11_komaru2.png",80
advsetwindow "-1"
langjp　……私じゃなくて、絵羽伯母さんに解かれたのが悔しいみたいだ。@変なの。\
langen^...For some reason, he looked even more mortified to see that Eva had solved it.^@^  How strange.^\

_ld r,":b;sprites\eva\1\eva_b23_akire1.png",80
advsetwindow "05"

langjp「ほらっ。@さっさとメダルを寄越しなさいよ。」\
;＜絵羽
langen:dwave 0, "voice\05\81000276.ogg":^"Come on, now.^@:dwave 0, "voice\05\81000277.ogg":^  Let's see that medal."^\

_ld l,":b;sprites\cla\1\cla_a11_majime1.png",80
advsetwindow "02"

langjp「これは縁寿ちゃんの知恵に評するメダルだ。@絵羽にやるわけではない。」@
;＜蔵臼
langen:dwave 0, "voice\02\80800079.ogg":^"This medal is a mark of Ange-chan's intelligence.^@:dwave 0, "voice\02\80800080.ogg":^  I mustn't let you have it, Eva."^\

_ld r,":b;sprites\eva\1\eva_b25_futeki1.png",80
advsetwindow "05"

langjp「ふん、負け惜しみを…！」\
;＜絵羽
langen:dwave 0, "voice\05\81000278.ogg":^"Heh, sore loser...!"^\

;ld r,EN2_DefA1,80

bg new_mhal_2d,22
advsetwindow "11"
langjp「ありがとう、蔵臼伯父さんっ。@縁寿すごい？　縁寿すごい？！」\
;＜縁寿
langen:dwave 0, "voice\11\82000592.ogg":^"Thank you, Uncle Krauss.^@:dwave 0, "voice\11\82000593.ogg":^  Am I incredible?!"^\
advsetwindow "02"

;ld c,KLA_DefA1,80

langjp「うむ。@伯父さんより、よほど頭が柔軟だ。@君が姪で、私は誇らしいよ。」\
langen:dwave 0, "voice\02\80800081.ogg":^"Very much so.^@:dwave 0, "voice\02\80800082.ogg":^  You're a more flexible thinker than your uncle.^@:dwave 0, "voice\02\80800083.ogg":^  I am proud to have you as a niece."^\
