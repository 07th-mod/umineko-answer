	csp 838 ;紫モードの右側の薄いマスク
	csp 864
	csp 868 ;紫モードの右クリックみたいなところの黒背景
	csp 810 ;紫モードの立ち絵
	csp 813 ;紫モードのnext
	csp 853 ;各章選択のポップアップスイッチ画像
	csp 852 ;人間選択のポップアップスイッチ画像
	csp 854 ;上二つの下地画像
	for %Free3 = 811 to 818 ;第●の晩説明文字
		csp %Free3 
	next
	;811
	se2 57
	lsp 800,":c;bmp\r_click\white.bmp",0,0
	print 1
	csp 800
	print 62	
return



;紫発言のネクストバックボタン（2ページ目があるキャラ）
*p_nextback_btn
;p_page_flgは、1だと朱志香、2だと譲治、3だと戦人、他の1ページのみの表示キャラ
	btndef ""

	mov %Free4,430
	mov %Free5,849
	notif %p_page_flg = 1 : jumpf
		lsp 813,":bc/2,0,3;bmp\ber_sys\p_mode\btn\next.png",%Free5,%Free4
	~
	notif %p_page_flg = 2 : jumpf
		lsp 813,":bc/2,0,3;bmp\ber_sys\p_mode\btn\next.png",%Free5,%Free4
	~
	notif %p_page_flg = 3 : jumpf
		lsp 813,":bc/2,0,3;bmp\ber_sys\p_mode\btn\next.png",%Free5,%Free4
	~
	notif %p_page_flg = 7 : jumpf
		lsp 813,":bc/2,0,3;bmp\ber_sys\p_mode\btn\next.png",%Free5,%Free4
	~
;p_page_flgは、4だと朱志香、5だと譲治、6だと戦人、他の2ページのみの表示キャラ
	notif %p_page_flg = 4 : jumpf
		lsp 813,":bc/2,0,3;bmp\ber_sys\p_mode\btn\back.png",%Free5 - 50 ,%Free4
	~
	notif %p_page_flg = 5 : jumpf
		lsp 813,":bc/2,0,3;bmp\ber_sys\p_mode\btn\back.png",%Free5 - 50 ,%Free4
	~
	notif %p_page_flg = 6 : jumpf
		lsp 813,":bc/2,0,3;bmp\ber_sys\p_mode\btn\back.png",%Free5 - 50 ,%Free4
	~
	notif %p_page_flg = 8 : jumpf
		lsp 813,":bc/2,0,3;bmp\ber_sys\p_mode\btn\back.png",%Free5 - 50 ,%Free4
	~
	print 1
	;上のネクスト、バックボタンをスプライトボタンにする
	spbtn 813,17

	;上の画像ボタンに機能を持たせつつ、全てのボタンを機能させる
	gosub *p_btn

	mov $witchh19, ":bc;"
	if %cur_language = 0 add $witchh19,"en\"

		;1ページ目の画像から2ページ目のに切り替える処理。そして、そのフラグなども。
		;ここではpage_flgで管理している。この数字により、誰の何ページ目を表示するか管理。
	;	notif %p_page_flg = 1 : jumpf
	;	if %BtnRes = 17 : csp 813 : mov %p_page_flg,4 : se1 1000 : mov $witchh20, $witchh19 : add $witchh20, "bmp\ber_sys\p_mode\p\back_jes_2.png" : lsp 850,$witchh20,522,70,255 : lsp 810,"bmp\tati\jes\1\jes_MajimeA1",300,0,40 : gosub *p_nextback_btn ;朱志香2ページ目処理
	;~
	;	notif %p_page_flg = 2 : jumpf
	;	if %BtnRes = 17 : csp 813 : mov %p_page_flg,5 : se1 1000 : mov $witchh20, $witchh19 : add $witchh20, "bmp\ber_sys\p_mode\p\back_geo_2.png" : lsp 850,$witchh20,522,70,255 : lsp 810,"bmp\tati\geo\1\geo_MajimeA1",270,0,40 : gosub *p_nextback_btn ;譲治2ページ目処理
	;~
	;	notif %p_page_flg = 3 : jumpf
	;	if %BtnRes = 17 : csp 813 : mov %p_page_flg,6 : se1 1000 : mov $witchh20, $witchh19 : add $witchh20, "bmp\ber_sys\p_mode\p\back_but_2.png" : lsp 850,$witchh20,522,70,255 : lsp 810,"bmp\tati\but\1\but_MajimeA1",300,0,40 : gosub *p_nextback_btn ;戦人2ページ目処理
	;~
		
		;2ページ目の画像から1ページ目のに切り替える処理。そして、そのフラグなども。
	;	notif %p_page_flg = 4 : jumpf
	;	if %BtnRes = 17 : csp 813 : mov %p_page_flg,1 : se1 1000 : mov $witchh20, $witchh19 : add $witchh20, "bmp\ber_sys\p_mode\p\back_jes_1.png" : lsp 850,$witchh20,522,70,255 : lsp 810,"bmp\tati\jes\1\jes_MajimeA1",300,0,40 : gosub *p_nextback_btn ;朱志香2ページ目処理
