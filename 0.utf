;＜ゼパル
langen:dwave 0, "voice\51\75100027.ogg":^"You never talk about anything, but you've known everything since the beginning, haven't you?"^\

_ld c,":b;sprites\gen\1\gen_a21_kashikomari1.png",80
advsetwindow "-1"

langjp「………………………………。」\
;＜源次
langen^"............"^\

_ld l,":b;sprites\zep\1\zep_a11_majime2.png",80
advsetwindow "51"

langjp「１９年前。@赤ん坊を抱いた使用人が転落し、君は夏妃から報告を受けたね。」@
;＜ゼパル
langen:dwave 0, "voice\51\75100028.ogg":^"19 years ago,^@:dwave 0, "voice\51\75100029.ogg":^ you heard from Natsuhi that a servant had fallen from a cliff holding a baby."^\

_ld r,":b;sprites\fur\1\fur_a11_majime1.png",80
advsetwindow "52"

langjp「そして崖下へ行き、まだ赤ん坊が生きていることに気付いたんじゃないの？」\
;＜フルフル
langen:dwave 0, "voice\52\75200032.ogg":^"You went to the bottom of that cliff and realized that the baby was still alive, didn't you?"^\

_ld c,":b;sprites\gen\1\gen_a11_komaru1.png",80
advsetwindow "14"

langjp「………生きているか死んでいるか。@そのような判断は私には出来かねました。」\
;＜源次
langen:dwave 0, "voice\14\71600024.ogg":^"...I was not qualified ^@:dwave 0, "voice\14\71600025.ogg":^to determine whether it was alive or dead."^\

bg new_the_2b,24
_ld r,":b;sprites\zep\1\zep_a11_warai5.png",24
advsetwindow "51"

langjp「それを判断したのは誰？」@
;＜ゼパル
langen:dwave 0, "voice\51\75100030.ogg":^"Then who was?"^\

se2 48
_ld l,":b;sprites\fur\1\fur_a11_warai6.png",23
advsetwindow "52"

langjp「決まってるわ、お医者様よ！」\
;＜フルフル
langen:dwave 0, "voice\52\75200033.ogg":^"The doctor, of course!"^\



_ld r,":b;sprites\zep\1\zep_a11_warai3.png",0
_ld l,":b;sprites\fur\1\fur_a11_warai3.png",80
