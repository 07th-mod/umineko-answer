;＜ベルン
langen:dwave 0, "voice\28\82100380.ogg":^"That definitely sounds like something an old person would say, but I'll bite.^@:dwave 0, "voice\28\82100381.ogg":^  What do you mean?"^\

;ld c,FEA_DefA1,80
bg new_different_spiral_1a,22
