		if %r_hyouji_cha_ma = ma5_s && %r_s_hyouji = 4 mov %r_s556_flg,1 : seplay 9,1100 : goto *rmenu_custom_btlp_100_ep5_2

		;選択されているキャラを一段悪化させる（コンディションがエンドまで来ているのなら処理を飛ばす）
		;コンディションが０以下（未登場なら状態を変化させない）
		if %r_killeveryone = 1 goto *rmenu_custom_btlp_50_ep5_2
