*r_gazou_shokika_ep5


	for %tmp = 100 to r_used_lsp : csp %tmp next
;	for %tmp = kin_btn_lsp to r_used_lsp : csp %tmp next
	csp r_bg_lsp
	csp r_black_lsp
return
