;＜縁寿
langen:dwave 0, "voice\11\72000035.ogg":^"......Bernkastel?^@:dwave 0, "voice\11\72000036.ogg":^  That one with the long, blue hair and the gloomy face...?"^\

_ld r,":b;sprites\rio\1\rio_a11_def3.png",80
advsetwindow "53"

langjp「え、……えぇ。@多分、そんな容姿だったと思います……。」\
;＜理御
langen:dwave 0, "voice\53\75300657.ogg":^"...Y-Yes.^@:dwave 0, "voice\53\75300658.ogg":^  That probably fits her, I think..."^\

_ld l,":b;sprites\enj\1\enj_a11_fuman2.png",80
advsetwindow "11"

langjp「………つまり。@私はまた、魔女の茶番に付き合わされてるわけね。@……ここは一体？」@
;＜縁寿
langen:dwave 0, "voice\11\72000037.ogg":^"......In other words,^@:dwave 0, "voice\11\72000038.ogg":^ I've been forced to play along with another witch's farce.^@:dwave 0, "voice\11\72000039.ogg":^  ...Just where is this place?"^\


_ld r,":b;sprites\rio\1\rio_a11_majime1.png",80
advsetwindow "53"

langjp「私もさっき目を覚ましたばかりです。@……ここはどこでしょう。」\
;＜理御
langen:dwave 0, "voice\53\75300659.ogg":^"I only woke up a second ago myself.^@:dwave 0, "voice\53\75300660.ogg":^  ...I'm wondering the same thing."^\

bg black,23
bg new_the_1f,23
advsetwindow "11"
;ld r,ENJ_DefA1,80

langjp「劇場に見えるわ。@……何かを観劇しろ、ってのかしら。」@
;＜縁寿
langen:dwave 0, "voice\11\72000040.ogg":^"It looks like a theater.^@:dwave 0, "voice\11\72000041.ogg":^  ...Are we supposed to watch a play or something?"^\
advsetwindow "53"


;ld l,RIO_DefA1,80

langjp「……今はそういう気分ではありませんね。@出口を探しましょう。」\
;＜理御
langen:dwave 0, "voice\53\75300661.ogg":^"...I'm really not in the mood now.^@:dwave 0, "voice\53\75300662.ogg":^  Let's look for an exit."^\

