*scenario_jump
mov %Free1,501

;Ｘ軸基本値
mov %x,60
if %scenario_Number = 5 mov %x,145 
if %scenario_Number = 6 mov %x,125
if %scenario_Number = 7 mov %x,125
if %scenario_Number = 8 mov %x,145

;Ｙ軸基本値
mov %y,60
if %scenario_Number = 5 mov %y,95
if %scenario_Number = 6 mov %y,70
if %scenario_Number = 7 mov %y,70

;画面配置
;説明テキストの表示
;lsp 500,":s#FFFFFF行き先をご選択くださいませ",100,20
;lsp 500,":s#FFFFFF^Please select your destination.^",60,20
;if %scenario_Number = 6 lsp 500,":s#FFFFFF^Please select your destination.^",20,15

notif %cur_language = 1 jumpf
lsp 500,":s#FFFFFF行き先をご選択くださいませ",50,20
if %scenario_Number = 6 mov %x,100
if %scenario_Number = 6 lsp 500,":s#FFFFFF^行き先をご選択くださいませ^",100,15
~

notif %cur_language = 0 jumpf
lsp 500,":s#FFFFFF^Please select your destination.  ",50,20  ;;行き先をご選択くださいませ
if %scenario_Number = 6 lsp 500,":s#FFFFFF^Please select your destination.^",50,20
if %scenario_Number = 8 lsp 500,":s#FFFFFF^Please select your destination.^",50,20
~


;スプライトボタンの配置（EP1〜EP3）
;EP4は二段組にする為、別途ボタンの配置を行う。
if %scenario_Number = 8 jumpf
	for %Free3 = 1 to %Free2

		;スプライト配置回数が　倍数なら、次の行へ
		;スプライト配置開始
		lsp %Free1,$%Free1,%x,%y

		;ボタン化
		spbtn %Free1,%Free3

		;Ｘ値増加
		add %y,22
		inc %Free1
	next
	;戻るボタンスプライトの設置
;	lsp rmenu_btn_Exit,":s#C7C7C7#FFFFFF戻る　　",%x,%y
;	if %scenario_Number = 7 mov %y,446
;	lsp rmenu_btn_Exit,":s#C7C7C7#FFFFFF^Back to Main Menu^",40,480

	if %cur_language = 1 lsp rmenu_btn_Exit,":s#C7C7C7#FFFFFF戻る　　",%x,%y

	if %cur_language = 0 && %scenario_Number = 7 mov %y,446
	if %cur_language = 0 lsp rmenu_btn_Exit,":s#C7C7C7#FFFFFF^Back to Main Menu  ",40,480
~

notif %scenario_Number = 8 jumpf
	mov %x,125 : mov %y,100
if %cur_language = 1 lsp 500,":s#FFFFFF行き先をご選択くださいませ",%x,50
if %cur_language = 0 lsp 500,":s#FFFFFF^Please select your destination.^",50,20
	for %Free3 = 1 to %Free2
		;１０以上は２列目に表示を行う。
		if %Free3 = 11 mov %x,510 : mov %y,100
		
		;スプライト配置回数が　倍数なら、次の行へ
		;スプライト配置開始
		lsp %Free1,$%Free1,%x,%y

		;ボタン化
		spbtn %Free1,%Free3

		;Ｘ値増加
		add %y,35
		inc %Free1
	next
	;戻るボタンスプライトの設置
if %cur_language = 1 lsp rmenu_btn_Exit,":s#C7C7C7#FFFFFF戻る",40,480
if %cur_language = 0 lsp rmenu_btn_Exit,":s#C7C7C7#FFFFFF^Back to Main Menu^",40,480

~







spbtn 499,499


spbtn rmenu_btn_Exit,rmenu_btn_Exit

amsp 703,0,0,200
print 1

*scenario_jump_btnwait

;ボタン待ち

     	btnwait %btnRes

	if %btnRes = rmenu_btn_Exit goto *b_title
	if %btnRes = -1 goto *b_title
	if %scenario_Number = 5  goto *scenario_jump_data1
	if %scenario_Number = 6  goto *scenario_jump_data2
	if %scenario_Number = 7  goto *scenario_jump_data3
	if %scenario_Number = 8  goto *scenario_jump_data4

;戻るでタイトルに戻る

goto *scenario_jump_btnwait   ;ボタン待ちにジャンプ

