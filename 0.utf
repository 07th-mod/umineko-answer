;ld l,GAP_AkuwaraiA3,80

langjp　……戦人は金蔵を、あの部屋のどこから逃がしたんだったかしらァ…？」\
;＜ガァプ
langen:dwave 0, "voice\32\63700040.ogg":^  ...Just how did Battler let Kinzo escape from that room...?"^\

_ld c,":b;sprites\cor\1\cor_a11_majime2.png",80
