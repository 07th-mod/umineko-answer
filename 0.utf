_ld c,":b;sprites\cur\1\cur_a11_warai8.png",23
advsetwindow "27"

langjp「そうだったな。@そなたは妾を、もはや覚えてはおらぬのだったな。」\
;＜クレル
langen:dwave 0, "voice\55\75500428.ogg":^"Indeed.^@:dwave 0, "voice\55\75500429.ogg":^  You no longer remember me, do you?"^\

