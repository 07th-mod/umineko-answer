lsph 815,":ba;bmp\efe\cake15.png",0,0	

print 22

btndef ""
;ボタンの上にカーソルが載ったときの処理
exbtn_d "P800C801C802C803C804C805C806C807C808C809C810C811C812C813C814C815"

;ボタン絡み
exbtn 801,801,"P801"
exbtn 802,802,"P802"
exbtn 803,803,"P803"
exbtn 804,804,"P804"
exbtn 805,805,"P805"
exbtn 806,806,"P806"
exbtn 807,807,"P807"
exbtn 808,808,"P808"
exbtn 809,809,"P809"
exbtn 810,810,"P810"
exbtn 811,811,"P811"
exbtn 812,812,"P812"
exbtn 813,813,"P813"
exbtn 814,814,"P814"
exbtn 815,815,"P815"

;透過処理が掛かっている部分はボタン処理を行なわない、という宣言
transbtn

*sweet_loop
;ボタンレス
btnwait2 %BtnRes

;該当のスプライト番号のボタンが押された時の処理
for %Free3 = 801 to 815
	if %BtnRes = %Free3 cell %Free3,1 : print 1:btndef "" : csp -1 : print 2 : csp %Free3 : delay 500 : print 22 : goto *next_st
next

goto *sweet_loop ;ループポイント

return



