_ld c,":b;sprites\rg7\1\rg7_e11_akuwarai1.png",80
advsetwindow "-1"

langjp「その鍵だけ、あんたが見てない隙に、引っこ抜いたんじゃないの…？」\
;＜アスモ
langen:dwave 0, "voice\44\72900015.ogg":^"Maybe Yasu just pulled that one key off while you weren't looking...?"^\

bg new_the_2b,0
_ld r,":b;sprites\rg6\1\rg6_e11_odoroki1.png",64
quakex 2,200
advsetwindow "-1"

langjp「そんなの出来る？！　実際に！@　鍵束を丸ごとひょいっと隠すならともかく、@鍵束から鍵をひとつ抜き取るって、考えれば考えるほどに簡単じゃないよ？！@　カチャカチャ、ガチャガチャ。@すぐそこで私が背中を向けてるのよ？@　そんなこと悠長にやってたら、いくら私が馬鹿でも気が付く！」\
langen:dwave 0, "voice\43\72800028.ogg":^"Is that even possible?!  Practically speaking?!^@:dwave 0, "voice\43\72800029.ogg":^  Hiding the whole ring is one thing,^@:dwave 0, "voice\43\72800030.ogg":^ but if you really think about it, taking a single key off the key ring isn't that easy!^\:dwave 0, "voice\43\72800031.ogg":^  The keys would clatter together.^@:dwave 0, "voice\43\72800032.ogg":^  I was standing right next to them, just facing the other way, get it?^@:dwave 0, "voice\43\72800033.ogg":^  If you took your time removing a key when I was that close, even an idiot like me would've noticed!"^\

_ld r,":b;sprites\rg6\1\rg6_e31_komaru2.png",80
advsetwindow "-1"

langjp「でも音もなくすぅっと、鍵がひとつだけ消えていた。@……あの時に初めて気が付いたの。@/
langjp!s1これ、逆ギレしたヤスの悪戯じゃなくて、/
langjp!d800……もっとその、/
langjp!d900……ヤバいモンなんじゃね、/
langjp!d800…って。」/
langen:dwave 0, "voice\43\72800034.ogg":^"But a single key just vanished without a sound.^@:dwave 0, "voice\43\72800035.ogg":^  ...At that moment, I finally realized.^@/
advsetwindow "-1"
langen:dwave 0, "voice\43\72800036.ogg":!s1^  This wasn't Yasu trying to get back at me,^@/
advsetwindow "-1"
langen:delay 3300:dwave 0, "voice\43\72800037.ogg":^ ...it was something...^@/
advsetwindow "-1"
langen:delay 1500:dwave 0, "voice\43\72800038.ogg":^...worse..."^@/
