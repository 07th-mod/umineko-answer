me1v 5,50
advsetwindow "01"

langjp『……回答期限は明日の正午だそうだ。@……中尉め、まるで脅迫だ。』@
;＜若金蔵
langen:dwave 0, "voice\58\75600184.ogg":^"<...He's giving you until noon tomorrow.^@:dwave 0, "voice\58\75600185.ogg":^  ...That bastard, he's practically threatening you.>"^\

_ld l,":b;sprites\bea\1\bea_c11_odoroki5.png",23
advsetwindow "27"

langjp『少尉は、全員の意見を聞くと言ってるわ…。』@
;＜ベアト
langen:dwave 0, "voice\59\70700136.ogg":^"<Lieutenant Angelo says he'll ask for everyone's thoughts on the matter...>"^\

_ld r,":b;sprites\ki2\1\ki2_a11_odoroki2.png",80
advsetwindow "01"

langjp『感触は？』\
;＜若金蔵
langen:dwave 0, "voice\58\75600186.ogg":^"<Which way do you think they'll go?>"^\

_ld l,":b;sprites\bea\1\bea_c11_komaru3.png",80
advsetwindow "27"
;ld l,KI2_NayamuB1,80

langjp『多分、難航するわ。@……少尉自身は山分けもありえると考えてるみたいだけど、@下士官や、他の仲間たちは多分反対するわ。@……みんな、この極東までの航海で、大切な仲間を大勢失ってる。@彼らは頑なに祖国への忠誠を貫きたがってる。』\
;＜ベアト
langen:dwave 0, "voice\59\70700137.ogg":^"<It'll probably be tough going.^@:dwave 0, "voice\59\70700138.ogg":^  ...It seems Lieutenant Angelo is willing to consider splitting it,^@:dwave 0, "voice\59\70700139.ogg":^ but his subordinates and the others will probably oppose that.^@:dwave 0, "voice\59\70700140.ogg":^  ...All of them have lost close friends on their voyage to the Far East.^@:dwave 0, "voice\59\70700141.ogg":^  They're firm in their desire to do their duty for our homeland.>"^\

_ld r,":b;sprites\ki2\1\ki2_a11_nayamu4.png",80
advsetwindow "01"

langjp『……中尉の申し出は断ると？』\
;＜若金蔵
langen:dwave 0, "voice\58\75600187.ogg":^"<...Will they refuse Lieutenant Yamamoto's proposal?>"^\

_ld l,":b;sprites\bea\1\bea_c11_fukigen3.png",80
advsetwindow "27"

langjp『断っても、どうせ黄金は誰かの手に渡るわ。@……何も残らないなら、せめてインゴットの１本ずつでも密かに持ち帰ろうという少尉の言い分に、同調者も出そうだけど……。@/
langen:dwave 0, "voice\59\70700142.ogg":^"<Even if they do, the gold will just fall into someone else's hands.^@:dwave 0, "voice\59\70700143.ogg":^  ...If nothing is going to be left anyway, Lieutenant Angelo suggests that they each sneak at least one ingot back with them, and some of the others seem to agree, but...^@/

_ld l,":b;sprites\bea\1\bea_c11_komaru4.png",80
advsetwindow "27"

langjpこういう時の男って、勢いだけが迷走するわ。@私も見当が付かない…。』\
;＜ベアト
langen:dwave 0, "voice\59\70700144.ogg":^  Men always get carried away at times like this.^@:dwave 0, "voice\59\70700145.ogg":^  Even I can't guess what they'll do...>"^\





