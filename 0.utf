langjp「如何にも。@妾こそが、右代宮家顧問錬金術師、黄金の魔女ベアトリーチェである。@/
langen:dwave 0, "voice\27\50700020.ogg":^"Indeed.^@:dwave 0, "voice\27\50700021.ogg":^  I am the Ushiromiya family alchemist, the Golden Witch Beatrice.^@/

_ld c,":b;sprites\bea\1\bea_a11_akuwarai1.png",80
