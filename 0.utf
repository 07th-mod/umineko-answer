_ld r,":b;sprites\cur\1\cur_a11_majime1.png",24
advsetwindow "55"

langjp「この時点では、私も試験だと思っていました。@これは、右代宮金蔵の気紛れなる、跡継ぎ選びのゲームだと。」@
;＜クレル
langen:dwave 0, "voice\55\75500805.ogg":^"At this point in time, I also thought it was a trial.^@:dwave 0, "voice\55\75500806.ogg":^  That it was a game for selecting the Successor, which Ushiromiya Kinzo decided upon on a whim."^\

_ld l,":b;sprites\rio\1\rio_a11_akire1a.png",23
advsetwindow "53"

langjp「違う、のですか。」\
;＜理御
langen:dwave 0, "voice\53\75300522.ogg":^"And it wasn't?"^\


_ld r,":b;sprites\cur\1\cur_a11_fuman3.png",80
advsetwindow "55"

langjp「……この碑文は、……………右代宮金蔵と呂ノ上源次の、@二人にしかわからぬ、ある意味を持っていたのです。@/
langen:dwave 0, "voice\55\75500807.ogg":^"...This epitaph......meant something for Ushiromiya Kinzo and Ronoue Genji ^@:dwave 0, "voice\55\75500808.ogg":^that only the two of them could understand.^@/

_ld r,":b;sprites\cur\1\cur_a11_nayamu3.png",80
advsetwindow "55"

langjpだから、これは運命なんかじゃない。@必然だったのです。@……私は、カボチャの馬車からガラスの靴まで、全てを準備されたシンデレラに過ぎない。」\
;＜クレル
langen:dwave 0, "voice\55\75500809.ogg":^  So, this was not the workings of fate.^@:dwave 0, "voice\55\75500810.ogg":^  It was inevitable.^@:dwave 0, "voice\55\75500811.ogg":^  ...I was no more than a Cinderella, with the pumpkin carriage and glass slippers all prepared beforehand."^\

bg new_cha_i1ip,0
_ld l,":b;sprites\wil\1\wil_a11_niramu1.png",23
advsetwindow "54"

langjp「………なるほどな。@/
langen:dwave 0, "voice\54\75401041.ogg":^"...I get it.^@/
advsetwindow "54"

;ld l,WIL_NayamuA1,80

langjp……これは、金蔵と源次の、……茶番だったわけか。」@
;＜ウィル
langen:dwave 0, "voice\54\75401042.ogg":^  ...So, ...this was a farce that Kinzo and Genji set up."^\

_ld r,":b;sprites\cur\1\cur_a11_fuman3.png",24
advsetwindow "55"

langjp「金蔵は、わかっていたのです。@そして源次もまた、これがそのメッセージだと、理解したのです。」\
;＜クレル
langen:dwave 0, "voice\55\75500812.ogg":^"Kinzo did understand.^@:dwave 0, "voice\55\75500813.ogg":^  And Genji realized that this was a message."^\

cl l,24
