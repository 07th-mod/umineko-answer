_ld c,":b;sprites\bea\1\bea_a13_futeki2.png",24
advsetwindow "27"

langjp「ならば、そなたを苛む役は、その十字架だ。@妾ではない。」@
;＜ベアト
langen:dwave 0, "voice\27\80700249.ogg":^"In that case, the suffering you must endure will come from the cross you bear.^@:dwave 0, "voice\27\80700250.ogg":^  Not from me."^\

;cl c,23
;ld r,BEA_futekiA2,0
_ld l,":b;sprites\nat\1\nat_a12_tukare1.png",24
_ld l,":b;sprites\nat\1\nat_a12_nayamu3.png",80
advsetwindow "03"

langjp「私を、……恨まないというのですか…。」\
;＜夏妃
langen:dwave 0, "voice\03\80900062.ogg":^"You don't...despise me...?"^\

cl c,0
_ld r,":b;sprites\bea\1\bea_a13_1_warai1.png",23
advsetwindow "27"

langjp「そう、しょげた顔をするなって。@……いやいや、むしろ逆だなぁ。@お前がそのしょげた顔を見せる限り、妾はそなたを咎めようとは思わぬ。@そなたがその十字架を背負い続ける限り。@妾はそなたを恨もうとは思わぬ。」\
;＜ベアト
langen:dwave 0, "voice\27\80700251.ogg":^"Don't make that dejected face.^@:dwave 0, "voice\27\80700252.ogg":^  ...No, perhaps it's the other way around.^@:dwave 0, "voice\27\80700253.ogg":^  As long as you continue making that dejected face, I will feel no desire to punish you.^@:dwave 0, "voice\27\80700254.ogg":^  As long as you continue to carry that cross,^@:dwave 0, "voice\27\80700255.ogg":^ I will feel no desire to hate you."^\

_ld l,":b;sprites\nat\1\nat_a12_naku3.png",80
advsetwindow "03"

langjp「この私を、……恨まないというのですか……。」\
;＜夏妃
langen:dwave 0, "voice\03\80900063.ogg":^"Do you mean...that you don't hate me...?"^\

