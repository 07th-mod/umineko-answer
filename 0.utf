effect 25,18,300,":c;Bmp\Efe\down.bmp"
effect 45,18,3000,":c;Bmp\Efe\down.bmp"
effect 65,15,300,":c;Bmp\Efe\down.bmp"
effect 85,15,5,":c;Bmp\Efe\down.bmp"

;下フェード
