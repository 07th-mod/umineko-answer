*question_7 ;読み返しモードのためのラベル
mov %play_scene,80110 ;シーン変数の入力

mov %r_hyouji_side,0
mov %r_hyouji_cha,but

;★ゲームルールの確認
;■魔女の喫煙室

textoff
mov %BUT_Isyou,2
bg new_different_space_1c,0

;se1 52
_ld l,":b;sprites\ber\1\ber_a21_shian1.png",2
_ld l,":b;sprites\ber\1\ber_a21_def2.png",80
;print 99,800,"breakup.dll/llp"

bgm1 97
advsetwindow "28"

langjp「……これで、私の物語はおしまいよ。」@
;＜ベルン
langen:dwave 0, "voice\28\82100141.ogg":^"...That's all for my tale."^\

se1 57
mbg white,1
_ld r,":b;sprites\lam\1\lam_a11_futeki2.png",0
mcbg 22
advsetwindow "29"

langjp「なかなかよく出来てるじゃない。@ちゃんと朗読したなら、ベアトのゲームに混じってても不思議じゃない物語だったわ。」\
;＜ラムダ
langen:dwave 0, "voice\29\82200115.ogg":^"It's pretty well-made.^@:dwave 0, "voice\29\82200116.ogg":^  If you had a full-on Reader, it'd stand up well against Beato's games."^\

bg new_different_space_1a,22
_ld r,":b;sprites\but\1\but_d11_futeki1.png",24
advsetwindow "10"

langjp「それは認めるぜ。@よく出来てた。」@
;＜戦人
langen:dwave 0, "voice\10\80100625.ogg":^"I agree there.^@:dwave 0, "voice\10\80100626.ogg":^  You did a good job."^\

_ld l,":b;sprites\bea\1\bea_a11_fukigen2.png",23
advsetwindow "27"

langjp「まぁ、ここから朗読して観劇に耐えるものにするのが骨なのであるが。」\
;＜ベアト
langen:dwave 0, "voice\27\80700419.ogg":^"Well, the real work comes from taking this, Reading it and making it worthy of proper theatergoing."^\

_ld r,":b;sprites\but\1\but_d11_niramu3.png",80
advsetwindow "10"

langjp「しかし、何が何だかさっぱりだぜ。@まともに考えたら、犯人は右代宮家以外の、謎の人物ってことになっちまう。」\
;＜戦人
langen:dwave 0, "voice\10\80100627.ogg":^"Still, I'm stumped.^@:dwave 0, "voice\10\80100628.ogg":^  On the face of it, the culprit has to be some mysterious person outside the Ushiromiya family."^\

_ld l,":b;sprites\bea\1\bea_a11_majime1.png",80
advsetwindow "27"

langjp「それは魔女を認めるも同じだ。@……他にも、犯人に協力する共犯者の存在などが疑えるだろうな。」\
;＜ベアト
langen:dwave 0, "voice\27\80700420.ogg":^"And that would be the same as acknowledging the existence of a witch.^@:dwave 0, "voice\27\80700421.ogg":^  ...We can also suspect the existence of some accomplices aiding the culprit."^\

bg black,23
bg new_different_space_1c,23
_ld l,":b;sprites\but\1\but_d11_oya1.png",23
advsetwindow "10"

langjp「そもそも、あの紫の文字は何なんだ。@新しいルールか？」\
;＜戦人
langen:dwave 0, "voice\10\80100629.ogg":^"By the way, what was that purple text all about?^@:dwave 0, "voice\10\80100630.ogg":^  A new rule?"^\

;se1 52
_ld r,":b;sprites\ber\1\ber_a21_def1.png",22
advsetwindow "28"
;print 99,800,"breakup.dll/llp"

langjp「……“紫の発言”と呼ぶわ。@話をわかりやすくするために作ったルールよ。@……紫の発言は、重要な発言であると認識してくれれば結構よ。@……逆を返せば、紫でない発言は無視することも可能かもしれない。」\
;＜ベルン
langen:dwave 0, "voice\28\82100142.ogg":^"...I call them `purple statements'.^@:dwave 0, "voice\28\82100143.ogg":^  It's a rule I made to make the story a bit easier to follow.^@:dwave 0, "voice\28\82100144.ogg":^  ...Just think of the purple statements as important spoken statements.^@:dwave 0, "voice\28\82100145.ogg":^  ...In other words, you might be able to ignore the spoken statements that aren't purple."^\

_ld l,":b;sprites\but\1\but_d11_futeki1.png",80
advsetwindow "10"

langjp「ほう……。@そりゃ親切な話だな。」\
;＜戦人
langen:dwave 0, "voice\10\80100631.ogg":^"Oho...^@:dwave 0, "voice\10\80100632.ogg":^  Well, that's nice of you."^\

bg black,24
bg new_different_space_1a,0
_ld l,":b;sprites\bea\1\bea_a11_majime2.png",24
advsetwindow "27"

langjp「では、紫の発言は、赤き真実に準ずるのか。」\
;＜ベアト
langen:dwave 0, "voice\27\80700422.ogg":^"Then, are the purple statements as reliable as red truth?"^\

ut_mld c,":b;sprites\ber\1\ber_a21_warai1.png",23
advsetwindow "28"

langjp「えぇ。@紫の発言は、赤き真実と同じ力があると考えて良いわ。@………ただし、一つだけ例外がある。@それは、犯人は紫の発言でウソをつくことが出来るということよ。」\
;＜ベルン
langen:dwave 0, "voice\28\82100146.ogg":^"Yes.^@:dwave 0, "voice\28\82100147.ogg":^  You can think of the purple statements as having the same power as red truth.^@:dwave 0, "voice\28\82100148.ogg":^  ...However, there's one exception.^@:dwave 0, "voice\28\82100149.ogg":^  A culprit can tell lies with purple statements."^\

_ld r,":b;sprites\but\1\but_d11_oya1.png",23
advsetwindow "10"

langjp「……なるほど。@逆を返せば、犯人以外はウソをつけないってわけか。」@
;＜戦人
langen:dwave 0, "voice\10\80100633.ogg":^"...I see.^@:dwave 0, "voice\10\80100634.ogg":^  To turn it around, anyone who isn't a culprit can't tell lies."^\

_ld l,":b;sprites\bea\1\bea_a11_1_majime6.png",80
advsetwindow "27"

langjp「紫の発言。@……これがどうやら、ベルンカステル卿のゲームの鍵であるわけだな。」\
;＜ベアト
langen:dwave 0, "voice\27\80700423.ogg":^"Purple statements...^@:dwave 0, "voice\27\80700424.ogg":^  ...These seem to be the key to Lady Bernkastel's game."^\

ut_mld c,":b;sprites\ber\1\ber_a21_warai4.png",80
advsetwindow "28"

langjp「えぇ、そうよ。@………私のゲームの、ルールの前提を説明するわ。」\
;＜ベルン
langen:dwave 0, "voice\28\82100150.ogg":^"Yeah, that's right.^@:dwave 0, "voice\28\82100151.ogg":^  ...I'll explain the rules."^\
;★ルール表示、というボタンで、以下を表示
;★その際は、末尾に、●ト書き部分に、ウソは存在しない。を追加。
mcl c,0
bg black,22
se1 61
indicateNVLSection
setwindow 165,16,25,20,26,26,0,2,20,1,1,#999999,0,0,960,540;utmeta-start;<NO_TEXT_START>226796
;advsetwindow "-1"
;locate 0,1;utmeta-setwindow
langjp●犯人の定義とは、殺人者のことである。@
locate 0, 4 ;<CENTER_TEXT>
langen^*The definition of `culprit' is `one who murders'.^@
se1 61
;advsetwindow "-1"
langjp●犯人はウソをつく可能性がある。@
langen^*It is possible for a culprit to lie.^@
se1 61
;advsetwindow "-1"
langjp●犯人は殺人以前にもウソをつく可能性がある。@
langen^*It is possible for a culprit to lie even before committing murder.^@
se1 61
;advsetwindow "-1"
langjp●犯人でない人物は、真実のみを語る。@
langen^*Characters who are not culprits only speak the truth.^@
se1 61
;advsetwindow "-1"
langjp●犯人でない人物は、犯人に協力しない。@
langen^*Characters who are not culprits may not cooperate with a culprit.^\
se1 61
;advsetwindow "-1"
langjp●犯人は全ての殺人を、自らの手で直接行なう。@
locate 0, 4 ;<CENTER_TEXT>
langen^*A culprit must carry out all murders directly, by their own hands.^@
se1 61
;advsetwindow "-1"
langjp●犯人が死ぬことはない。@
langen^*A culprit must not die.^@
se1 61
;advsetwindow "-1"
langjp●犯人は登場人物の中にいる。@
langen^*A culprit must be among the characters appearing in the story.^@
se1 61
;advsetwindow "-1"
