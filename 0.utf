beginADVSection
advsetwindow "-1"
gosub *murder_story_sys_check 
goto *umi8_10 ;謎解きシステム起動


;★ゲーム部分

;★選択できる選択肢は以下のフローチャート

;●物語を再読
;　　→各章（各晩の殺人）のみを読み直せる。@
;●紫発言確認
;　　→キャラ指名。特定のキャラの紫発言一覧が見られる
;　　→各章指定。その晩の紫発言一覧が見られる
;●ヒント
;　　→１つ読むごとに、新しいヒントが増える。（既読のヒントは自由に読み返せる）
;●犯人特定
;　　→犯人入力画面へ（犯人を間違えた場合、新ヒントイベントに送る）





;★ヒント

;■信用できる紫発言を探せ
*hinto_1
mov %play_scene,80110 ;シーン変数の入力

mov %r_hyouji_side,0
mov %r_hyouji_cha,but
mov %BUT_Isyou,2


