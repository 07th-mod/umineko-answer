;このシステムに関わるサブルーチン関連

;読み直しモード時、各ストーリーの終わりにここに戻ってこれるようにするサブルーチン
*murder_story_sys_check
	
	;物語を読み直すモードでないなら何もせず終了
	notif %murder_s_flg = 1 : jumpf
	E_A
	bgm1 128
	goto *murder_story_sys
~

return



;紫文字読み直しモード時、各ストーリーの終わりにここに戻ってこれるようにするサブルーチン
*p_story_sys_check

	;物語を読み直すモードでないなら何もせず終了
	notif %p_flg = 1 : jumpf
		csp -1
		bg black,22
		goto *p_kakushou_loop
	~

return


*ware_eff
se1 1100
lsp 800,":b;bmp\efe\ware.png",0,0,250
print 1
wait 500
return










;紫文字読み返しサブルーチン
*p_dai_1
	;一度右側の画像を消してしまう
	for %Free7 = 821 to 837
		csp %Free7
	next

	;背景を茶色いのに変更
	;華
	;第一の晩ボタンと画像の座標を変更
	*p_dai1_loop
	btndef ""
	mov %Free5,255 ;画像のX軸
	mov %Free6,22 ;画像のy軸

	mov $witchh4,""
	notif %cur_language = 0 jumpf
		mov $witchh4, "en\"
	~
	;lsp 864,":c;bmp\ber_sys\p_mode\cha_btn_back.bmp",11 ,65,150 ;キャラボタン背景
	lsp 816,":ba;" + $witchh4 + "bmp\ber_sys\p_mode\shou\mozi\sentakusitekudasai.png",84,84,250 ;文字（選択してください）
	;第一の晩の紫発言の文字ボタンを表示
	mov %Free1,811 ;文字のスプライト番号
	mov %Free2,32 ;文字のY軸の増加地
	mov %Free3,99 ;文字のX軸
	mov %Free4,133 ;文字のY軸
	mov %Free8,6 ;ボタン番号（初期は６。左のボタンで常に５まで使っているため）
	lsp %Free1,":ba/2,0,3;" + $witchh4 + "bmp\ber_sys\p_mode\shou\mozi\1_1.png",%Free3,%Free4 : add %Free4,%Free2 : inc %Free1 ;811
		spbtn %Free1 - 1,%Free8 : inc %Free8 ;スプライトをボタン化
	lsp %Free1,":ba/2,0,3;" + $witchh4 + "bmp\ber_sys\p_mode\shou\mozi\1_2.png",%Free3,%Free4 : add %Free4,%Free2 : inc %Free1 ;812
		spbtn %Free1 - 1,%Free8 : inc %Free8 ;スプライトをボタン化
	lsp %Free1,":ba/2,0,3;" + $witchh4 + "bmp\ber_sys\p_mode\shou\mozi\1_3.png",%Free3,%Free4 : add %Free4,%Free2 : inc %Free1 ;813
		spbtn %Free1 - 1,%Free8 : inc %Free8 ;スプライトをボタン化
	lsp %Free1,":ba/2,0,3;" + $witchh4 + "bmp\ber_sys\p_mode\shou\mozi\1_4.png",%Free3,%Free4 : add %Free4,%Free2 : inc %Free1 ;814
		spbtn %Free1 - 1,%Free8 : inc %Free8 ;スプライトをボタン化
	lsp %Free1,":ba/2,0,3;" + $witchh4 + "bmp\ber_sys\p_mode\shou\mozi\1_a1.png",%Free3,%Free4 : add %Free4,%Free2 : inc %Free1 ;815
		spbtn %Free1 - 1,%Free8 : inc %Free8 ;スプライトをボタン化


	;ボタン番号１〜５までをスプライトボタン登録。
	spbtn 764,1
	spbtn 763,2
	spbtn 762,3
	spbtn 761,4
	spbtn 760,5
				
	print 1
		btnwait2 %BtnRes 
				mov $witchh4,""
				notif %cur_language = 0 jumpf
					mov $witchh4, "en\"
				~

				if %BtnRes = -3 : goto *p_dai1_loop ;下ホイール
				if %BtnRes = -2 : goto *p_dai1_loop ;上ホイール
			if %btnres = 0 : goto *p_dai1_loop
				csp 850 : csp 849 : csp 861 

				if %BtnRes = -1 : se1 1000 : gosub *cha_btn_clear : goto *p_kakushou_loop ;右クリック
				if %BtnRes = 1 : se1 1000 : gosub *cha_btn_clear : goto *murder_story_sys ;物語を再読
				if %BtnRes = 2 : se1 1000 : gosub *cha_btn_clear : goto *zentei ;ルール
				if %BtnRes = 3 : se1 1000 : gosub *cha_btn_clear : goto *murder_p_word ;紫文字を読み返す
				if %BtnRes = 4 : se1 1000 : gosub *cha_btn_clear : goto *murder_hint_sys ;ヒント
				if %BtnRes = 5 : se1 1000 : gosub *cha_btn_clear : ld r,Ber_AkuwaraiA1,80 : gosub *ware_eff : gosub *murder_input_sys ;犯人入力
				if %BtnRes = 6 : se1 1000 : lsp 850,":bc;" + $witchh4 + "bmp\ber_sys\p_mode\shou\p_txt\1_1.png",522,84,250 : print 23
				if %BtnRes = 7 : se1 1000 : lsp 850,":bc;" + $witchh4 + "bmp\ber_sys\p_mode\shou\p_txt\1_2.png",522,84,250 : print 23
				if %BtnRes = 8 : se1 1000 : lsp 850,":bc;" + $witchh4 + "bmp\ber_sys\p_mode\shou\p_txt\1_3.png",522,84,250 : print 23
				if %BtnRes = 9 : se1 1000 : lsp 850,":bc;" + $witchh4 + "bmp\ber_sys\p_mode\shou\p_txt\1_4.png",522,84,250 : print 23
				if %BtnRes = 10 : se1 1000 : lsp 850,":bc;" + $witchh4 + "bmp\ber_sys\p_mode\shou\p_txt\1_a1.png",522,84,250 : print 23
		goto *p_dai1_loop

	gosub *p_picture_reset ;ボタンや背景エフェクトを表示するサブルーチン
	
return



