ut_mld c,":b;sprites\goh\1\goh_a11_komaru1.png",24
advsetwindow "17"

langjp「私も聞かされましたとも。@主に熊沢さんでした。」\
;＜郷田
langen:dwave 0, "voice\17\71700023.ogg":^"I heard it too.^@:dwave 0, "voice\17\71700024.ogg":^  From Kumasawa-san, mainly."^\

