advsetwindow "01"

langjp『す、……すごい……。@……こんなの、生まれて初めて見た……。』\
;＜若金蔵
langen:dwave 0, "voice\58\75600153.ogg":^"<...I-Incredible...^@:dwave 0, "voice\58\75600154.ogg":^  ...I've never seen anything like this...>"^\

