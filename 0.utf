advsetwindow "-1"
;ld c,BEA_defA1,22

langjp『私、英語わかるわ。』@
;＜ベアト
langen:dwave 0, "voice\59\70700007.ogg":^"<I speak English.>"^\
advsetwindow "-1"
;br
langjp　そう英語で言い、………美しい黄金の髪の女が、ハッチより降りてきた。\
langen^As she came down from the hatch, ...a woman with beautiful golden hair said this in English.^\
advsetwindow "-1"

langjp　この、むさ苦しき岩窟に、彼女という美しい存在は、@まるで天使が舞い降りてきたかのようにさえ、感じられた……。\
langen^In this filthy cavern, ^@^the appearance of one as beautiful as she was seemed like an angel descending upon us...^\
advsetwindow "01"

;ld l,BEA_defA1,0
;ld r,KI2_MajimeA1,24
;_ld l,":b;sprites\bea\1\bea_c11_def1.png",0
;_ld r,":b;sprites\ki2\1\ki2_a12_majime1.png",24

langjp『ようこそ、日本へ。@艦長はいますか。』@
;＜若金蔵
langen:dwave 0, "voice\58\75600091.ogg":^"<Welcome to Japan.^@:dwave 0, "voice\58\75600092.ogg":^  Is the captain there?>"^\
advsetwindow "-1"

;ld l,BEA_NayamuA1,80
;_ld l,":b;sprites\bea\1\bea_c11_nayamu1.png",80

langjp『艦長は死んだわ。@士官はあそこの彼だけよ。』\
;＜ベアト
langen:dwave 0, "voice\59\70700008.ogg":^"<The captain is dead.^@:dwave 0, "voice\59\70700009.ogg":^  That man over there is the only officer left.>"^\
advsetwindow "01"

;ld r,KI2_NayamuA1,80
;_ld r,":b;sprites\ki2\1\ki2_a11_nayamu1.png",80

langjp『お悔やみ申し上げます。@何かお手伝いは出来ますか？』@
;＜若金蔵
langen:dwave 0, "voice\58\75600093.ogg":^"<My condolences.^@:dwave 0, "voice\58\75600094.ogg":^  Can we do anything to assist you?>"^\
advsetwindow "-1"

;ld l,BEA_waraiA8,80
;_ld l,":b;sprites\bea\1\bea_c11_warai8.png",80

langjp『新鮮な空気と水が欲しいわ。@まだ息のある人間もいる。@休ませる場所が欲しいわ。』\
;＜ベアト
langen:dwave 0, "voice\59\70700010.ogg":^"<We'd like some fresh air and water.^@:dwave 0, "voice\59\70700011.ogg":^  Some of us are still having trouble breathing.^@:dwave 0, "voice\59\70700012.ogg":^  And we'd like a place to rest.>"^\
advsetwindow "01"

;ld r,KI2_NayamuA4,80
;_ld r,":b;sprites\ki2\1\ki2_a11_nayamu4.png",80

langjp『協力しましょう。@他に英語のわかる人間はいますか？』@
;＜若金蔵
langen:dwave 0, "voice\58\75600095.ogg":^"<We would be happy to help.^@:dwave 0, "voice\58\75600096.ogg":^  Do any of the others understand English?>"^\
advsetwindow "-1"

;ld l,BEA_NayamuA1,80
;_ld l,":b;sprites\bea\1\bea_c11_nayamu1.png",80

langjp『いたけどみんな死んだわ。@私だけよ。』\
;＜ベアト
langen:dwave 0, "voice\59\70700013.ogg":^"<The ones who did are all dead.^@:dwave 0, "voice\59\70700014.ogg":^  I'm the only one left.>"^\

bg black,23
;se1 12
bg new_sub_p2c,23
advsetwindow "-1"
;quakey 3,800

langjp「右代宮ッ、女は何を言っている？！@　艦長は誰だ？　さっきの男なのか？！@　その女は何者なのか！　早く通訳しろッ！！」\
langen:dwave 0, "voice\99\75700015.ogg":^"Ushiromiya!  What's that woman talking about?!^@:dwave 0, "voice\99\75700016.ogg":^  Who's the captain?  That man from a second ago?!^@:dwave 0, "voice\99\75700017.ogg":^  Who is that woman?!  Get translating already goddammit!!"^\
advsetwindow "-1"

langjp　中尉がさっきからうるさい。@
langen^The lieutenant has been yelling like that for a while now.^@
advsetwindow "-1"
;br
langjp　……まさか潜水艦から、美しいご婦人が現れるとは思わず、@しかもそれを私に独占されて悔しいに違いないな。@
langen^...He must've been surprised to see such a beautiful woman appear from a submarine...^@^and more than a little annoyed to see all of her attention focused on me alone.^@
advsetwindow "-1"
;br
langjp　それくらいに、……彼女は神々しくて美しかった。\
langen^It was a mark...of how divinely beautiful she was.^\

