_ld c,":b;sprites\ber\1\ber_a21_def2.png",23
advsetwindow "28"

langjp「決まってるじゃない。@……あんたに、真実に至るための道標を示すためよ。」@
;＜ベルン
langen:dwave 0, "voice\28\82100283.ogg":^"Isn't it obvious?^@:dwave 0, "voice\28\82100284.ogg":^  ...To show you the path that leads to the truth."^\

_ld r,":b;sprites\enj\1\enj_a11_fuman1.png",80
advsetwindow "11"

langjp「フェザリーヌが私に示してくれるの？」\
;＜縁寿
langen:dwave 0, "voice\11\82000881.ogg":^"You'll show me the way, Featherine?"^\


_ld l,":b;sprites\fea\1\fea_b11_def2.png",80
advsetwindow "50"

langjp「………私は観劇の魔女だ。@……舞台の上の役者に干渉することは、あまり好まぬのだがな。」\
;＜フェザ
langen:dwave 0, "voice\50\85000006.ogg":^"...Well, I am the Witch of Theatergoing,^@:dwave 0, "voice\50\85000007.ogg":^ ...though I dislike interfering with the actors on the stage."^\


