;＜縁寿
langen:dwave 0, "voice\11\62000456.ogg":^"It's like UFOs.^@:dwave 0, "voice\11\62000457.ogg":^  Everyone knows about them, but no one has ever seen them."^\

_ld r,":b;sprites\ama\1\ama_a11_akuwarai1.png",80
advsetwindow "20"

