		ld_p %tmp
		mov $tmp,$ld_pass
		if %tmp15 = 1 mov $tmp1,$tmp
		if %tmp15 = 2 mov $tmp2,$tmp
		if %tmp15 = 3 mov $tmp3,$tmp
	*bgm_mode_rnd_yomiage2_300
next
return
