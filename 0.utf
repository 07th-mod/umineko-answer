advsetwindow "15"

langjp「………私はずっと一人部屋で、ルームメイトは……。」\
;＜紗音
langen:dwave 0, "voice\15\70500244.ogg":^"...I've always had a single-person room, so I couldn't have had a..."^\

;bfly1 0
;bg rose_3bp,0
