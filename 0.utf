advsetwindow "27"

langjp「どうした。」@
;＜ベアト
langen:dwave 0, "voice\27\80700241.ogg":^"What's wrong?"^\
advsetwindow "03"

;ld r,NAT_DefA1,24

langjp「………私に、よくもそのようなことが言えたものだと、……驚いただけです。」\
;＜夏妃
langen:dwave 0, "voice\03\80900055.ogg":^"...I was just...surprised that I would dare to say such words..."^\
advsetwindow "27"

;bg mhal_2d,26
;ld l,BEA_DefA1,80

langjp「……………………。@……気にするな、妾のことは。」\
;＜ベアト
langen:dwave 0, "voice\27\80700242.ogg":^"......^@:dwave 0, "voice\27\80700243.ogg":^...You don't need to worry about me."^\
advsetwindow "03"

;ld r,NAT_DefA1,80

langjp「私が、あなたを拒絶してしまったから、……あなたはいくつもの世界で、辛い目に…。@……それは全て、私の責任です…。」\
;＜夏妃
langen:dwave 0, "voice\03\80900056.ogg":^"Because I rejected you, ...you met a painful fate in so many worlds...^@:dwave 0, "voice\03\80900057.ogg":^  ...All of that is my responsibility..."^\
advsetwindow "27"

;ld l,BEA_DefA1,80

langjp「そなたの気持ちもわかる。@……身篭れず、何年も肩身の狭い思いをしてきたのだ。@そこに突然、素性の知れぬ赤ん坊を渡され、養子にしろと言われたら、ショックを受けぬ女などおらぬ。」\
;＜ベアト
langen:dwave 0, "voice\27\80700244.ogg":^"I understand how you felt.^@:dwave 0, "voice\27\80700245.ogg":^  ...Unable to become pregnant, you were forced to feel shame for many years.^@:dwave 0, "voice\27\80700246.ogg":^  In that situation, any woman would be shocked if they were handed a baby whose parentage they didn't even know, ...and then told to adopt them."^\

;ld r,NAT_DefA1,80

bg black,22
advsetwindow "03"

