langjp「うん。@おうちで食べる…！！@　うー、うーうーうーうー！！」\
;＜真里亞
langen:dwave 0, "voice\13\70400151.ogg":^"Okay.^@:dwave 0, "voice\13\70400152.ogg":^  I'll eat it at home...!!^@:dwave 0, "voice\13\70400153.ogg":^  Uu-, uu-uu-uu-uu-!!"^\

