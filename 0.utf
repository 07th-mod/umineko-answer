;＜真里亞
langen:dwave 0, "voice\13\80400167.ogg":^"She's not an angel, she's a witch.^@:dwave 0, "voice\13\80400168.ogg":^  Ange's the final witch, ANGE Beatrice."^\

_ld c,":b;sprites\ros\1\ros_a11_komaru3.png",80
advsetwindow "12"

langjp「その魔法は、彼女を幸せにしてくれるかしら。」@
;＜楼座
langen:dwave 0, "voice\12\81400075.ogg":^"I wonder if that magic will bring her happiness."^\

cl l,0
