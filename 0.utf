advsetwindow "57"
;ld c,FEA_DefA1,6

langjp「それを理解した時。@……私は、知らぬことに宿る処女性にも似た高潔なる純粋さを理解したのだ。」@
;＜八城
langen:dwave 0, "voice\56\84900078.ogg":^"When I realized that,^@:dwave 0, "voice\56\84900079.ogg":^ ...I saw the noble purity resembling virginity...that exists in not knowing."^\
advsetwindow "28"

