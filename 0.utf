langen^Aunt Eva suddenly stumbled on something.^@
advsetwindow "-1"
langen^Then, she started counting on her fingers, starting from the first floor...^\

bg new_mhal_h1a,0
_ld c,":b;sprites\eva\1\eva_b25_odoroki1.png",22
advsetwindow "05"

langjp「わかったわ、縁寿ちゃん…！@　１階から順に、声に出して読んでみて…！@　１つしかないから！」\
;＜絵羽
langen:dwave 0, "voice\05\81000267.ogg":^"I've got it, Ange-chan...!^@:dwave 0, "voice\05\81000268.ogg":^  Try saying them aloud, starting from the first floor...!^@:dwave 0, "voice\05\81000269.ogg":^  There's only one that fits!"^\

