if %m_temp1 == 0 skip 2
lsp Save,":ba/2,0,3;bmp\system\save.png",10,%tmp1 : add %tmp1,%tmp2    ;ページ２
lsp Load,":ba/2,0,3;bmp\system\Load_b.png",10,%tmp1 : add %tmp1,%tmp2 
lsp rmenu_btn_Exit,":ba/2,0,3;bmp\system\exit.png",10,%tmp1


