bg new_different_space_1a,22
_ld l,":b;sprites\but\1\but_d11_nayamu4.png",22
advsetwindow "10"

langjp「次に、譲治犯人説を検証してみよう。@子供の犯人は１人しか存在できない。@よって、譲治の兄貴が犯人である時点で、絵羽伯母さんと秀吉伯父さん以外に、死んだフリが出来る人物は存在しない。」\
;＜戦人
langen:dwave 0, "voice\10\80100862.ogg":^"Next, let's try out theories with George as a culprit.^@:dwave 0, "voice\10\80100863.ogg":^  Only one child culprit can exist.^@:dwave 0, "voice\10\80100864.ogg":^  So, if George-aniki is a culprit, that means Aunt Eva and Uncle Hideyoshi are the only adults who could've been playing dead."^\

se1 57
mbg white,1
_ld r,":b;sprites\lam\1\lam_a11_akuwarai4.png",0
mcbg 22
advsetwindow "29"

langjp「大人２人に子供１人で、犯人は３人組？@　なるほど、それならこれまでの全ての事件に、説明がつけられそうね？」\
;＜ラムダ
langen:dwave 0, "voice\29\82200136.ogg":^"So, a three person group, with two adults and one kid?^@:dwave 0, "voice\29\82200137.ogg":^  I see, that sounds like it'd explain all the crimes so far, doesn't it?"^\

_ld l,":b;sprites\but\1\but_d11_futeki1.png",80
advsetwindow "10"

langjp「ところがどっこい！@　実はこれもありえねぇんだ。」\
;＜戦人
langen:dwave 0, "voice\10\80100865.ogg":^"But hold it!^@:dwave 0, "voice\10\80100866.ogg":^  That's actually impossible too."^\

_ld c,":b;sprites\bea\1\bea_a13_1_majime5star.png",24
advsetwindow "27"

langjp「うむ。@譲治が犯人であることは、明白に否定されている。」\
;＜ベアト
langen:dwave 0, "voice\27\80700627.ogg":^"Indeed.^@:dwave 0, "voice\27\80700628.ogg":^  It's clearly shown that George cannot be a culprit."^\

_ld r,":b;sprites\lam\1\lam_a11_futeki2.png",80
advsetwindow "29"

langjp「くす。@……そうなのよねぇ？@　子供に殺人可能なのは第四の晩の紗音のみ。」\
;＜ラムダ
langen:dwave 0, "voice\29\82200138.ogg":^"*giggle*^@:dwave 0, "voice\29\82200139.ogg":^  ...Pretty sharp.^@:dwave 0, "voice\29\82200140.ogg":^  The kids can only kill Shannon on the fourth twilight."^\

_ld c,":b;sprites\bea\1\bea_a13_1_majime6.png",80
advsetwindow "27"

langjp「紗音殺しについては、信頼できる紫発言で譲治には殺せないと、すでに断言されている…！」\
;＜ベアト
langen:dwave 0, "voice\27\80700629.ogg":^"A trustworthy purple statement has already proven that George couldn't have been the culprit in Shannon's murder...!"^\

_ld l,":b;sprites\but\1\but_d11_futeki3.png",80
advsetwindow "10"

langjp「そういうことだ。@紗音ちゃんの殺しについてのみ持つ、たった一つのアリバイ。@それが譲治の兄貴に、全ての事件において潔白であることを証明しているんだ…！」\
;＜戦人
langen:dwave 0, "voice\10\80100867.ogg":^"That's it.^@:dwave 0, "voice\10\80100868.ogg":^  Just one tiny alibi that only works for Shannon-chan's murder.^@:dwave 0, "voice\10\80100869.ogg":^  That's what proves George-aniki innocent for all of the crimes...!"^\

cl c,0
ut_mld c,":b;sprites\bea\1\bea_a13_akuwarai1.png",23
advsetwindow "27"

langjp「つまり、譲治はシロということだ…！@　となれば、譲治の紫発言は全て信頼できるものになるということだな…！」\
;＜ベアト
langen:dwave 0, "voice\27\80700630.ogg":^"So, we need not suspect George...!^@:dwave 0, "voice\27\80700631.ogg":^  Which means all of his purple statements can be relied upon...!"^\

mcl c,0

bg black,2

fede 0,1000
E_A

