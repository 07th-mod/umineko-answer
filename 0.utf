;***********************************************************************
;
;[プロジェクト]  うみねこのなく頃に
;[ファイル概要]  サークルロゴの表示
;[処理概要]      ソフト立ち上げ時に、サークルロゴを表示する
;
;***********************************************************************
*b_sakuru_logo

;デバック用命令
notif %show_cg_test = 1 jumpf

gosub *jump_sysdata_set1_1

if %cur_language = 0 langen
if %cur_language = 1 langjp

select "^~c4~EP1",*cgprep_ep1,"^~c4~EP2",*cgprep_ep2,"^~c4~EP3",*cgprep_ep3,"^~c4~EP4",*cgprep_ep4,"^~c4~WH Test",*whtest,"^~c4~Scrolltest",*scrolltest

~

	E_B
	E_MA
	saveoff            ;セーブオフで、処理を高速化する。
	erasetextwindow 0  ;テキストエフェクトを切る事で処理を高速化
	rmode 0            ;右クリックのメニュー表示の無効化
	textoff
	mov %coins,0 ;クイズモードのコインリセット
	mov %quiz_pass_flg,0
;スキップ用の変数が１になっていたらタイトルをスキップさせる
if %title_skip = 1 goto *b_sakuru_logo_shuuryou

;ボタンが押しっぱなしになっていたらタイトルをスキップさせる。
isdown %tmp
if %tmp = 1 goto *b_sakuru_logo_shuuryou

;-----------------------
;サークルロゴの表示
   ;左右クリックで、ロゴの表示を飛ばして終了処理、タイトル画面へ進む   

   lr_trap *b_sakuru_logo_shuuryou
	btndef ""
	btntime 2000
	btnwait2 %tmp
	
	notif %tmp = -5 goto *b_sakuru_logo_shuuryou

	;seplay 7,1031
	;lsp 100,":bc;bmp\title\Circle_logo\circle_logo.png",0,0
	;print 99,3000,"trvswave.dll/h"
	;delay 3000
	;csp 100
	;print 2
	lsp 100,":bc;bmp\title\Circle_logo\07th-mod.png",0,0
    print 2
    csp 100
    delay 3000
	lsp 101,":bc;bmp\title\Circle_logo\alchemist.png",0,0
	print 2
	csp 101
	delay 3000
	lsp 102,":bc;bmp\title\Circle_logo\07th.png",0,0
	print 2
	csp 102
	delay 3000
	csp 103
	print 2
	

	notif %tmp = -5 mov %title_skip,1
	csp 100
	print 2

	; サークルロゴの表示終了処理
	goto *b_sakuru_logo_skip_100

		*b_sakuru_logo_shuuryou
		mov %title_skip,1			;タイトルスキップON
	*b_sakuru_logo_skip_100
	lr_trap off				;クリックトラップの解除


  rmode 1
 ;右クリックのメニュー表示を有効にする。
  erasetextwindow 1			;テキスト透過度落としをＯＮにする。
;setwindow 84,36,31,20,26,26,0,2,20,1,1,#999999,0,0,960,540 ;utmeta-delete
windoweffect 50,200
beginADVSection
advsetwindow "-1"
  btndef ""
  saveoff
  csp -1
  if %title_skip = 1 goto *b_title

  goto *b_title				;タイトル画面へ

;******************************************************************************

;***********************************************************************
;
;[プロジェクト] 	うみねこのなく頃に
;[ファイル概要] 	タイトルの表示
;[処理概要]		タイトル画面の表示
;[製作]			ＢＴ
;フラグ管理用変数　	
;
;***********************************************************************
*b_title

;-----------------------------------------
;各フラグ変数の初期化処理
;-----------------------------------------

mono 0

;キャラの状態をリセットする
for %tmp = 1 to cha_kazu_ep5
	mov ?r[%scenario_Number][%tmp][condition],0
next

;右クリックシステム、選択キャラ、Tips表示をなし（０）に初期化
mov %r_hyouji_cha,0
mov %r_hyouji_cha_ma,0
mov %r_hyouji_tips,0
mov %r_for_title,0
mov %r_tea_bea,0
mov %r_ber_flg,0
mov %rmordflg,off	;右クリックOFFを解除
mov %save_on_flg,on	;セーブON命令を動作させる。

;右クリック、お茶フラグ
mov %r_u_tea_flg,0

mov %bgm_mood_file_path_flg,0

;tips配列の初期化
for %tmp = 0 to 10
	mov ?tips[%tmp][tips_flg],0
next

;シーン変数を初期化
mov %play_scene,0

;-----------------------------------------

;   Ｂｇｍスタート
;  初期化とホワイトアウト
E_B
E_MA

;シナリオ１クリア後とクリア前で背景、Meを変える
if %UMINEKOEND = 0 me1 2 : mov $tmp10,cliff_1b
if %UMINEKOEND = 51 me1 2 : mov $tmp10,cliff_1b
if %UMINEKOEND = 52 me1 2 : mov $tmp10,cliff_1b

if %UMINEKOEND = 60 me1v 16,50 : mov $tmp10,":b;bmp\title\ep5_end.png"	;EP5表裏終了
if %UMINEKOEND = 61 me1v 16,50 : mov $tmp10,":b;bmp\title\ep5_end.png"	;EP6シナリオ終了
if %UMINEKOEND = 62 me1v 16,50 : mov $tmp10,":b;bmp\title\ep5_end.png"	;EP6表お茶終了

if %UMINEKOEND = 70 meplay 1,2 : mov $tmp10,":b;bmp\title\ep6_end.png"	;EP6表裏終了
if %UMINEKOEND = 71 meplay 1,2 : mov $tmp10,":b;bmp\background\efe\the_1e.bmp" ;EP7シナリオ終了
if %UMINEKOEND = 72 meplay 1,2 : mov $tmp10,":b;bmp\background\efe\the_1e.bmp" ;EP7表お茶終了

if %UMINEKOEND = 80 meplay 1,2 : mov $tmp10,":b;bmp\title\ep7_end.png"	;EP7表裏終了/EP8スタート画面
if %UMINEKOEND = 81 meplay 1,2 : mov $tmp10,":b;bmp\title\ep8_h_end.png" ;EP8シナリオ終了
if %UMINEKOEND = 82 meplay 1,2 : mov $tmp10,":b;bmp\title\ep8_h_end.png" ;EP8お茶会終了
if %UMINEKOEND >= 90 meplay 1,2 : mov $tmp10,":b;bmp\title\ep8_end.png" ;全て終了？

mov %title_y,140

csp -1                               ;スプライト画像の、メモリからの消去
btndef ""                            ;ボタン画像の、メモリからの消去
setwindow 191,16,25,20,23,23,0,2,20,1,1,#ffffff,0,0,960,540
;setwindow 31,16,22,16,26,26,0,2,20,1,1,#ffffff,0,0,639,479
;順番に画像を表示していく（背景、ロゴ、各種ボタンの画像をメモリに読み込む）


;背景の表示

lsph t_hane_lsp,":b;bmp\title\hana.png",577,11,150
lsph t_logo_lsp,":b;bmp\title\logo.png",530,10


;----------------------
;ボタンの配置

	lsph t_btn_start_lsp,":b/2,0,3;bmp\title\title_menu\start.png",727,164	;146
	lsph t_btn_web_lsp,":b/2,0,3;bmp\title\website.png",728,453
	lsph t_btn_controls_lsp,":b/2,0,3;bmp\title\title_menu\web.png",727,200

	if %UMINEKOEND = 0 lsph t_btn_exit_lsp,":b/2,0,3;bmp\title\title_menu\exit1.png",727,236		;210
	if %UMINEKOEND = 51 lsph t_btn_exit_lsp,":b/2,0,3;bmp\title\title_menu\exit2.png",727,273	;242
	if %UMINEKOEND = 52 lsph t_btn_exit_lsp,":b/2,0,3;bmp\title\title_menu\exit3.png",727,309	;274
	if %UMINEKOEND >= 60 && %UMINEKOEND < 90 lsph t_btn_exit_lsp,":b/2,0,3;bmp\title\title_menu\exit4.png",727,345	;306
	if %UMINEKOEND >= 90 lsph t_btn_exit_lsp,":b/2,0,3;bmp\title\title_menu\exit5.png",727,380	;338

	;クリアフラグによってボタンの表示、非表示、EXITの高さを行う。
	if %UMINEKOEND >= 51 lsph t_btn_tea_lsp,":b/2,0,3;bmp\title\title_menu\tea.png",727,236		;210
	if %UMINEKOEND >= 52 lsph t_btn_ura_tea_lsp,":b/2,0,3;bmp\title\title_menu\ura_tea.png",727,273	;242
	if %UMINEKOEND >= 60 lsph t_btn_tips_lsp,":b/2,0,3;bmp\title\title_menu\tips.png",727,309	;274
	if %UMINEKOEND >= 90 lsph t_btn_music_lsp,":b/2,0,3;bmp\title\title_menu\music.png",727,345	;306

	;新要素追加時（新要素追加のフラグ変数が所定の値になっている時には、表示するボタンを切り替える）
	if %UMINEKOEND_FLG = 51 lsph t_btn_tea_lsp,":b/2,0,3;bmp\title\title_menu\new_tea.png",727,236	;210
	if %UMINEKOEND_FLG = 52 lsph t_btn_ura_tea_lsp,":b/2,0,3;bmp\title\title_menu\new_ura_tea.png",727,273	;242
	if %UMINEKOEND_TIPS_FLG = 5 lsph t_btn_tips_lsp,":b/2,0,3;bmp\title\title_menu\new_tips.png",727,309	;274

	if %UMINEKOEND_FLG = 60 lsph t_btn_start_lsp,":b/2,0,3;bmp\title\title_menu\new_start.png",727,164	;146 
	if %UMINEKOEND_FLG = 61 lsph t_btn_tea_lsp,":b/2,0,3;bmp\title\title_menu\new_tea.png",727,273		;242
	if %UMINEKOEND_FLG = 62 lsph t_btn_ura_tea_lsp,":b/2,0,3;bmp\title\title_menu\new_ura_tea.png",727,309	;274
	if %UMINEKOEND_TIPS_FLG = 6 lsph t_btn_tips_lsp,":b/2,0,3;bmp\title\title_menu\new_tips.png",727,345	;306

