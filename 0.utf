_ld l,":b;sprites\kin\1\kin_a11_warai2.png",80
advsetwindow "01"

langjp「報われておるとも。@先ほどの縁寿の微笑みが思い出せれば。@私は今夜、お迎えが来ても一向に構わんぞ。@わっはははははははは……。」\
;＜金蔵
langen:dwave 0, "voice\01\81500228.ogg":^"Oh, but I have been rewarded.^@:dwave 0, "voice\01\81500229.ogg":^  With Ange's smile just now to look back upon,^@:dwave 0, "voice\01\81500230.ogg":^ I could happily pass on in my sleep tonight.^@:dwave 0, "voice\01\81500231.ogg":^  Wahhahahahahahahaha..."^\

