*r_tips_botann_ep5_2

	mov %tmp,ma5_lam_btn_lsp : add %tmp,cha_kazu_ep5_2

	for %tmp2 = ma5_lam_btn_lsp to %tmp : csp %tmp2 :next
	for %tmp2 = tips1_lsp to tips1_lsp : csp %tmp2 :next

	csp r_tips_txt_lsp
	csp tips_next_lsp
	csp tips_back_lsp
	csp r_cha_back_lsp
	vsp r_hana_lsp,1
	csp r_next2_lsp

