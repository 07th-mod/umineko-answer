;＜ウィル
langen:dwave 0, "voice\54\75400957.ogg":^"However, the Lion of this world was not given special treatment.^@:dwave 0, "voice\54\75400958.ogg":^  The silver ring doesn't actually exist."^\

_ld l,":b;sprites\rio\1\rio_a11_majime1.png",80
advsetwindow "53"

langjp「お祖父さまのお耳には入れなかった、ということでしょうか。」\
;＜理御
langen:dwave 0, "voice\53\75300465.ogg":^"I wonder if that means Grandfather never heard about me."^\

_ld r,":b;sprites\wil\1\wil_a11_nayamu1.png",80
advsetwindow "54"

