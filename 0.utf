*KLA_hazure
;■不正解の場合（「３階」以外）

bg new_mhal_h1c,0
ut_mld l,":b;sprites\en2\1\en2_a15_def2b.png",22
advsetwindow "11"

langjp「………わかんない。」@
;＜縁寿
langen:dwave 0, "voice\11\82000586.ogg":^"...I don't get it."^\

_ld r,":b;sprites\eva\1\eva_b25_ikari1.png",24
advsetwindow "05"

langjp「これ、何階かじゃなくて、何“がい”か、ってのがポイントなのね？」\
;＜絵羽
langen:dwave 0, "voice\05\81000270.ogg":^"It's `the ＿th floor', not `floor X'.  That's the trick."^\

_ld c,":b;sprites\cla\1\cla_a11_akuwarai2.png",24
advsetwindow "02"

langjp「そうだ。@ある意味、出題の時点ですでに答えを示しているがね。」@
;＜蔵臼
langen:dwave 0, "voice\02\80800069.ogg":^"That's right.^@:dwave 0, "voice\02\80800070.ogg":^  Though, in a way, the answer is right there in the question."^\

ut_mld l,":b;sprites\en2\1\en2_a15_def2.png",80
advsetwindow "11"

langjp「どういうこと…？」\
;＜縁寿
langen:dwave 0, "voice\11\82000587.ogg":^"What do you mean...?"^\

_ld r,":b;sprites\eva\1\eva_b25_majime1.png",80
advsetwindow "05"

langjp「例えばだけど、１４階ってあるわよね？@　１４階は、１４カイとも１４ガイとも読むわよね？@　でも１階は１カイとは読んでも、１ガイとは読まない。」\
;＜絵羽
langen:dwave 0, "voice\05\81000271.ogg":^"For example, let's take floor 7.^@:dwave 0, "voice\05\81000272.ogg":^  You'd call that `the seventh floor', right?^@:dwave 0, "voice\05\81000273.ogg":^  But you wouldn't call floor 3 `the threeth floor', would you?"^\

_ld c,":b;sprites\cla\1\cla_a11_akuwarai1.png",80
advsetwindow "02"

langjp「そういうことだ。@１階から１１階までの間で、ガイと読むのは１つしかない。」\
;＜蔵臼
langen:dwave 0, "voice\02\80800071.ogg":^"Precisely.^@:dwave 0, "voice\02\80800072.ogg":^  From floor 1 to floor 4, there's only one floor that ends in `th'."^\

ut_mld l,":b;sprites\en2\1\en2_a11_def3a.png",80
advsetwindow "11"

langjp「あ、………あー…………。」\
;＜縁寿
langen:dwave 0, "voice\11\82000588.ogg":^"A...Ah......"^\

mcl l,0
bg black,22
advsetwindow "-1"

langjp　私も今頃になって答えがわかる。@
langjp　出題された時の、蔵臼伯父さんのちょっとした発音の違和感に気付いていれば……。\
langen^By this point, even I had figured out the answer.^@
advsetwindow "-1"
langen^If only I'd paid a bit more attention to the way Uncle Krauss said the question...^\

;ld c,KLA_DefA1,80
bg new_mhal_2d,22
advsetwindow "02"

langjp「はっはははははは。@悪いね。@伯父さんのメダルは、お預けだ。」\
;＜蔵臼
langen:dwave 0, "voice\02\80800073.ogg":^"Hahahahahahaha.^@:dwave 0, "voice\02\80800074.ogg":^  Too bad.^@:dwave 0, "voice\02\80800075.ogg":^  Looks like I'll be keeping this medal."^\

;★合流地点へ
goto *NATKLA_quizend



*KLA_atari
