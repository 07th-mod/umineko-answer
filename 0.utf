langen:dwave 0, "voice\28\82100269.ogg":^"......Me, ...invite you over?^@/
ut_mld c,":b;sprites\ber\1\ber_a21_akuwarai3.png",80
advsetwindow "28"
langjp　…………くすくす、…………あっはっはっは。」\
