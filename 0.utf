		if %tips_page = 1 mov $r_tips_txt_path,"bmp\r_click\text\tips\ep7\2_1.png"
		if %tips_page = 2 mov $r_tips_txt_path,"bmp\r_click\text\tips\ep7\2_2.png"
		if %tips_page = 3 mov $r_tips_txt_path,"bmp\r_click\text\tips\ep7\2_3.png"

	;ＥＰ８　ＴＩＰＳ
	*tips_ep8_side2
	notif %scenario_Number = 8 goto *tips_end
	notif %r_hyouji_tips = 1 goto *tips_ep8_side2_2
		cell tips1_lsp,1
		if %tips_page = 1 mov $r_tips_txt_path,"bmp\r_click\text\tips\ep8\1_1.png"
		if %tips_page = 2 mov $r_tips_txt_path,"bmp\r_click\text\tips\ep8\1_2.png"

	*tips_ep8_side2_2
	notif %r_hyouji_tips = 2 goto *tips_ep8_side2_3
		cell tips2_lsp,1
		if %tips_page = 1 mov $r_tips_txt_path,"bmp\r_click\text\tips\ep8\2_1.png"
		if %tips_page = 2 mov $r_tips_txt_path,"bmp\r_click\text\tips\ep8\2_2.png"
		if %tips_page = 3 mov $r_tips_txt_path,"bmp\r_click\text\tips\ep8\2_3.png"

	*tips_ep8_side2_3
