*hinto_19
mov %play_scene,80110 ;シーン変数の入力

mov %r_hyouji_side,0
mov %r_hyouji_cha,but
;■大人２人、子供１人。
mov %BUT_Isyou,2

bgm1 125

bg new_different_space_1a,22
_ld c,":b;sprites\but\1\but_d11_majime2.png",22
advsetwindow "10"

langjp「まず、犯人は複数犯である。@これは確定してる。@単独犯では不可能な事件なんだ。」\
;＜戦人
langen:dwave 0, "voice\10\80100878.ogg":^"First off, there are multiple culprits.^@:dwave 0, "voice\10\80100879.ogg":^  That's confirmed.^@:dwave 0, "voice\10\80100880.ogg":^  These crimes would be impossible for a single person."^\

_ld r,":b;sprites\bea\1\bea_a11_1_majime3star.png",24
advsetwindow "27"

langjp「まず大人の犯人が１人。@第一の晩を実行し、犠牲者のフリをしてやり過ごした。」\
;＜ベアト
langen:dwave 0, "voice\27\80700638.ogg":^"To start, ^@:dwave 0, "voice\27\80700639.ogg":^one of the adult culprits carried out the first twilight, then played dead."^\

cl c,0
_ld l,":b;sprites\but\1\but_d11_majime4.png",24
advsetwindow "10"

langjp「マスターキーを持つ使用人全員がシロであることが確定しているため、@犯人に、食堂の扉を外から施錠する方法は存在しない。@よって、施錠者は室内にいると断言できるからだ。」\
;＜戦人
langen:dwave 0, "voice\10\80100881.ogg":^"Since we know that all of the servants with master keys were innocent,^@:dwave 0, "voice\10\80100882.ogg":^ there was no way for the culprit to lock the door to the dining hall from the outside.^@:dwave 0, "voice\10\80100883.ogg":^  So, we know the one who locked it did so from inside the room."^\

_ld r,":b;sprites\bea\1\bea_a11_akuwarai1.png",80
advsetwindow "27"

langjp「そして、死んだフリをするためには、@検死を偽ってくれるもう１人の犯人が必要になる。」\
;＜ベアト
langen:dwave 0, "voice\27\80700640.ogg":^"And, in order for them to play dead,^@:dwave 0, "voice\27\80700641.ogg":^ they needed another culprit to lie when examining their death."^\

_ld l,":b;sprites\but\1\but_d11_komaru2.png",80
advsetwindow "10"

langjp「源次さんがシロである以上、残る５人の大人の検死者は各々の子供。@つまり、犯人の子供が、２人目の犯人となる。」\
;＜戦人
langen:dwave 0, "voice\10\80100884.ogg":^"Genji-san is innocent, and the examinations of all five suspicious victims were performed by their own children.^@:dwave 0, "voice\10\80100885.ogg":^  So, the child of the first culprit is the second culprit."^\

_ld r,":b;sprites\bea\1\bea_a11_1_majime6.png",80
advsetwindow "27"

langjp「そして、子供の犯人にはゲストハウス以降の事件を実行できない。@しかし、大人の犯人は夏妃の部屋に閉じ込められている。@その為、２人目の大人の犯人が必要になる。」\
;＜ベアト
langen:dwave 0, "voice\27\80700642.ogg":^"And, the child culprit couldn't carry out the crimes once they start occurring in the guesthouse.^@:dwave 0, "voice\27\80700643.ogg":^  However, the adult culprit was sealed up in Natsuhi's room.^@:dwave 0, "voice\27\80700644.ogg":^  So, a second adult culprit was needed."^\

_ld l,":b;sprites\but\1\but_d11_nayamu2.png",80
advsetwindow "10"

langjp「大人２人、子供１人。@これが犯人グループの構成ってわけだ。」\
;＜戦人
langen:dwave 0, "voice\10\80100886.ogg":^"Two adults, one kid.^@:dwave 0, "voice\10\80100887.ogg":^  That's what our culprit group looks like."^\

bg black,2
fede 0,1000
E_A

