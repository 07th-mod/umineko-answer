*bgm_mode_umineko
	if %bgm_mood_demo = 1 goto *demo_hyouji
	gosub *bgm_mode_k ;: print 22
	gosub *bgm_play

	mov $tmp,":c;" 
	add $tmp,"bgm_mode\ss\umineko1.bmp"
	lsp 510,$tmp,0,0
	print 22

	delay 1000
	
	*bgm_mode_umineko_1000
	trap off	

	mov $tmp,":c;" 
	add $tmp,"bgm_mode\ss\umineko1.bmp"
	lsp 510,$tmp,0,0

      lsp bgm_title_lsp,":s#FFFFFF^ Title: うみねこのなく頃に [When the Seagulls Cry]^",%bgm_x,%bgm_y1
      lsp bgm_sakka_lsp,":s#FFFFFF^ Artist: 志方あきこ [Shikata Akiko]^",%bgm_x,%bgm_y2
      lsp bgm_time_lsp,":s#FFFFFF^ Time: 1:28^",%bgm_x,%bgm_y3

      gosub *bgm_mode_h2
      print 2
   gettimer %3801:sub %bm_pt,%3801 ;曲の残り時間を入力
goto *bgm_mode_btn_lp


