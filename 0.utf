goto *quiz
;■源次の出題
;５ｃｍの長さの火のついたロウソクがある。@
;このロウソクは１時間ごとに、その時の長さの;半分まで燃えていく。@
;そうして、長さが１ｃｍ以下になると火は消えてしまう。@
; We have a lit candle five centimeters in length.
; Every hour, half of that candle's remaining length is burned away.
; Then, when its length is 1 centimeter or less, the flame will disappear.

;３時間後に火は消えていたが、この時、ロウソクの長さは何ｍｍあるだろう？@
;Three hours later, the flame had disappeared, but what was the length of the candle at that time?

;選択肢５つ。@「０ｍｍ」「約３ｍｍ」「約６ｍｍ」「約８ｍｍ」「約１０ｍｍ」
; A. "0mm" B. "About 3mm" C. "About 6mm" D. "About 8mm" E. "About 10mm"
;■選択後、以下に進む

;■ヒント
*eva_hinto_4
bg black,22
mono 2
lsp 840,":a;bmp\efe\l_m.bmp",250,150,180
indicateNVLSection
setwindow 165,16,25,20,26,26,0,2,20,1,1,#999999,0,0,960,540;utmeta-start;<NO_TEXT_START>212915
;locate 0,4;utmeta-setwindow
;ld c,EVA_DefA1,80
print 22
;advsetwindow "05"
langjp「１時間ごとにその時の長さの半分が燃えるのね…？@/
locate 0, 5 ;<CENTER_TEXT>
langen:dwave 0, "voice\05\81000215.ogg":^"Half of its remaining length burns away each hour, right...?^@/
lsp 840,":a;bmp\efe\l_m.bmp",250,230,180
print 22
;advsetwindow "05"
langjp　最初の１時間で５ｃｍの半分。@/
langen:dwave 0, "voice\05\81000216.ogg":^  After the first hour, it's burned down by half of 5 centimeters.^@/
lsp 840,":a;bmp\efe\l_m.bmp",250,290,180
print 22
;advsetwindow "05"
langjpそれが次の１時間でさらに半分。@/
langen:dwave 0, "voice\05\81000217.ogg":^  During the next hour, it burns down half of that remaining length.^@/
lsp 840,":a;bmp\efe\l_m.bmp",250,320,180
print 22
;advsetwindow "05"
langjpそして３時間目でさらに半分……。」\
;＜絵羽
langen:dwave 0, "voice\05\81000218.ogg":^  And during the third hour, it burns down half of that remaining length..."^\
;advsetwindow "11"

;ld c,EN2_DefA1,80
;locate 0,4;utmeta-break
langjp「……電卓ないとよくわかんない。@伯母さん、わかる？」\
;＜縁寿
locate 0, 6 ;<CENTER_TEXT>
langen:dwave 0, "voice\11\82000538.ogg":^"...I can't really do it without a calculator.^@:dwave 0, "voice\11\82000539.ogg":^  Do you know the answer, Aunt Eva?"^\

csp 840
print 0 
bg black,22
mono 0
bg new_mhal_h1a,0
_ld c,":b;sprites\eva\1\eva_a11_akire1.png",22
_ld c,":b;sprites\eva\1\eva_a11_warai1.png",80
beginADVSection
advsetwindow "-1"
advsetwindow "05"
langjp「あ、……わーかった。@くす、意地悪な問題だわ、これ。」\
;＜絵羽
langen:dwave 0, "voice\05\81000219.ogg":^"Ah, ...I've got it.^@:dwave 0, "voice\05\81000220.ogg":^  *giggle*  This is a pretty mean puzzle."^\

_ld r,":b;sprites\en2\1\en2_a15_def2.png",24
advsetwindow "11"

langjp「意地悪って？」@
;＜縁寿
langen:dwave 0, "voice\11\82000540.ogg":^"Why is it mean?"^\

_ld c,":b;sprites\eva\1\eva_a11_def1.png",80
advsetwindow "05"

langjp「これ、割り算は関係ないわ。@よく問題の文章を読み返してみて？」\
