bg new_mhal_h1a,0
_ld l,":b;sprites\jes\1\jes_a11_atya3.png",22
advsetwindow "04"

langjp「縁寿〜、本当にその赤い箱でいいのかぃ…？@　すっごく怖いのが飛び出すかもしれねぇぜぇえぇぇ…？@　やっぱり、青い箱にチェンジした方がいいんじゃねぇの〜…？」@
;＜朱志香
langen:dwave 0, "voice\04\80200059.ogg":^"Ange, are you sure you want the red box...?^@:dwave 0, "voice\04\80200060.ogg":^  Something really scary might come flying out, okay...?^@:dwave 0, "voice\04\80200061.ogg":^  Are you sure you don't want to switch to the blue box...?"^\

ut_mld c,":b;sprites\en2\1\en2_a11_def4b.png",24
advsetwindow "11"

langjp「怖くないっ。@縁寿は赤い箱でいいの、いいのっ！」\
;＜縁寿
langen:dwave 0, "voice\11\82000741.ogg":^"I'm not scared!^@:dwave 0, "voice\11\82000742.ogg":^  I'll stick with the red box!"^\

_ld r,":b;sprites\geo\1\geo_a11_warai1.png",24
advsetwindow "07"

langjp「ははははは、脅し過ぎだよ、朱志香ちゃん。@さぁ、これで箱は１つ減って、２つになっちゃったね。@さぁ、ここからが問題だよ、縁寿ちゃん。」@
;＜譲治
langen:dwave 0, "voice\07\80300064.ogg":^"Hahahahaha, you're going a bit overboard, Jessica-chan.^@:dwave 0, "voice\07\80300065.ogg":^  So, one of the boxes is now gone, and there's only two left.^@:dwave 0, "voice\07\80300066.ogg":^  This is where the puzzle starts, Ange-chan."^\

ut_mld c,":b;sprites\en2\1\en2_a11_def2a.png",80
advsetwindow "11"

langjp「どっちの箱にメダルが入っているか？」\
;＜縁寿
langen:dwave 0, "voice\11\82000743.ogg":^"You mean, which box is the medal in?"^\

_ld r,":b;sprites\geo\1\geo_a11_hohoemi1.png",80
advsetwindow "07"

langjp「縁寿ちゃんの前に、さっきから置きっ放しにしているその赤い箱と、僕の前にあるこの青い箱。@どっちを開けた方が、メダルの入ってる可能性が高いかな？@　それが問題さ。」\
;＜譲治
langen:dwave 0, "voice\07\80300067.ogg":^"We have the red box that's been sitting in front of you the whole time, and the blue box here in front of me.^@:dwave 0, "voice\07\80300068.ogg":^  Which has a higher probability of having a medal inside it?^@:dwave 0, "voice\07\80300069.ogg":^  That's the puzzle."^\

mcl c,0
bg black,22

goto *quiz
;■譲治と朱志香の出題
;　赤い箱と青い箱と緑の箱がある。@
;　このうち１つにはメダルが入っている。@
;　残りの２つは恐ろしいビックリ箱になっている。@
;　私は赤い箱を選んだ。@
;　そしたら朱志香は言った。@
;「本当にそれでいいのかい？@　ビックリ箱はすごく怖いんだぜ。@１個開けて見せてやるからな。」@
;　そう言って緑の箱を開き、それがビックリ箱であることを示してくれた。@
;　残るのは、赤い箱と青い箱の２つだけ。@
;「その赤い箱を開くかい？@　それともチェンジするかい？」@
; There are three boxes: a red one, a blue one, and a green one.
; One of those boxes has a medal inside.
; The other two have terrifying traps inside.
; I picked the red box.
; Then, Jessica spoke:
; "Are you sure you want that one?  The trap boxes are really terrifying. I'll open one and show you."
; ...And she opened the green box, showing me that it was a trap box.
; Only the red box and the blue box were left.
; "Do you want me to open the red box?  Or do you want to switch?"

;　さて。@赤い箱と青い箱。@どちらにメダルが入っている確率が高いだろう…？@
; So, which box has a higher probability of holding the medal, the red box or the blue box...?

;選択肢３つ。@「赤い箱の方が高い」「どちらも同じ」「青い箱の方が高い」
; A. "The red box has a higher probability" B. "They're both the same" C. "The blue box has a higher probability"


;■ヒント
*eva_hinto_13
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2

bg black,22
bg new_mhal_h1c,0
_ld r,":b;sprites\en2\1\en2_a11_def2.png",22
advsetwindow "11"

langjp「中身がわからなくて、箱が２つなら、メダルが入ってる確率は５分と５分。@……どっちも同じじゃないの？」@
;＜縁寿
langen:dwave 0, "voice\11\82000744.ogg":^"Even though we don't know what's inside, there are two boxes, so there's a 50-50 chance of the medal being in either.^@:dwave 0, "voice\11\82000745.ogg":^  ...They're both the same, aren't they?"^\

_ld l,":b;sprites\eva\1\eva_b25_odoroki1.png",23
advsetwindow "05"

langjp「……伯母さんもそう思うんだけどねぇ。@でも、それじゃ答えが当り前過ぎるでしょう？@　何か一捻りあるんじゃないかしら……。」\
;＜絵羽
langen:dwave 0, "voice\05\81000458.ogg":^"...I thought that too.^@:dwave 0, "voice\05\81000459.ogg":^  Still, that would make the answer too obvious, wouldn't it?^@:dwave 0, "voice\05\81000460.ogg":^  I wonder if there's some trick here..."^\

bg black,22
advsetwindow "-1"
langjp　と、思わせて実は率直な答えが正解、という引っ掛けもずいぶんあった。@
langen^Or, that itself might be the trick, and the obvious answer could be the right one.^@
advsetwindow "-1"
;br
langjp　考え過ぎたり、疑い過ぎたりすると足元をすくわれるタイプの、典型的な問題かもしれない。\
langen^It might be one of those classic puzzles that trips you up by making you think too hard and suspiciously.^\

bg new_mhal_h1a,24
_ld r,":b;sprites\eva\1\eva_b25_hohoemi1.png",24
advsetwindow "05"

langjp「…………………………。@私から二人に、２つ質問があるけど、いい？」@
;＜絵羽
langen:dwave 0, "voice\05\81000461.ogg":^"......^@:dwave 0, "voice\05\81000462.ogg":^I have two questions for you two.  Is that okay?"^\

_ld c,":b;sprites\geo\1\geo_a11_def1.png",23
advsetwindow "07"

langjp「どうぞ。」\
;＜譲治
langen:dwave 0, "voice\07\80300070.ogg":^"Go ahead."^\

_ld r,":b;sprites\eva\1\eva_b25_majime1.png",80
advsetwindow "05"

langjp「この三色の箱は誰のもの？@　朱志香ちゃんの？」@
;＜絵羽
langen:dwave 0, "voice\05\81000463.ogg":^"Who do these three boxes belong to?^@:dwave 0, "voice\05\81000464.ogg":^  You, Jessica-chan?"^\

_ld l,":b;sprites\jes\1\jes_a11_warai1.png",23
advsetwindow "04"

langjp「はい、そうですけど。」\
;＜朱志香
langen:dwave 0, "voice\04\80200062.ogg":^"Well, yeah."^\

_ld r,":b;sprites\eva\1\eva_b25_akire2go.png",80
advsetwindow "05"

langjp「つまり、どの色がビックリ箱か、あなたは知っているのね？」@
;＜絵羽
langen:dwave 0, "voice\05\81000465.ogg":^"In other words, you know which colors are traps, right?"^\

_ld l,":b;sprites\jes\1\jes_a11_futeki1.png",80
advsetwindow "04"

langjp「えぇ、もちろん。」\
;＜朱志香
langen:dwave 0, "voice\04\80200063.ogg":^"Yeah, of course."^\

bg black,23
bg new_mhal_h1c,23
_ld l,":b;sprites\eva\1\eva_a11_hohoemi1.png",23
advsetwindow "05"

langjp「ありがとう。@引き続き、２つ目の質問ね。@朱志香ちゃんはさっき、ビックリ箱の怖さを教えるためにと、１つ開けてくれたわね？@　それは、縁寿ちゃんがどの箱を選んだとしてもやっていた？」\
;＜絵羽
langen:dwave 0, "voice\05\81000466.ogg":^"Thanks.^@:dwave 0, "voice\05\81000467.ogg":^  And now for my second question.^@:dwave 0, "voice\05\81000468.ogg":^  A second ago, you opened one of the boxes to show us how scary the traps were.^@:dwave 0, "voice\05\81000469.ogg":^  Would you have done that no matter which of the boxes Ange-chan chose?"^\

_ld r,":b;sprites\jes\1\jes_a11_warai1.png",24
advsetwindow "04"

langjp「そうです。@せっかくなんで、怖がらせた方が心理戦っぽくて面白いかなーって思って。」@
;＜朱志香
langen:dwave 0, "voice\04\80200064.ogg":^"That's right.^@:dwave 0, "voice\04\80200065.ogg":^  I figured giving her a bit of a scare would make for a nice psychological warfare tactic."^\

_ld l,":b;sprites\eva\1\eva_a11_warai1.png",80
advsetwindow "05"

langjp「ありがとう。@ヒントはそれで充分よ。」\
;＜絵羽
langen:dwave 0, "voice\05\81000470.ogg":^"Thanks.^@:dwave 0, "voice\05\81000471.ogg":^  Those hints will be enough."^\

ut_mld c,":b;sprites\en2\1\en2_a11_def3a.png",23
advsetwindow "11"

langjp「ヒント？@　え……？？」@
;＜縁寿
langen:dwave 0, "voice\11\82000746.ogg":^"Hints?^@:dwave 0, "voice\11\82000747.ogg":^  Huh...??"^\
advsetwindow "-1"
;br
langjp　私にはさっぱりわからない。@
langjp　今の絵羽伯母さんの質問のどこにヒントがあったというのだろう…？\
langen^I'm completely lost.^@
advsetwindow "-1"
langen^How were Aunt Eva's questions just now hints...?^\

mcl c,0
bg black,2

return



