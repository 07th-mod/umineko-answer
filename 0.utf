_ld c,":b;sprites\bea\1\bea_a15_fuman3.png",80
advsetwindow "27"

langjp「………私は理御。@……そして、黄金の魔女、ベアトリーチェです。@それがわかっただけで、私は充分です。@……私は当主を主張するつもりはありません。@……その役目は、蔵臼さまに。」\
;＜ベアト
langen:dwave 0, "voice\27\70700553.ogg":^"...I am Lion.^@:dwave 0, "voice\27\70700554.ogg":^  ...And, I am the Golden Witch, Beatrice.^@:dwave 0, "voice\27\70700555.ogg":^  Knowing that is enough for me.^@:dwave 0, "voice\27\70700556.ogg":^  ...I don't plan on calling myself the Head.^@:dwave 0, "voice\27\70700557.ogg":^  ...Krauss-sama can take that job."^\

;bg sub_R1b,0
_ld l,":b;sprites\gen\1\gen_a21_kashikomari1.png",23
advsetwindow "14"

