langjp「嫌よ、絶対に嫌よ！！@　私たちが捕まったらどうなるのよ？！@　うちの人の会社はどうなるのよッ？！」\
;＜絵羽
langen:dwave 0, "voice\05\71000265.ogg":^"No, I'd never do that!!^@:dwave 0, "voice\05\71000266.ogg":^  What would happen if we were arrested?!^@:dwave 0, "voice\05\71000267.ogg":^  What would happen to my husband's company?!"^\


_ld r,":b;sprites\ros\1\ros_a11_warai2.png",80
advsetwindow "12"

langjp「別にいいじゃない、会社なんて。@５０億もあるんだから、もう働くのも馬鹿馬鹿しいんじゃない？」\
;＜楼座
langen:dwave 0, "voice\12\71400230.ogg":^"Who cares about the company?^@:dwave 0, "voice\12\71400231.ogg":^  With 5 billion yen, working any longer would just be a waste of time, right?"^\
;br

