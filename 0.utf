;**************************
;煉獄の七姉妹のブレードON
*bld
	getparam %meta_tmp1,%ld_pass_number,%meta_tmp3  ;立ち絵位置（l左　C中央　ｒ右）、立ち絵、表示方法

	gosub *ld_data



	;画像の幅/4　で画像中心からの幅が求められるので（立ち位置のX座標からその幅を引く）
	mov %meta_tmp5,511 ;(中心座標）

	if %meta_tmp1 = l mov %metab_l_on,1
	if %meta_tmp1 = c mov %metab_c_on,1
	if %meta_tmp1 = r mov %metab_r_on,1

	if %meta_tmp1 = l ld_old l,$ld_pass,0
	if %meta_tmp1 = c ld_old c,$ld_pass,0
	if %meta_tmp1 = r ld_old r,$ld_pass,0

	blade_draw %meta_tmp1
	print %meta_tmp3
return

*blade_draw
	getparam %meta_tmp1 ;立ち絵位置（l左　C中央　ｒ右）

	if %is_old_sprites = 0 jumpf
	mov $witchh13, ":b;bmp\TATI\RG_blade\blade.png"
	if %meta_tmp1 = l lsp 895,$witchh13,-110,280
	if %meta_tmp1 = c lsp 894,$witchh13,50,280
	if %meta_tmp1 = r lsp 893,$witchh13,210,280
	~
	if %is_old_sprites = 1 jumpf
	mov $witchh13, ":b;big\bmp\TATI\RG_blade\blade.png"
	if %meta_tmp1 = l lsp 895,$witchh13,-110,0
	if %meta_tmp1 = c lsp 894,$witchh13,50,0
	if %meta_tmp1 = r lsp 893,$witchh13,210,0
	~


return
;------------------------------
;煉獄の七姉妹のブレードOFF
*bcl
	getparam %meta_tmp1,%meta_tmp3  ;消去立ち絵位置（l左　C中央　ｒ右　a全部）、消去方法

	if %meta_tmp1 = l csp 895 : cl l,%meta_tmp3 : mov %metab_l_on,0
	if %meta_tmp1 = c csp 894 : cl c,%meta_tmp3 : mov %metab_c_on,0
	if %meta_tmp1 = r csp 893 : cl r,%meta_tmp3 : mov %metab_r_on,0
	if %meta_tmp1 = a csp 895 : csp 894 : csp 893 : cl a,%meta_tmp3 : mov %metab_l_on,0 : mov %metab_c_on,0 : mov %metab_r_on,0
return

*bcl_bladesonly
	csp 895
	csp 894
	csp 893
	mov %metab_l_on,0
	mov %metab_c_on,0
	mov %metab_r_on,0
return

;Uses %Free1,$Free1, %x and %y
;Init %Free1 to 1, and %x/%y to inial position before use
;Then repeatedly call this function while varying $Free1 to change the button text
;Please don't make more than 30 buttons (31-39 are text display, 40th slot reserved for background fade)
*createModTextButtonAndMoveNext
	lsp %Free1 + seventh_mod_button_first_slot, $Free1, %x, %y
	spbtn %Free1 + seventh_mod_button_first_slot, %Free1
	add %y, 26
	inc %Free1
return

*seventh_menu
;clicking on menu buttons at this point crashes the game, so remove them.
csp r_clear_lsp
csp r_sprite_lsp
csp r_language_lsp
csp r_system_lsp

;Dim the background by loading a transparent black image
lsp seventh_mod_button_first_slot+40,":c;bmp\r_click\black.bmp",0,0,150

*seventh_menu_loop
textoff

itoa $Free1, %musicVolume
lsp seventh_mod_button_first_slot + 31, ":s#FFFFFF^~c4~Music: " + $Free1 + " Def: 21", 170, 100
itoa $Free1, %voiceVolume
lsp seventh_mod_button_first_slot + 32, ":s#FFFFFF^~c4~Voices: " + $Free1 + " Def: 51", 170, 125

mov $Free1, "Original"
if %movieSpoilerLevel == 2 mov $Free1, "PS3"
lsp seventh_mod_button_first_slot + 33, ":s#FFFFFF^~c4~Movie Spoiler Level: " + $Free1 + "", 170, 150

lsp seventh_mod_button_first_slot + 34, ":s#FFFFFF^~c4~Textbox: " + $textboxName + "", 170, 175

mov %Free1,1
mov %x, 170
mov %y, 260

;Please don't make more than 30 buttons here
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Music/SoundEffect+^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Music/SoundEffect-^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Voice+^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Voice-^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Play Non-Spoiler Movies^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Play PS3 Spoiler Movies^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Change Textbox^" : gosub *createModTextButtonAndMoveNext
;If user has finished the game, add a button to unlock all achievements
if %UMINEKOEND >= 90 mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Unlock All Achievements^" : gosub *createModTextButtonAndMoveNext
if %UMINEKOEND < 90 inc %Free1

mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Toggle drop shadow (will undim mod menu background)^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Exit^" : gosub *createModTextButtonAndMoveNext

btnwait %btnRes

if %BtnRes = -1 goto *seventh_menu_exit
if %BtnRes = -10 goto *seventh_menu_exit
if %BtnRes = 1 goto *seventh_music_plus
if %BtnRes = 2 goto *seventh_music_minus
if %BtnRes = 3 goto *seventh_voice_plus
if %BtnRes = 4 goto *seventh_voice_minus
if %BtnRes = 5 goto *seventh_old_movies
if %BtnRes = 6 goto *seventh_new_movies
if %BtnRes = 7 goto *swapTextbox
if %BtnRes = 8 goto *seventh_unlock_achievements
if %BtnRes = 9 csp seventh_mod_button_first_slot+40 : lsp seventh_mod_button_first_slot+40,":c;bmp\r_click\white.bmp",0,0,150 : toggle_dropshadow : goto *seventh_menu_loop
if %BtnRes = 10 goto *seventh_menu_exit

;For all other cases, loop the menu
goto *seventh_menu_loop

*seventh_music_plus
add %musicVolume, 3
if %musicVolume > 70 mov %musicVolume, 70
gosub *Coll_system_helper
jumpf

*seventh_music_minus
sub %musicVolume, 3
if %musicVolume < 0   mov %musicVolume, 0
gosub *Coll_system_helper
jumpf

*seventh_voice_plus
seventh_change_voice_level 3
dwave 0, "voice\27\50700001.ogg"
jumpf

*seventh_voice_minus
seventh_change_voice_level -3
dwave 0, "voice\27\50700001.ogg"
jumpf

*seventh_voice_minus
seventh_change_voice_level -3
dwave 0, "voice\27\50700001.ogg"
jumpf

*swapTextbox
changeTextboxType
jumpf

*seventh_old_movies
mov %movieSpoilerLevel, 1
jumpf

*seventh_new_movies
mov %movieSpoilerLevel, 2
jumpf

*seventh_unlock_achievements
gosub *force_set_all_achievements
jumpf

~

goto *seventh_menu_loop
*seventh_menu_exit

;Clear sprite slots 100-140, before leaving the mod menu
mov %Free2, seventh_mod_button_first_slot + 40
for %Free1 = seventh_mod_button_first_slot to %Free2
	csp %Free1
next

goto *rmenu_csutom

