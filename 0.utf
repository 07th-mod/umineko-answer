 if %backloglook <  Backlogpage1 mov %backloglook,BacklogpageMax
 if %backloglook >  BacklogpageMax mov %backloglook,Backlogpage1

goto *text_cw_lookback2


*text_cw_lookback3_jp

 if %jpbackloglook <  jpBacklogpage1 mov %jpbackloglook,jpBacklogpageMax
 if %jpbackloglook >  jpBacklogpageMax mov %jpbackloglook,jpBacklogpage1

goto *text_cw_lookback2_jp

