_ld c,":b;sprites\ros\1\ros_a11_warai2.png",22
advsetwindow "12"

langjp「本当に可愛い寝顔ね。@……まさに名前の通り、天使の寝顔だわ。」@
;＜楼座
langen:dwave 0, "voice\12\81400073.ogg":^"Her face looks so cute, sleeping there like that.^@:dwave 0, "voice\12\81400074.ogg":^  ...She looks like an angel, just like her name."^\

_ld l,":b;sprites\mar\1\mar_a11_niyari1.png",23
