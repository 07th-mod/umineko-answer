		if %BtnRes = 17 : csp 813 : mov %p_page_flg,2 : se1 1000 : mov $witchh20, $witchh19 : add $witchh20, "bmp\ber_sys\p_mode\p\back_geo_1.png" : lsp 850,$witchh20,522,70,255 : ut_lsp 810,":b;sprites\geo\1\geo_a11_majime3.png", 0, 0   : msp 810,bern_quiz_off,0,-215 : gosub *p_nextback_btn ;譲治2ページ目処理
	~
