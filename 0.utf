*hinto_11
mov %play_scene,80110 ;シーン変数の入力

mov %r_hyouji_side,0
mov %r_hyouji_cha,but
;■共犯の存在
mov %BUT_Isyou,2

bgm1 68

bg new_different_space_1a,23
_ld c,":b;sprites\but\1\but_d11_futeki2.png",24
advsetwindow "10"

langjp「いや、いいんだ。@犯人が閉じ込められても。@……犯人がもう１人いればいい！」@
;＜戦人
langen:dwave 0, "voice\10\80100780.ogg":^"No, it does work.^@:dwave 0, "voice\10\80100781.ogg":^  There's no problem if the culprit gets sealed up.^@:dwave 0, "voice\10\80100782.ogg":^  ...Not as long as there's a second culprit!"^\

_ld l,":b;sprites\bea\1\bea_a11_1_majime5star.png",23
advsetwindow "27"

langjp「複数犯人説…！@　やはりそう来るしかないな。@それならば、犯人の片方が閉じ込められても、続く殺人を継続できる…。」\
;＜ベアト
langen:dwave 0, "voice\27\80700555.ogg":^"A multiple culprit theory...!^@:dwave 0, "voice\27\80700556.ogg":^  Yes, that does seem to be the only way.^@:dwave 0, "voice\27\80700557.ogg":^  That way, even if one culprit is sealed up, the other can continue murdering..."^\

cl c,0
_ld r,":b;sprites\but\1\but_d11_nayamu3.png",23
advsetwindow "10"

langjp「考えてみりゃ、そもそも。@俺たちの推理に共犯は必須だったんだ。@第一の晩の６人のうち、シロが確定している源次さんを除く５人、絵羽伯母さん、秀吉伯父さん、クソ親父、霧江さん、そして楼座叔母さん。@この５人は全員、それぞれシロが確定しない人物によって検死されている。@その検死者が共犯でない限り、死んだフリなんか出来ないんだ。」\
;＜戦人
langen:dwave 0, "voice\10\80100783.ogg":^"If you think about it, ^@:dwave 0, "voice\10\80100784.ogg":^our theory needed an accomplice from the very beginning.^@:dwave 0, "voice\10\80100785.ogg":^  In the first twilight, Aunt Eva, Uncle Hideyoshi, that old bastard, Kyrie-san, and Aunt Rosa, ^\:dwave 0, "voice\10\80100786.ogg":^in other words, everyone who hasn't been confirmed innocent, had their deaths confirmed by people who also haven't been confirmed innocent.^@:dwave 0, "voice\10\80100787.ogg":^  Unless those people were fellow culprits, no one would've been able to play dead."^\

_ld l,":b;sprites\bea\1\bea_a11_1_majime6.png",80
advsetwindow "27"

langjp「確かに…！@　犯人でない者は犯人に協力しないことになっているからな…！」\
;＜ベアト
langen:dwave 0, "voice\27\80700558.ogg":^"You're right...!^@:dwave 0, "voice\27\80700559.ogg":^  After all, the rules say that only culprits can cooperate with other culprits...!"^\

bg black,24
bg new_different_space_1c,24
_ld l,":b;sprites\but\1\but_d11_futeki3.png",23
advsetwindow "10"

langjp「犯人は、殺人以前にもウソをつくことが出来る。@……つまりこういうことだ。」\
;＜戦人
langen:dwave 0, "voice\10\80100788.ogg":^"Culprits are capable of lying even before they commit murder.^@:dwave 0, "voice\10\80100789.ogg":^  ...So, we have ourselves a theory."^\

_ld r,":b;sprites\bea\1\bea_a11_def1.png",24
advsetwindow "27"

langjp「第一の晩の殺人を行なった犯人は、第二の晩までを実行し、夏妃の部屋に閉じ込められる。」@
;＜ベアト
langen:dwave 0, "voice\27\80700560.ogg":^"The culprit who carried out the first twilight murders also carried out the second twilight, then locked themselves up in Natsuhi's room."^\

_ld l,":b;sprites\but\1\but_d11_futeki2.png",80
advsetwindow "10"

langjp「そして、その犯人の検死を偽ったもう１人の犯人が、第四の晩以降の殺人を引き継ぐんだ…！」\
;＜戦人
langen:dwave 0, "voice\10\80100790.ogg":^"Then, the other culprit, who lied about the first culprit's death, carried on with the murders starting at the fourth twilight...!"^\

_ld r,":b;sprites\bea\1\bea_a11_futeki1.png",80
advsetwindow "27"

langjp「なるほど、それならば筋が通るぞ…！！@　そしてそれは誰だと言うのか？！」\
;＜ベアト
langen:dwave 0, "voice\27\80700561.ogg":^"Yes, it all matches up that way...!!^@:dwave 0, "voice\27\80700562.ogg":^  So, which of them was it?!"^\

_ld l,":b;sprites\but\1\but_d22_majime2.png",80
advsetwindow "10"

langjp「残念ながら、現時点では誰が犯人でもありえる。@しかし、単独犯はありえないと断言できる。@そして、閉じ込められたのは、食堂犠牲者５人の誰か。@そして、殺人を引き継いだのは、その５人を検死した人間ということになる…！」\
;＜戦人
langen:dwave 0, "voice\10\80100791.ogg":^"Unfortunately, so far, any one of them could be a culprit.^@:dwave 0, "voice\10\80100792.ogg":^  However, we can say for sure that the crime wasn't committed by a single person.^@:dwave 0, "voice\10\80100793.ogg":^  And, we know that the culprit locked up in Natsuhi's room was one of those five victims in the dining hall.^\:dwave 0, "voice\10\80100794.ogg":^  And we also know that the person who continued with the crimes was one of those who inspected the five suspicious corpses on the first twilight...!"^\

;cl r,24
_ld r,":b;sprites\bea\1\bea_a11_futeki2.png",80
advsetwindow "27"

langjp「食堂の５人を検死した人間とな…？@　それはつまり……。」@
;＜ベアト
langen:dwave 0, "voice\27\80700563.ogg":^"One of those who inspected the five suspicious corpses in the dining hall...?^@:dwave 0, "voice\27\80700564.ogg":^  That would be..."^\

se1 2
_ld l,":b;sprites\but\1\but_d11_majime4.png",80
advsetwindow "10"

langjp「戦人、譲治、真里亞。@この３人の誰かが確実に、以後の殺人を引き継いでいる！」\
;＜戦人
langen:dwave 0, "voice\10\80100795.ogg":^"Battler, George, or Maria.^@:dwave 0, "voice\10\80100796.ogg":^  We know that one of those three committed the murders later on!"^\

cl r,0
_ld c,":b;sprites\bea\1\bea_a11_1_majime6.png",24
advsetwindow "27"

langjp「よし……。@その３人に注目して、以後の事件を追ってみようではないか…！」\
;＜ベアト
langen:dwave 0, "voice\27\80700565.ogg":^"Excellent...^@:dwave 0, "voice\27\80700566.ogg":^  Let's focus on those three and find the truth about those later crimes...!"^\

bg black,2

fede 0,1000
E_A

