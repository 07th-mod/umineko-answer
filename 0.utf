mov %r_hyouji_side,0
mov %r_hyouji_cha,but
;■確実に６人を殺した？
mov %BUT_Isyou,2

bgm1 17

bg new_different_space_1c,22
_ld l,":b;sprites\bea\1\bea_a11_majime1.png",22
advsetwindow "27"

langjp「第二の晩の密室について考えているのだが、同じ推理しか浮かばぬ…。」@
;＜ベアト
langen:dwave 0, "voice\27\80700534.ogg":^"I've been thinking about the second twilight's closed room, but no matter how many times I try, I keep ending up with the same theory..."^\

_ld r,":b;sprites\but\1\but_d11_oya1.png",24
advsetwindow "10"

langjp「蔵臼伯父さんたちを殺した後、内側より施錠して隠れたって推理か？」\
;＜戦人
langen:dwave 0, "voice\10\80100746.ogg":^"You mean someone killing the pair of them, then locking the door from the inside and hiding?"^\

_ld l,":b;sprites\bea\1\bea_a11_1_majime3star.png",80
advsetwindow "27"

langjp「うむ。@……マスターキーが使えぬ以上、施錠は内側より行なう他ない。@とれば、犯人は夏妃の部屋のどこかに隠れていたとしか考えられぬ。」\
;＜ベアト
langen:dwave 0, "voice\27\80700535.ogg":^"Yes.^@:dwave 0, "voice\27\80700536.ogg":^  ...Since the master keys can't be used, the door must have been locked from the inside.^@:dwave 0, "voice\27\80700537.ogg":^  So, it only makes sense if the culprit was hiding somewhere in Natsuhi's room."^\

cl r,0
_ld c,":b;sprites\but\1\but_d11_majime4.png",24
advsetwindow "10"

langjp「そう。@そこがおかしいんだ。@ト書きにこうある。@“いつまで経っても、蔵臼夫妻だけが戻ってこない”。@そして、こう続く。@“一同は全員で蔵臼と夏妃の部屋に向かい、”。」\
;＜戦人
langen:dwave 0, "voice\10\80100747.ogg":^"Right.^@:dwave 0, "voice\10\80100748.ogg":^  That is weird.^@:dwave 0, "voice\10\80100749.ogg":^  It says this in the narration:^@:dwave 0, "voice\10\80100750.ogg":^ no matter how much time passed, Krauss and Natsuhi were the only ones who didn't return.^@:dwave 0, "voice\10\80100751.ogg":^  And then it continues:^@:dwave 0, "voice\10\80100752.ogg":^ everyone headed to Krauss's and Natsuhi's rooms together."^\

_ld l,":b;sprites\bea\1\bea_a11_fukigen3.png",80
advsetwindow "27"

langjp「“蔵臼夫妻だけが戻ってこない”ということはつまり、………それ以外の人間は全員、客間に戻ってきたということか。」\
;＜ベアト
langen:dwave 0, "voice\27\80700538.ogg":^"If Krauss and Natsuhi were the only ones who didn't return, ...that implies that everyone else did return to the parlor."^\

bg black,24
bg new_different_space_1a,24
_ld c,":b;sprites\but\1\but_d11_nayamu4.png",24
advsetwindow "10"

langjp「そういうことだ。@犯行後、密室に閉じ篭って隠れていたなら、そいつも戻ってこないことになるはず。@なのに、犠牲者を除く全員が戻ってきている。」\
;＜戦人
langen:dwave 0, "voice\10\80100753.ogg":^"That's right.^@:dwave 0, "voice\10\80100754.ogg":^  If the criminal locked themselves in Natsuhi's room after committing the crime, they shouldn't have been able to return.^@:dwave 0, "voice\10\80100755.ogg":^  And yet, everyone except the victims did return."^\

_ld r,":b;sprites\bea\1\bea_a13_1_majime6.png",24
advsetwindow "27"

langjp「生存者の誰にも、犯行は不可能ということになってしまうな……。@……やはり、戦人の推理通り、食堂の誰かが生きていて犯行に及んだと考えるべきではないのか…。」\
;＜ベアト
langen:dwave 0, "voice\27\80700539.ogg":^"That would make this crime impossible for all the survivors...^@:dwave 0, "voice\27\80700540.ogg":^  ...So, maybe we really should follow up on your theory of someone in the dining hall surviving and committing crimes later..."^\

cl c,0
_ld l,":b;sprites\but\1\but_d11_komaru2.png",24
advsetwindow "10"

langjp「……そういえば。@……その推理を口にしたら、俺は赤き真実を食らったんだ。」\
;＜戦人
langen:dwave 0, "voice\10\80100756.ogg":^"...Come to think of it,^@:dwave 0, "voice\10\80100757.ogg":^ ...when I mentioned that theory, I was hit with a red truth."^\

bg black,22
advsetwindow "-1"

langjp　食堂の誰かが生きていて、蔵臼夫妻を殺した、という俺の推理。@
langen^My theory was that someone in the dining hall was alive and killed Krauss and Natsuhi.^@
advsetwindow "-1"
;br
langjp　それに対し、赤き真実で、“第一の晩の犯人は確実に６人を殺してる”と反論されたんだ……。\
langen^That theory was countered by this red: the culprit of the first twilight really did kill six people...^\

bg new_different_space_1a,22
_ld r,":b;sprites\bea\1\bea_a11_majime2.png",24
advsetwindow "27"

langjp「まぁ、当然であろうな。@蔵臼、夏妃まで殺しているのだから、６人どころか、８人は殺していることになるのだから。」\
;＜ベアト
langen:dwave 0, "voice\27\80700541.ogg":^"Well, that red is hardly surprising.^@:dwave 0, "voice\27\80700542.ogg":^  After all, the culprit went on to kill Krauss and Natsuhi, so they've killed a total of not just six, but eight people."^\

_ld c,":b;sprites\but\1\but_d11_niramu3.png",24
advsetwindow "10"

langjp「……………………。@/
langen:dwave 0, "voice\10\80100758.ogg":^"......^@/
E_A
advsetwindow "10"
langjp……うん……？@　何か引っ掛かるぞ……？@/
langen:dwave 0, "voice\10\80100759.ogg":^...Huh...?^@:dwave 0, "voice\10\80100760.ogg":^  Hold on...^@/
me1 17
advsetwindow "10"
langjp　…………蔵臼、夏妃まで殺しているのだから……。@………犯人は確実に、……６人を………。」\
;＜戦人
langen:dwave 0, "voice\10\80100761.ogg":^  ...They went on to kill Krauss and Natsuhi, ^@:dwave 0, "voice\10\80100762.ogg":^...which means..."^\

