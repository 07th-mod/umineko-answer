langen:dwave 0, "voice\03\50900269.ogg":^"............^@:dwave 0, "voice\03\50900270.ogg":^...It was strict, but they gave me a wonderful upbringing.^@:dwave 0, "voice\03\50900271.ogg":^  It would be rude to my father and mother to call that rigid."^\
advsetwindow "27"
