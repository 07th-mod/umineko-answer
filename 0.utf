langen:dwave 0, "voice\54\75401043.ogg":^"The epitaph wasn't solved.^@:dwave 0, "voice\54\75401044.ogg":^  Someone was made to solve it."^\

_ld l,":b;sprites\cur\1\cur_a11_fuman3.png",23
advsetwindow "55"

