langen:dwave 0, "voice\27\60701251_e.ogg":^The witch shall praise the wise and bestow four treasures.^@
;advsetwindow "-1"
langen:dwave 0, "voice\27\60701251_f.ogg":^One shall be all the gold from the Golden Land.^@
;advsetwindow "-1"
langen:dwave 0, "voice\27\60701251_g.ogg":^One shall be the resurrection of all the dead souls.^@
;advsetwindow "-1"
langen:dwave 0, "voice\27\60701251_h.ogg":^One shall be the resurrection of the love that was lost.^@
;advsetwindow "-1"
langen:dwave 0, "voice\27\60701251_i.ogg":^One shall be to put the witch to sleep for all time.^@

br
;advsetwindow "-1"
