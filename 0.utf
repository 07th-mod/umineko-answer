;wait 800
_ld r,":b;sprites\ki2\1\ki2_a11_oya1.png",80
advsetwindow "01"

langjp「中尉殿。@彼女だけが英語をわかるようです。@彼女が、彼らの通訳になります。@艦長は死亡。@代表者は先ほどの士官のようです。」\
;＜若金蔵
langen:dwave 0, "voice\58\75600097.ogg":^"Sir, ^@:dwave 0, "voice\58\75600098.ogg":^it seems that she's the only one who understands English.^@:dwave 0, "voice\58\75600099.ogg":^  She will act as their interpreter.^@:dwave 0, "voice\58\75600100.ogg":^  Their captain is dead.^@:dwave 0, "voice\58\75600101.ogg":^  That officer seems to be acting in his place."^\

_ld l,":b;sprites\bea\1\bea_c11_fukigen3.png",80
advsetwindow "-1"

langjp『あのうるさくあなたに叫んでいる男は何者？@　まさかあなたの上司なの？』@
;＜ベアト
langen:dwave 0, "voice\59\70700015.ogg":^"<Who's that loud man who keeps yelling at you?^@:dwave 0, "voice\59\70700016.ogg":^  Don't tell me he's your superior.>"^\

_ld r,":b;sprites\ki2\1\ki2_a11_nayamu5.png",80
advsetwindow "01"

langjp『不幸なことに。@私が美しいお嬢さんを独り占めしているのが、気に入らないんでしょう。』\
;＜若金蔵
langen:dwave 0, "voice\58\75600102.ogg":^"<Unfortunately, he is.^@:dwave 0, "voice\58\75600103.ogg":^  He probably doesn't like seeing me have such a beautiful lady all to myself.>"^\

_ld l,":b;sprites\bea\1\bea_c11_def1.png",80
advsetwindow "-1"

langjp『あら。@東洋人にお世辞をもらえるとは思わなかったわ。@綺麗な英語ね。@あなたは育ちが良さそうだわ。@/
langen:dwave 0, "voice\59\70700017.ogg":^"<Oh?^@:dwave 0, "voice\59\70700018.ogg":^  I didn't expect flattery from an Asian.^@:dwave 0, "voice\59\70700019.ogg":^  Your English is superb.^@:dwave 0, "voice\59\70700020.ogg":^  I imagine you've been brought up very well.^@/
advsetwindow "-1"


langjpあの怒鳴ってるみっともない男とは大違い。@あなたがここの将校だったら良かったのに。』\
;＜ベアト
langen:dwave 0, "voice\59\70700021.ogg":^  Unlike that rude man who keeps on shouting.^@:dwave 0, "voice\59\70700022.ogg":^  They should've made you the officer in charge around here.>"^\

_ld r,":b;sprites\ki2\1\ki2_a11_futeki3.png",80
advsetwindow "01"

langjp『おや。@私も西洋人にお世辞をもらえるとは思いませんでした。』@
;＜若金蔵
langen:dwave 0, "voice\58\75600104.ogg":^"<Oh?^@:dwave 0, "voice\58\75600105.ogg":^  And I never expected flattery from a Westerner.>"^\

_ld l,":b;sprites\bea\1\bea_c11_warai1.png",80
advsetwindow "-1"

langjp『くす！@　あなた面白い人だわ。@名前は？』\
;＜ベアト
langen:dwave 0, "voice\59\70700023.ogg":^"<*giggle*!^@:dwave 0, "voice\59\70700024.ogg":^  You're an interesting man.^@:dwave 0, "voice\59\70700025.ogg":^  What's your name?>"^\

_ld r,":b;sprites\ki2\1\ki2_a12_def2.png",80
advsetwindow "01"

langjp『右代宮、金蔵です。@よろしければ、お嬢さんの名前も、ぜひ。』@
;＜若金蔵
langen:dwave 0, "voice\58\75600106.ogg":^"<Ushiromiya...Kinzo.^@:dwave 0, "voice\58\75600107.ogg":^  If you don't mind, may I ask for your name as well?>"^\

_ld l,":b;sprites\bea\1\bea_c11_def2.png",80
