;＜留弗夫
langen:dwave 0, "voice\08\81200072.ogg":^"He's not just a kid in our family.^@:dwave 0, "voice\08\81200073.ogg":^  He's my kid and yours."^\

_ld r,":b;sprites\kir\1\kir_a11_nayamu1.png",80
