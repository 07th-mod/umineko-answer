;＜ベアト
langen:dwave 0, "voice\27\80700473.ogg":^"Let's try writing out Nanjo's and Jessica's purple statements!^@:dwave 0, "voice\27\80700474.ogg":^  These are the same as red truth.^@^  We're finally getting somewhere...!"^\

_ld c,":b;sprites\but\1\but_d11_majime2.png",24
advsetwindow "10"
langjp「南條先生が犯人でないことが確定なら、第一の晩の彼の紫発言である、@“私でなくとも、誰も検死を誤らない”が大きな意味を持ってくる。」@
;＜戦人
langen:dwave 0, "voice\10\80100685.ogg":^"If we're sure that Doctor Nanjo isn't the culprit, then his purple statement for the first twilight,^@:dwave 0, "voice\10\80100686.ogg":^ `No one is going to mistakenly confirm a death, even those other than myself', becomes very important."^\

_ld r,":b;sprites\bea\1\bea_a11_1_odoroki3.png",80
advsetwindow "27"

langjp「つまり、誰であっても検死は誤らないということ…！」\
;＜ベアト
langen:dwave 0, "voice\27\80700475.ogg":^"In other words, no one will make any mistakes when confirming deaths...!"^\

_ld c,":b;sprites\but\1\but_d11_futeki1.png",80
advsetwindow "10"

langjp「犯人でないことが確定したこの二人、南條先生と朱志香によって行なわれた検死は、絶対に信用できるってことだ。」\
;＜戦人
langen:dwave 0, "voice\10\80100687.ogg":^"So, any time Doctor Nanjo or Jessica confirms a death, we can be absolutely sure that it's true."^\

_ld r,":b;sprites\bea\1\bea_a11_futeki1.png",80
advsetwindow "27"

langjp「つまり、南條と朱志香が死亡を確認した人物もまた、犯人ではないことが確実になるというわけだ…！」\
;＜ベアト
langen:dwave 0, "voice\27\80700476.ogg":^"So, anyone whose death was confirmed by Nanjo and Jessica cannot be the culprit...!"^\

bg black,23
bg new_different_space_1c,0
_ld l,":b;sprites\lam\1\lam_a11_futeki2.png",23
advsetwindow "29"

langjp「………あちゃー。@順調ねぇ？」@
;＜ラムダ
langen:dwave 0, "voice\29\82200124.ogg":^"...Uh-oh.^@:dwave 0, "voice\29\82200125.ogg":^  Looks like they're moving along."^\

_ld r,":b;sprites\ber\1\ber_a24_shian1.png",24
advsetwindow "28"

langjp「……不思議なものね。@順調だと悔しいけれど、……行き詰られても、それはそれで退屈だわ。」\
;＜ベルン
langen:dwave 0, "voice\28\82100163.ogg":^"...It's strange.^@:dwave 0, "voice\28\82100164.ogg":^  I find it annoying that they're making progress, ...but if they did get stuck, that would just be boring."^\

