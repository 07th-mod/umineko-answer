_ld l,":b;sprites\rio\1\rio_a11_ikari1a.png",23
advsetwindow "53"

langjp「……いつの間に…。@………誰がこんなことを……。」@
;＜理御
langen:dwave 0, "voice\53\75300665.ogg":^"...When did...?^@:dwave 0, "voice\53\75300666.ogg":^  ...Who would do something like this...?"^\

_ld r,":b;sprites\enj\1\enj_a11_fuman1.png",24
advsetwindow "11"

langjp「…………魔女の駒に堕ちたら。@永遠にあいつらの玩具よ。@……逃げられない。」\
;＜縁寿
langen:dwave 0, "voice\11\72000044.ogg":^"......Once a witch has made you her piece,^@:dwave 0, "voice\11\72000045.ogg":^ you'll be their plaything forever.^@:dwave 0, "voice\11\72000046.ogg":^  ...There's no way to escape."^\
;br

bg black,22
