bgm1 60
advsetwindow "33"

langjp「うりゅー。@意地悪な問題で苛めすぎだよ……。」@
;＜さくたろ
langen:dwave 0, "voice\33\84200001.ogg":^"Uryu-.^@:dwave 0, "voice\33\84200002.ogg":^  You bullied her too much with that puzzle..."^\

_ld l,":b;sprites\mar\1\mar_a22_warai2.png",23
advsetwindow "13"

langjp「だって、縁寿といっぱい遊びたかったんだもん。@簡単な問題だったら、すぐ解かれちゃうよ？」\
;＜真里亞
langen:dwave 0, "voice\13\80400139.ogg":^"Well, I wanted to play with Ange a lot.^@:dwave 0, "voice\13\80400140.ogg":^  If it was an easy one, she'd solve it right away, right?"^\

_ld r,":b;sprites\sak\1\sak_a11_warai2.png",80
advsetwindow "33"

langjp「真里亞は縁寿のこと、大好きだもんね。」@
;＜さくたろ
langen:dwave 0, "voice\33\84200003.ogg":^"You really love Ange, don't you?"^\

_ld l,":b;sprites\mar\1\mar_a11_akuwarai1.png",80
advsetwindow "13"

langjp「嫌いだよ？@　さくたろのこと、ぬいぐるみだって馬鹿にしたもん。」@
;＜真里亞
langen:dwave 0, "voice\13\80400141.ogg":^"I hate her.^@:dwave 0, "voice\13\80400142.ogg":^  She made fun of you and called you a stuffed animal."^\
advsetwindow "-1"
;br
langjp　真里亞はそう言って口を尖らせるが、その表情は決して言葉通りではなかった。\
langen^Maria pouted as she said this, but her expression didn't match her words at all.^\

bg new_mhal_h1c,23
_ld c,":b;sprites\sak\1\sak_a11_def1.png",23
advsetwindow "33"

langjp「縁寿は、幸せになれるといいね…。」@
;＜さくたろ
langen:dwave 0, "voice\33\84200004.ogg":^"I hope Ange finds happiness."^\

_ld r,":b;sprites\mar\1\mar_a22_warai2.png",24
advsetwindow "13"

langjp「なれるよ、きっと。@だって、これだけの大勢が、あの子の幸せを願ってる。@そして戦人はゲームマスターにまでなり、縁寿のためだけに、この最後のゲームを開いてる。@……そこまでしてもらって、幸せじゃないわけがないよ。」\
;＜真里亞
langen:dwave 0, "voice\13\80400143.ogg":^"I'm sure she will.^@:dwave 0, "voice\13\80400144.ogg":^  After all, look at all the people here wishing for her happiness.^@:dwave 0, "voice\13\80400145.ogg":^  And now, Battler is the Game Master, and he's set up this final game just for Ange.^@:dwave 0, "voice\13\80400146.ogg":^  ...After all this, there's no way she won't be happy."^\

_ld c,":b;sprites\sak\1\sak_a11_komaru1.png",80
advsetwindow "33"

langjp「……でも、幸せはみんなが用意することは出来ても、掴み取るのは自分だからね。」@
;＜さくたろ
langen:dwave 0, "voice\33\84200005.ogg":^"...Still, even though anyone can make happiness appear, you can only ever grasp it for yourself."^\

_ld r,":b;sprites\mar\1\mar_a22_komaru1.png",80
advsetwindow "13"

langjp「そうだね。@あの子は、幸せのカケラを拾うのが、すごい下手なの。@それを教えようにも、１２年間の日々が、あの子の耳を塞いでしまった。@……このゲーム、戦人が思ってるよりも、縁寿には難しいかもしれない。」\
;＜真里亞
langen:dwave 0, "voice\13\80400147.ogg":^"That's right.^@:dwave 0, "voice\13\80400148.ogg":^  That kid is really bad at finding Fragments of happiness.^@:dwave 0, "voice\13\80400149.ogg":^  Even though we tried to teach her how, she's been covering her ears for 12 full years.^@:dwave 0, "voice\13\80400150.ogg":^  ...This game might be much harder for Ange than Battler thinks."^\

_ld c,":b;sprites\sak\1\sak_a11_warai1.png",80
advsetwindow "33"

langjp「………ボクは、縁寿はきっと幸せになってくれると思うな。」@
;＜さくたろ
langen:dwave 0, "voice\33\84200006.ogg":^"...I'm sure Ange will find happiness."^\

_ld r,":b;sprites\mar\1\mar_a22_def1.png",80
advsetwindow "13"

langjp「そうだね。@……このパーティーをあの子が楽しいと、素直に思ってくれたなら。@それが今のあの子に伝えられる精一杯かもしれない。」\
;＜真里亞
langen:dwave 0, "voice\13\80400151.ogg":^"Yeah.^@:dwave 0, "voice\13\80400152.ogg":^  ...If she really does enjoy herself at this party,^@:dwave 0, "voice\13\80400153.ogg":^ that itself might be the greatest lesson we can teach her now."^\

bg black,22
advsetwindow "-1"
;bg cit_2b,22

langjp　どんな魔法を見せても、手品だと言って信じないあの縁寿が。@
langen^Ange is the girl who doesn't believe and says that everything is a trick, no matter what magic is shown to her...^@
advsetwindow "-1"
;br
langjp　１２年後の未来には、最後のベアトリーチェの名を受け継ぐのだ。\
langen^12 years in the future, that girl will become the last person to inherit Beatrice's name.^\

;bg black,22
bg new_mhal_h1a,0
_ld l,":b;sprites\mar\1\mar_a22_majime1.png",22
advsetwindow "13"

langjp「あの子は、一度は私の白い魔法を理解したんだよ。」@
;＜真里亞
langen:dwave 0, "voice\13\80400154.ogg":^"At one point in time, that kid understood my white magic."^\

_ld r,":b;sprites\sak\1\sak_a11_def1.png",23
advsetwindow "33"

langjp「うん。@ボクのことも、理解してくれたよ。」\
;＜さくたろ
langen:dwave 0, "voice\33\84200007.ogg":^"Yeah.^@:dwave 0, "voice\33\84200008.ogg":^  And she understood me too."^\

_ld l,":b;sprites\mar\1\mar_a11_fukigen2.png",80
advsetwindow "13"

langjp「七姉妹のみんなさえ呼び出し、魔法を理解できたはず。@……そんな彼女が、自分にだけは魔法を使えないなんてね。」\
;＜真里亞
langen:dwave 0, "voice\13\80400155.ogg":^"She even summoned all of the Seven Sisters and understood magic itself.^@:dwave 0, "voice\13\80400156.ogg":^  ...And yet, she still can't use magic on herself."^\

;se1 52
_ld c,":b;sprites\bea\1\bea_a13_1_warai8.png",24
advsetwindow "27"
;print 99,1000,"breakup.dll/llP"

langjp「信じよ。@かつての戦人も、そうだったではないか。」@
;＜ベアト
langen:dwave 0, "voice\27\80700281.ogg":^"Let us believe.^@:dwave 0, "voice\27\80700282.ogg":^  Just as Battler did once, in the past."^\

_ld l,":b;sprites\mar\1\mar_a22_niyari1.png",80
advsetwindow "13"

langjp「……ベアト。」\
;＜真里亞
langen:dwave 0, "voice\13\80400157.ogg":^"...Beato."^\

_ld c,":b;sprites\bea\1\bea_a13_1_warai6.png",80
advsetwindow "27"

langjp「人に魔法を掛けるのは容易い。@そして人の魔法を信じることも、そう難しくはない。@もっとも難しいのは、自らに魔法を掛けることなのだ。」\
;＜ベアト
langen:dwave 0, "voice\27\80700283.ogg":^"It is easy to cast magic on others.^@:dwave 0, "voice\27\80700284.ogg":^  And believing in other people's magic is not so difficult.^@:dwave 0, "voice\27\80700285.ogg":^  The hardest thing is casting magic on yourself."^\

_ld r,":b;sprites\sak\1\sak_a11_odoroki1.png",80
advsetwindow "33"

langjp「それが縁寿に、出来るかな……。」\
;＜さくたろ
langen:dwave 0, "voice\33\84200009.ogg":^"Is that...something Ange can do...?"^\

mcl c,23

;bg black,24
bg new_mhal_h1c,23
_ld r,":b;sprites\bea\1\bea_a13_def2.png",24
advsetwindow "27"

langjp「出来るとも。@あの戦人でさえ、魔法を理解した。@その妹に、出来ぬ道理はない。」\
;＜ベアト
langen:dwave 0, "voice\27\80700286.ogg":^"She can.^@:dwave 0, "voice\27\80700287.ogg":^  Even Battler managed to understand magic.^@:dwave 0, "voice\27\80700288.ogg":^  Of course his little sister will be able to do the same."^\

_ld c,":b;sprites\mar\1\mar_a11_niyari1.png",23
advsetwindow "13"

langjp「そうだね。@………子供のうちにしか見えない魔法もあるし。@……大人になって理解できる魔法もある。@縁寿は今、その狭間にいる。」\
;＜真里亞
langen:dwave 0, "voice\13\80400158.ogg":^"You're right.^@:dwave 0, "voice\13\80400159.ogg":^  ...There are some kinds of magic that we can only see when we're kids.^@:dwave 0, "voice\13\80400160.ogg":^  ...And there are some that only adults can understand.^@:dwave 0, "voice\13\80400161.ogg":^  Right now, Ange is between the two of those."^\

_ld r,":b;sprites\bea\1\bea_a13_futeki2.png",80
advsetwindow "27"

langjp「子供の魔法を失い、さりとて、大人の魔法も理解できぬ、もっとも辛き世代であるな。」@
;＜ベアト
langen:dwave 0, "voice\27\80700289.ogg":^"She's lost the magic of children, but she has yet to understand the magic of adults.  It's the most painful period of one's life."^\

_ld l,":b;sprites\sak\1\sak_a11_komaru1.png",23
advsetwindow "33"

langjp「そんな時に、大切な人たちが身近にいないなんて、……本当に可哀想だね…。」\
;＜さくたろ
langen:dwave 0, "voice\33\84200010.ogg":^"It's so sad...that she didn't have anyone close to her at a time like that..."^\

cl c,0
ut_mld c,":b;sprites\mar\1\mar_a22_warai1.png",80
advsetwindow "13"

langjp「そんなことないよ。@私たちは、いつだってあの子の側にいるんだよ。@あの子が、それを信じないだけで。」\
;＜真里亞
langen:dwave 0, "voice\13\80400162.ogg":^"That's not true.^@:dwave 0, "voice\13\80400163.ogg":^  We're always by that kid's side.^@:dwave 0, "voice\13\80400164.ogg":^  She just doesn't believe it."^\

mcl c,0
bg black,22
advsetwindow "-1"

langjp　縁寿、それに早く、気が付いて。@
langjp　君の背中に微笑みかけて、温かく見守る大勢の人がいる。@
langjp　君が振り返ってさえくれれば、私たちはもっと微笑んで、もっと多くの言葉を掛けることが出来るんだよ。@
langen^Ange, please, realize that quickly.^@
advsetwindow "-1"
langen^There are so many people smiling at you from behind, watching over you.^\
