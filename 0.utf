;＜ベアト
langen:dwave 0, "voice\27\80700827.ogg":^"Please, Lady Lambdadelta...!!^@:dwave 0, "voice\27\80700828.ogg":^  Only you can do this...!!"^\

_ld c,":b;sprites\but\1\but_b11_kuyasigaru1.png",80
advsetwindow "10"

langjp「力を貸してくれ！！@　俺がお前に最高の物語を見せてやるッ！！@　そいつを最前列で見せてやるから！！@　だから力を貸してくれッ！！」\
;＜戦人
langen:dwave 0, "voice\10\80101229.ogg":^"Give us your strength!!^@:dwave 0, "voice\10\80101230.ogg":^  I'll show you the greatest of tales!!^@:dwave 0, "voice\10\80101231.ogg":^  And you'll get to see it from the front row!!^@:dwave 0, "voice\10\80101232.ogg":^  So please, lend us your strength!!"^\

