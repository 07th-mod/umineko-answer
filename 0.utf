bg black,24
bfly2 0
bg new_mhal_h1a,24
_ld r,":b;sprites\ber\1\ber_a21_shian1.png",24
advsetwindow "28"

langjp「…………あんたもベアトも。@……あんたたちって、つくづく面白い考え方ね。」@
;＜ベルン
langen:dwave 0, "voice\28\82100231.ogg":^"......Both you and Beato...^@:dwave 0, "voice\28\82100232.ogg":^have such an interesting way of thinking."^\

_ld l,":b;sprites\but\1\but_d11_def2.png",23
advsetwindow "10"

langjp「何がだ？」\
;＜戦人
langen:dwave 0, "voice\10\80100943.ogg":^"How's that?"^\

_ld r,":b;sprites\ber\1\ber_a21_def2.png",80
advsetwindow "28"
langjp「……ゲームは、勝敗を決するための手段でしょう？@　そして、それを仕掛けるからには、至上目的は自分の勝利のはず。@……なのに、自分が負けるかもしれないゲームを、どうしてわざわざ仕掛けるの…？」\
;＜ベルン
langen:dwave 0, "voice\28\82100233.ogg":^"...A game is just a means to decide who wins and who loses, right?^@:dwave 0, "voice\28\82100234.ogg":^  When you create one, your own victory should be your highest priority.^@:dwave 0, "voice\28\82100235.ogg":^  ...So, why would you go to all the trouble of making a game you might lose...?"^\

_ld l,":b;sprites\but\1\but_d11_warai2.png",80
advsetwindow "10"

langjp「絶対に勝てるゲームなんて、つまらないだろ。@そんなのゲームじゃない。」@
;＜戦人
langen:dwave 0, "voice\10\80100944.ogg":^"What fun is there in a game you always win?^@:dwave 0, "voice\10\80100945.ogg":^  That's not even a game."^\

_ld r,":b;sprites\ber\1\ber_a21_def1.png",80
advsetwindow "28"

langjp「…………………………。」\
;＜ベルン
langen:dwave 0, "voice\28\82100236.ogg":^"............"^\


_ld l,":b;sprites\but\1\but_d11_futeki1.png",80
advsetwindow "10"

langjp「勝つか負けるか。@そのフェアなやり取りが面白いんじゃないか。@ゲームってのは、戦いじゃない。@コミュニケーションなんだ。@その過程を楽しむ。@勝敗という結果は、まぁオマケみたいなもんさ。」\
;＜戦人
langen:dwave 0, "voice\10\80100946.ogg":^"Victory and defeat.^@:dwave 0, "voice\10\80100947.ogg":^  It's fun because you're taking part in a fair competition, balanced between those two outcomes.^@:dwave 0, "voice\10\80100948.ogg":^  A game isn't a fight.^@:dwave 0, "voice\10\80100949.ogg":^  It's communication.^@:dwave 0, "voice\10\80100950.ogg":^  You have to enjoy the means.^@:dwave 0, "voice\10\80100951.ogg":^  And if you manage to win in the end, well, that's just an added bonus."^\


