	if %BtnRes = t_btn_start_lsp cell t_btn_start_lsp,1 : print 1:btndef "" : goto *start_sub_menu
	if %BtnRes = t_btn_web_lsp seplay 9,1001 : menu_window : shell "http://07th-expansion.net"

	if %BtnRes = t_btn_controls_lsp seplay 9,1001 : csp -1 : mov $witchh4,"bmp\title\manual.png" : setLangString $witchh4, "" : bg $witchh4,22: click : bg black,0 : mov %title_skip,1 : goto *b_title

