;＜絵羽
langen:dwave 0, "voice\05\81000373.ogg":^"The key to the puzzle is the part about how many can she `carry out'."^\

mcl c,0
bg black,22
advsetwindow "-1"

langjp　……あぁ。@
langen^...Oh.^@
advsetwindow "-1"
;br
langjp　シンプルなミスみたいだ。@
langjp　ひねくれた問題ばかり挑戦してきたので、ちょっと身構えすぎたみたい。\
langen^Looks like I made a pretty simple mistake.^@
advsetwindow "-1"
langen^I've been taking on so many tricky riddles, I've gotten a bit too tense.^\

bg new_mhal_h1c,22
_ld c,":b;sprites\ros\1\ros_a13_warai1.png",22
advsetwindow "12"

