goto *ROSMAR_quizend



;■正解の場合（「１０手未満」）
*Mar_atari
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2

bg new_mhal_h1a,22
_ld r,":b;sprites\eva\1\eva_b25_komaru1.png",22
advsetwindow "05"

langjp「本当に酷い問題だわ、これ本当に解けるのよね？@　荷物は川に放り込んで船を使わずに流すとか、牛に野菜を食べさせてお腹の中にいれて１人分にして運ぶとか、@そういうトンチがあるんじゃないの…？」\
;＜絵羽
langen:dwave 0, "voice\05\81000390.ogg":^"This really is a nasty problem.  Can it really be solved?^@:dwave 0, "voice\05\81000391.ogg":^  Is there some trick to it, like throwing things into the river without using the boat, ^@:dwave 0, "voice\05\81000392.ogg":^or making the cow eat the vegetables so that they can be carried as one passenger...?"^\

_ld c,":b;sprites\ros\1\ros_a11_warai1.png",23
advsetwindow "12"

langjp「さて、どうかしらね。@これ以上考えてわからないなら、降参ってことにするけれど…？」\
;＜楼座
langen:dwave 0, "voice\12\81400054.ogg":^"Well, who knows?^@:dwave 0, "voice\12\81400055.ogg":^  If that's as far as you can go, maybe you should give up, right...?"^\

_ld l,":b;sprites\mar\1\mar_a11_akuwarai1.png",23
advsetwindow "13"

langjp「これはすごい難しいよ！@　ママにだって解けなかったんだから！@　真里亞は一発で解いちゃったけどね！」@
;＜真里亞
langen:dwave 0, "voice\13\80400131.ogg":^"This one's really hard!^@:dwave 0, "voice\13\80400132.ogg":^  Even Mama couldn't solve it!^@:dwave 0, "voice\13\80400133.ogg":^  But I solved it on my first try!"^\

_ld c,":b;sprites\ros\1\ros_a11_akuwarai1.png",80
advsetwindow "12"

langjp「さぁ、わかる？@　何手で全員が対岸に渡れるか。」\
;＜楼座
langen:dwave 0, "voice\12\81400056.ogg":^"So, do you get it?^@:dwave 0, "voice\12\81400057.ogg":^  How many trips does it take to get every person across?"^\

_ld r,":b;sprites\eva\1\eva_b25_odoroki1.png",80
advsetwindow "05"

langjp「これ、トンチとかなぞなぞよね？！@　絶対まともに考えて解けないわよね？！」@
;＜絵羽
langen:dwave 0, "voice\05\81000393.ogg":^"This isn't a cheap trick or a riddle, right?^@:dwave 0, "voice\05\81000394.ogg":^  There's no way you can solve this straightforwardly, right?!"^\

_ld c,":b;sprites\ros\1\ros_a11_warai1.png",80
advsetwindow "12"

langjp「そんなことないわよ。@賢い姉さんなら、きっとわかるわよ。@何手で全員が対岸に渡れるか。」\
;＜楼座
langen:dwave 0, "voice\12\81400058.ogg":^"No, that's not true.^@:dwave 0, "voice\12\81400059.ogg":^  I'm sure you'll get it Nee-san, smart as you are.^@:dwave 0, "voice\12\81400060.ogg":^  How many trips does it take to get every person across?"^\


bg black,22
bg new_mhal_2d,22
;ld c,EN2_DefA1,80

E_A
advsetwindow "11"

langjp「わかった。@３手。」\
;＜縁寿
langen:dwave 0, "voice\11\82000677.ogg":^"I've got it.^@:dwave 0, "voice\11\82000678.ogg":^  Three trips."^\

bgm1 187


bg new_mhal_h1a,22
_ld l,":b;sprites\eva\1\eva_b25_odoroki1.png",22
advsetwindow "05"

langjp「……え？@　３手？！@　どうして…！」@
;＜絵羽
langen:dwave 0, "voice\05\81000395.ogg":^"...Huh?^@:dwave 0, "voice\05\81000396.ogg":^  Three?!^@:dwave 0, "voice\05\81000397.ogg":^  How...?!"^\

_ld r,":b;sprites\en2\1\en2_a13_def1c.png",24
advsetwindow "11"

langjp「だって。@農夫と妻が船に乗って、対岸に妻を下ろして１手。@農夫が船で戻って２手。@そして羊飼いと一緒に対岸に渡って３手。」\
;＜縁寿
langen:dwave 0, "voice\11\82000679.ogg":^"It's easy.^@:dwave 0, "voice\11\82000680.ogg":^  The peasant and his wife get on the boat, then the wife gets dropped off on the other side in the first move.^@:dwave 0, "voice\11\82000681.ogg":^  Then, the peasant takes the boat back across in the second move.^@:dwave 0, "voice\11\82000682.ogg":^  Then, he crosses with the shepherd in the third move."^\

_ld l,":b;sprites\eva\1\eva_b25_odoroki2.png",80
advsetwindow "05"

langjp「牛とか羊とか！@　肉とか野菜とかはどうするのよ！」@
;＜絵羽
langen:dwave 0, "voice\05\81000398.ogg":^"But what about the cow and the sheep?!^@:dwave 0, "voice\05\81000399.ogg":^  What about the meat and the vegetables?!"^\

_ld r,":b;sprites\en2\1\en2_a11_def2.png",80
advsetwindow "11"

langjp「だって、全員でしょ……？@　人じゃないし。」\
;＜縁寿
langen:dwave 0, "voice\11\82000683.ogg":^"But Aunt Eva, it said to take every person across, right?^@:dwave 0, "voice\11\82000684.ogg":^  Those other things aren't people."^\

_ld l,":b;sprites\eva\1\eva_b25_odoroki1.png",80
advsetwindow "05"

langjp「え、あ、…………。」@
;＜絵羽
langen:dwave 0, "voice\05\81000400.ogg":^"Huh?  Ah......"^\
advsetwindow "-1"

;se1 76

;br

langjp　絵羽伯母さんがあんぐりと口を開けると、楼座叔母さんがパチパチと拍手してくれた。@真里亞お姉ちゃんも、いやそ〜な顔で舌打ちしてから拍手してくれる。\
langen^As Aunt Eva's mouth flopped open, Aunt Rosa started applauding.^@^  After clicking her tongue, Maria onee-chan joined in.^\

bg new_mhal_h1c,23
_ld l,":b;sprites\ros\1\ros_a11_warai2.png",23
advsetwindow "12"

langjp「正解よ。@問題が聞いてるのは、全員が対岸へ渡るには何手かかるかということだもの。@動物も荷物も、初めから関係ないのよね。」\
;＜楼座
langen:dwave 0, "voice\12\81400061.ogg":^"That's right.^@:dwave 0, "voice\12\81400062.ogg":^  The question just asks how many moves it would take to move each person across.^@:dwave 0, "voice\12\81400063.ogg":^  The animals and luggage never had anything to do with it."^\

_ld r,":b;sprites\mar\1\mar_a22_komaru1.png",24
advsetwindow "13"

langjp「ママが全員全員って何度も繰り返すからバレちゃったんだよー。@うー！」@
;＜真里亞
langen:dwave 0, "voice\13\80400134.ogg":^"They only got it because you kept saying `every person' over and over again, Mama.^@:dwave 0, "voice\13\80400135.ogg":^  Uu!"^\
advsetwindow "-1"
;br
langjp　多分、楼座叔母さんはヒントのつもりで繰り返してくれたのだろう。@そうじゃなかったら、私にも閃けなかった。\
langen^Aunt Rosa had probably said it so much as a sort of hint.^@^  Without that, even I wouldn't have figured it out.^\

ut_mld c,":b;sprites\eva\1\eva_a11_akire1.png",80
advsetwindow "05"

langjp「もう。@すっかりやられたわ。@意地悪問題だったなんてね！」\
;＜絵羽
langen:dwave 0, "voice\05\81000401.ogg":^"Come on.^@:dwave 0, "voice\05\81000402.ogg":^  I was totally taken in.^@:dwave 0, "voice\05\81000403.ogg":^  That was a mean question!"^\

_ld l,":b;sprites\ros\1\ros_a13_warai1.png",80
advsetwindow "12"

langjp「ほら、真里亞。@メダルを縁寿ちゃんに渡しなさい？」\
;＜楼座
langen:dwave 0, "voice\12\81400064.ogg":^"Go on, Maria.^@:dwave 0, "voice\12\81400065.ogg":^  Give Ange-chan her medal."^\

mcl c,0
bg black,22
bg new_mhal_2d,22
advsetwindow "13"

;ld r,MAR_fukigenA1,80

langjp「うーうーうー……。」@
;＜真里亞
langen:dwave 0, "voice\13\80400136.ogg":^"Uu-uu-uu-..."^\
advsetwindow "-1"
;br
langjp　不機嫌な犬のように唸りながら、渋々とメダルを差し出す。@
langen^Whining like a unhappy dog, she reluctantly handed the medal over.^@
advsetwindow "-1"
;br
langjp　それを引ったくり、私も犬のように大はしゃぎで喜ぶ。\
langen^I grabbed it and started jumping around like a happy dog.^\

bg black,22
bg new_mhal_h1c,0
_ld c,":b;sprites\mar\1\mar_a11_niyari1.png",22
advsetwindow "-1"

langjp　そんな私の後ろで微笑む真里亞お姉ちゃんの顔は、……お姉ちゃんと呼ぶに相応しい、朗らかなものだった\
langen^As Maria onee-chan smiled at me from behind, ...her face was bright, just like a big sister's.^\

bg black,2

