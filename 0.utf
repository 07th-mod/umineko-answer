;クリックでページが切り替わらないための、ボタンレス０のための処理
*btn_nextback_click
	notif %hinto_raberu = 0 : jumpf
		mov %hinto_raberu,1
		 goto *hint_loop
	~
	notif %hinto_raberu = 1 : jumpf
		mov %hinto_raberu,0
		 goto *hint_loop
	~
return

if %hinto_raberu = 0 : goto *hint_loop
if %hinto_raberu = 1 : goto *hint_loop


return





