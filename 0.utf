_ld r,":b;sprites\enj\1\enj_a11_nayamu1.png",24
advsetwindow "11"


langjp「…………気付いてないの？@　これ。」\
;＜縁寿
langen:dwave 0, "voice\11\72000042.ogg":^"......You haven't noticed yet?^@:dwave 0, "voice\11\72000043.ogg":^  Look."^\

;bg the_1c,0

