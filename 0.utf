;＜若金蔵
langen:dwave 0, "voice\58\75600112.ogg":^"<I see you've done your homework.^@:dwave 0, "voice\58\75600113.ogg":^  In Japan, we use squid ink instead of shampoo.>"^\

;bg white,22
bg new_sky_1a,22
advsetwindow "27"

langjp『きゃっはは！@　金蔵はすごいわ。@何でも知っているのね！@　イタリアに来たことがあるの？』@
;＜ベアト
langjp『ありません。@しかし、本は色々と読みました。』\
;＜若金蔵
langen:dwave 0, "voice\59\70700032.ogg":^"<Kyahaha!^@:dwave 0, "voice\59\70700033.ogg":^  You really are amazing, Kinzo.^@:dwave 0, "voice\59\70700034.ogg":^  It seems you know everything!^@:dwave 0, "voice\59\70700035.ogg":^  Have you ever been to Italy?>"^\
advsetwindow "01"
langen:dwave 0, "voice\58\75600114.ogg":^"<Never.^@:dwave 0, "voice\58\75600115.ogg":^  I have read a lot of books though.>"^\
advsetwindow "27"

langjp『東洋人がイタリアの本を？！@　へぇ、例えばどんな？』@
;＜ベアト
langjp『ニッコロ・マキャヴェッリ。@ダンテ・アリギエーリも。@だからあなたが永遠の淑女であることも存じていますよ。』\
;＜若金蔵
langen:dwave 0, "voice\59\70700036.ogg":^"<An Asian man reading Italian books?!^@:dwave 0, "voice\59\70700037.ogg":^  Wow, what kinds of books?>"^\
advsetwindow "01"
langen:dwave 0, "voice\58\75600116.ogg":^"<Niccolo Machiavelli.^@:dwave 0, "voice\58\75600117.ogg":^  And Dante Alighieri.^@:dwave 0, "voice\58\75600118.ogg":^  So I know, of course, that you're the eternal lady.>"^\
advsetwindow "27"

langjp『おぉ、何てこと…。@金蔵はとんでもない勉強家だわ。@あなたはひょっとして、日本では高貴な家の出身なのでは？』@
;＜ベアト
langjp『………さぁ、どうでしょう。』\
;＜若金蔵
langen:dwave 0, "voice\59\70700038.ogg":^"<Oh, what a surprise...^@:dwave 0, "voice\59\70700039.ogg":^  You must be quite the bookworm.^@:dwave 0, "voice\59\70700040.ogg":^  Does this mean you came from some Japanese noble family?>"^\
advsetwindow "01"
langen:dwave 0, "voice\58\75600119.ogg":^"<......Who knows?>"^\
advsetwindow "27"

langjp『あなたは他の野蛮そうな日本人とはまるで違うわ。@私にはわかるの！@　あなたはきっと、高貴な家の人間だわ。@右代宮家は、日本の貴族の家柄なの？』\
;＜ベアト
langen:dwave 0, "voice\59\70700041.ogg":^"<You're completely different from those other savage-looking Japanese soldiers.^@:dwave 0, "voice\59\70700042.ogg":^  I can tell!^@:dwave 0, "voice\59\70700043.ogg":^  You must've come from a noble family.^@:dwave 0, "voice\59\70700044.ogg":^  Are the Ushiromiyas some sort of Japanese aristocrats?>"^\

bg black,22
advsetwindow "01"

langjp『……とんでもない。@紡績で一山当てただけの、ただの成金の一族です。@私が勉強していたのは、高貴なる者としての嗜みではなく、@……何をすることも許されなかったら、@本を読むか、薔薇をいじるか、@酒に溺れるかしかやることがなかったからですよ。』\
;＜若金蔵
langen:dwave 0, "voice\58\75600120.ogg":^"<...Of course not.^@:dwave 0, "voice\58\75600121.ogg":^  They just managed to strike it rich in the spinning industry in recent generations.^@:dwave 0, "voice\58\75600122.ogg":^  I didn't study all that as part of some noble's hobby.^@:dwave 0, "voice\58\75600123.ogg":^  ...I just did it because I wasn't allowed to do anything except read, ^@:dwave 0, "voice\58\75600124.ogg":^play around with roses, ^@:dwave 0, "voice\58\75600125.ogg":^and get myself drunk.>"^\


