gosub *medaru



;★合流地点
*SHA_quiz
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2


fede 0,1000
E_A

bg new_mhal_h1c,22
_ld r,":b;sprites\sha\1\sha_a11_def1.png",22

bgm1 21
advsetwindow "15"

langjp「私の問題は、そんなに難しくありませんのでご安心下さい。」@
;＜紗音
langen:dwave 0, "voice\15\80500030.ogg":^"Mine isn't that hard, so you can relax."^\

_ld l,":b;sprites\kan\1\kan_a11_majime1.png",23
advsetwindow "16"

langjp「姉さんのレベルで考えてるからね。」\
;＜嘉音
langen:dwave 0, "voice\16\80600032.ogg":^"After all, you managed to think it up."^\

_ld r,":b;sprites\sha\1\sha_a11_odoroki2.png",80
advsetwindow "15"

langjp「も、もう馬鹿にして…！@　じゃあ、嘉音くんも挑戦してみる？」@
;＜紗音
langen:dwave 0, "voice\15\80500031.ogg":^"Y-You're making fun of me...!^@:dwave 0, "voice\15\80500032.ogg":^  Then do you want to have a go at it too, Kanon-kun?"^\

_ld l,":b;sprites\kan\1\kan_a11_def2.png",80
advsetwindow "16"

langjp「望むところさ。」\
;＜嘉音
langen:dwave 0, "voice\16\80600033.ogg":^"Bring it on."^\

bg new_mhal_h1a,24
_ld c,":b;sprites\eva\1\eva_a11_def1.png",24
advsetwindow "05"

langjp「今度は縁寿ちゃんにもわかる問題だそうよ。@伯母さんはヒント役に回るわ。」@
;＜絵羽
langen:dwave 0, "voice\05\81000320.ogg":^"It sounds like you'll be able to understand it this time, Ange-chan.^@:dwave 0, "voice\05\81000321.ogg":^  I'll stick to giving hints again."^\

_ld r,":b;sprites\en2\1\en2_a11_def1.png",24
advsetwindow "11"

langjp「うん、がんばる。@解く。@メダル集めるっ。」\
;＜縁寿
langen:dwave 0, "voice\11\82000624.ogg":^"Okay, I'll do my best.^@:dwave 0, "voice\11\82000625.ogg":^  I'll solve it.^@:dwave 0, "voice\11\82000626.ogg":^  Another medal for me."^\

_ld l,":b;sprites\sha\1\sha_a11_def1.png",23
advsetwindow "15"

langjp「それでは参りますね。@よくお聞き下さい…。」\
;＜紗音
langen:dwave 0, "voice\15\80500033.ogg":^"Let's go then.^@:dwave 0, "voice\15\80500034.ogg":^  Listen carefully..."^\

bg black,22

goto *quiz
;■紗音の出題

;Ａ＝甘納豆 sweet
;Ｓ＝塩せんべい salty
;Ｋ＝カレーライス spicy
;Ｎ＝ブラックコーヒー bitter
;　？@＝レモネード

;W=white chocolate
;P=pepper jack cheese
;A=anchovy pizza
;O=lemonade
;?=black coffee

; Which letter does the `?' stand for?

; A. "W" B. "A" C. "B" D. "I" E. "O"


;■ヒント
*EVA_hinto_8
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2

bg new_mhal_h1c,22
_ld r,":b;sprites\en2\1\en2_a15_def2.png",22
advsetwindow "11"

langjp「よくわかんない。@ローマ字…？」@
;＜縁寿
langen:dwave 0, "voice\11\82000627.ogg":^"I don't get it.^@:dwave 0, "voice\11\82000628.ogg":^  What do the letters mean...?"^\

_ld c,":b;sprites\kan\1\kan_a11_komaru1.png",23
advsetwindow "16"

langjp「……それぞれの名前をローマ字に直して、それの頭文字を抜いたとか。」\
;＜嘉音
langen:dwave 0, "voice\16\80600034.ogg":^"...Could it be the first letter of each word?"^\

_ld l,":b;sprites\eva\1\eva_b21_odoroki1.png",23
advsetwindow "05"

langjp「私も最初はそう思ったのよ。@甘納豆はＡ、塩せんべいはＳ、カレーライスはＫ。@ローマ字ならみんなそれが頭文字なのよね。@でもそれだと、ブラックコーヒーがＮってのが意味わかんないのよ。」\
;＜絵羽
langen:dwave 0, "voice\05\81000322.ogg":^"That's what I thought at first.^@:dwave 0, "voice\05\81000323.ogg":^  White chocolate starts with `W', pepper jack starts with `P', and anchovy starts with `A'.^@:dwave 0, "voice\05\81000324.ogg":^  But then, ^@:dwave 0, "voice\05\81000325.ogg":^how do you explain lemonade being `O'?"^\

bg new_mhal_h1a,23
_ld l,":b;sprites\sha\1\sha_a11_warai2.png",23
advsetwindow "15"

langjp「うふふふふふ。@わかりますでしょうか。」@
;＜紗音
langen:dwave 0, "voice\15\80500035.ogg":^"Heheheheheheheh.^@:dwave 0, "voice\15\80500036.ogg":^  Do you get it?"^\
advsetwindow "11"


langjp「……縁寿、ローマ字は何となくわかるけど、英語はわかんない。」\
;＜縁寿
langen:dwave 0, "voice\11\82000629.ogg":^"...If it's about letters, spelling out big words like that is hard."^\
advsetwindow "15"


langjp「ローマ字がわかれば充分ですよ。@英語はわからなくて大丈夫です。@絵羽さまと協力すれば、きっと解けますよ。」@
;＜紗音
langen:dwave 0, "voice\15\80500037.ogg":^"You don't need to know how to spell any hard words.^@:dwave 0, "voice\15\80500038.ogg":^  If you and Eva-sama work together, ^@:dwave 0, "voice\15\80500039.ogg":^I know you'll be able to solve it."^\

_ld r,":b;sprites\en2\1\en2_a11_def2.png",80
advsetwindow "11"

langjp「他にもヒントないの？」\
;＜縁寿
langen:dwave 0, "voice\11\82000630.ogg":^"Don't you have any more hints?"^\

_ld l,":b;sprites\sha\1\sha_a11_tokui1.png",80
advsetwindow "15"

langjp「ありますよ。@他の食べ物のアルファベットもお教えします。@まず、Ａ＝アーモンドチョコ。@Ｓ＝シャーベットのレモン味。@Ｋ＝キムチ。@Ｎ＝苦い緑茶。@うふふふふふ……。」\
;＜紗音
langen:dwave 0, "voice\15\80500040.ogg":^"I do.^@:dwave 0, "voice\15\80500041.ogg":^  I'll teach you the letters for some other foods.^@:dwave 0, "voice\15\80500042.ogg":^  First, watermelon is `W'.^@:dwave 0, "voice\15\80500043.ogg":^  For `P', how about picante potatoes?^@:dwave 0, "voice\15\80500044.ogg":^  Albacore tuna is an `A'.^@:dwave 0, "voice\15\80500045.ogg":^  Orange-lime sherbet would probably be an `O'.^@:dwave 0, "voice\15\80500046.ogg":^  Heheheheheheheh..."^\

bg new_mhal_h1c,24
_ld r,":b;sprites\eva\1\eva_a11_komaru1.png",24
advsetwindow "05"

langjp「やっぱりローマ字の頭文字に思えるわ……。@でもそれじゃ、ブラックコーヒーのＮがわかんないのよねぇ……。」\
;＜絵羽
langen:dwave 0, "voice\05\81000326.ogg":^"It really does sound like the first letter is the key...^@:dwave 0, "voice\05\81000327.ogg":^  But then how do you explain lemonade being `O'...?"^\

_ld c,":b;sprites\en2\1\en2_a11_def1.png",23
advsetwindow "11"

langjp「……縁寿はＡの食べ物が好き。@シュークリームやケーキはＡに入る？」@
;＜縁寿
langen:dwave 0, "voice\11\82000631.ogg":^"...I love `W' foods.^@:dwave 0, "voice\11\82000632.ogg":^  Cookies and cake are `W', right?"^\

_ld l,":b;sprites\sha\1\sha_a11_warai1.png",23
advsetwindow "15"

langjp「えぇ、入りますよ。」\
;＜紗音
langen:dwave 0, "voice\15\80500047.ogg":^"That's right."^\

bg black,22
bg new_mhal_h1a,0
_ld c,":b;sprites\kan\1\kan_a11_majime1.png",22
advsetwindow "16"

langjp「ということはやはり、@名前のローマ字の頭文字じゃないんだ…。」\
;＜嘉音
langen:dwave 0, "voice\16\80600035.ogg":^"So, ^@:dwave 0, "voice\16\80600036.ogg":^it isn't the first letter after all..."^\

_ld l,":b;sprites\eva\1\eva_a11_komaru1.png",23
advsetwindow "05"

langjp「どういうこと？@　Ａのグループは何？@　甘納豆とアーモンドチョコよね。@デザート？@　お菓子？@　Ｓは塩せんべいとレモンシャーベット？@　Ｋはカレーとキムチで、Ｎはコーヒーと緑茶？@　これ、何のグループ？？」\
;＜絵羽
langen:dwave 0, "voice\05\81000328.ogg":^"What's going on?^@:dwave 0, "voice\05\81000329.ogg":^  Is the `W' group about desserts?^@:dwave 0, "voice\05\81000330.ogg":^  But watermelon isn't a dessert...^@:dwave 0, "voice\05\81000331.ogg":^  `P' is picante potatoes and pepper jack cheese?^@:dwave 0, "voice\05\81000332.ogg":^  `A' is anchovy pizza and albacore tuna?^@:dwave 0, "voice\05\81000333.ogg":^  `O' is lemonade and orange-lime sherbet?^@:dwave 0, "voice\05\81000334.ogg":^  Just what are these ^@:dwave 0, "voice\05\81000335.ogg":^groups??"^\

_ld r,":b;sprites\en2\1\en2_a11_def3c.png",24
advsetwindow "11"

langjp「……わかるような、わかんないような、@……何だかもどかしい。」\
;＜縁寿
langen:dwave 0, "voice\11\82000633.ogg":^"...I sort of get it, but I sort of don't.^@:dwave 0, "voice\11\82000634.ogg":^  ...It's a little annoying."^\

bg black,23
bg new_mhal_h1c,0
_ld l,":b;sprites\sha\1\sha_a11_tokui1.png",23
advsetwindow "15"

langjp「では最後のヒントを。@皆様はレモネードをお飲みになったことはございますか？」@
;＜紗音
langen:dwave 0, "voice\15\80500048.ogg":^"One last hint.^@:dwave 0, "voice\15\80500049.ogg":^  I'm sure your parents don't let you drink coffee, but do you know how it's supposed to taste?"^\

_ld c,":b;sprites\en2\1\en2_a11_def2a.png",24
advsetwindow "11"

langjp「ある。@最初、甘いジュースだと思ったから、すごいびっくりした。@二度と飲まないっ。」\
;＜縁寿
langen:dwave 0, "voice\11\82000635.ogg":^"I had a little once.^@:dwave 0, "voice\11\82000636.ogg":^  I thought it was gonna be sweet, so I was really surprised.^@:dwave 0, "voice\11\82000637.ogg":^  I'll never drink it again."^\

_ld r,":b;sprites\eva\1\eva_b25_def1.png",24
advsetwindow "05"

langjp「…………あ、……わかった！@　縁寿ちゃん、ありがとう。@あなたのお陰で多分、わかったわ！」\
;＜絵羽
langen:dwave 0, "voice\05\81000336.ogg":^"...Ah, ...I've got it!^@:dwave 0, "voice\05\81000337.ogg":^  Ange-chan, thank you.^@:dwave 0, "voice\05\81000338.ogg":^  Thanks to you, I've probably figured it out!"^\

bg black,2

return



;■不正解の場合（「Ｓ」以外）
*SHA_hazure
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2

bg new_mhal_h1c,22
_ld c,":b;sprites\sha\1\sha_a11_tokui1.png",22
advsetwindow "15"

langjp「降参ですか？@　嘉音くんは？」\
;＜紗音
langen:dwave 0, "voice\15\80500050.ogg":^"Giving up?^@:dwave 0, "voice\15\80500051.ogg":^  What about you, Kanon-kun?"^\

bg new_mhal_h1a,23
_ld l,":b;sprites\kan\1\kan_a13_nayamu1.png",23
advsetwindow "16"

langjp「……わかんないよ。@……わかりそうでわからない…。」@
;＜嘉音
langen:dwave 0, "voice\16\80600037.ogg":^"...I don't get it.^@:dwave 0, "voice\16\80600038.ogg":^  ...I think I almost do, but..."^\

_ld c,":b;sprites\en2\1\en2_a11_def3a.png",24
advsetwindow "11"

langjp「うん。@それぞれのグループに意味がありそうに感じるのに、あと一歩がわからない。」\
;＜縁寿
langen:dwave 0, "voice\11\82000638.ogg":^"Yeah.^@:dwave 0, "voice\11\82000639.ogg":^  I almost know what all the groups mean, but I can't figure out that last step."^\

_ld r,":b;sprites\eva\1\eva_b25_akire2go.png",23
advsetwindow "05"

langjp「これ、……味のことね？」\
;＜絵羽
langen:dwave 0, "voice\05\81000339.ogg":^"It's...tastes, right?"^\

bg black,23
bg new_mhal_h1c,0
_ld l,":b;sprites\sha\1\sha_a11_warai2.png",23
advsetwindow "15"

langjp「はい、そうです。@縁寿さまも嘉音くんも、まだお気付きになりませんか？」@
;＜紗音
langen:dwave 0, "voice\15\80500052.ogg":^"Yes, that's right.^@:dwave 0, "voice\15\80500053.ogg":^  Have you figured it out now, Ange-sama and Kanon-kun?"^\

_ld r,":b;sprites\en2\1\en2_a11_def2b.png",24
advsetwindow "11"

langjp「わからないっ。@絵羽伯母さん、どういうこと？@　教えてっ。」\
;＜縁寿
langen:dwave 0, "voice\11\82000640.ogg":^"I don't get it!^@:dwave 0, "voice\11\82000641.ogg":^  What is it, Aunt Eva?^@:dwave 0, "voice\11\82000642.ogg":^  Tell me!"^\

bg black,24
bg new_mhal_h1a,0
_ld r,":b;sprites\eva\1\eva_a11_hohoemi1.png",24
advsetwindow "05"

langjp「Ａのグループは全部、甘い食べ物でしょう？@　じゃあ、Ｓは？@　Ｋは？」@
;＜絵羽
langen:dwave 0, "voice\05\81000340.ogg":^"Everything in the `W' group is sweet, right?^@:dwave 0, "voice\05\81000341.ogg":^  So, what about the `O' group?^@:dwave 0, "voice\05\81000342.ogg":^  The `P' group?"^\

_ld c,":b;sprites\kan\1\kan_a11_komaru1.png",23
advsetwindow "16"

langjp「………そうか、そういうことだったのか……。@姉さんにしては、やるね…。」\
;＜嘉音
langen:dwave 0, "voice\16\80600039.ogg":^"...I see, so that's what it was...^@:dwave 0, "voice\16\80600040.ogg":^  Not bad, coming from you, Nee-san..."^\

_ld l,":b;sprites\sha\1\sha_a11_tokui1.png",23
advsetwindow "15"

langjp「姉さんを馬鹿にしてごめんなさいって言ってごらん？@　言わないと嘉音くんのごはん、ＳとかＮのものばっかりにしちゃうからね。」@
;＜紗音
langen:dwave 0, "voice\15\80500054.ogg":^"Why don't you try saying `Sorry for making fun of you'?^@:dwave 0, "voice\15\80500055.ogg":^  If you don't, I'll make all your meals `O' and `I'."^\

_ld r,":b;sprites\eva\1\eva_a11_akire1.png",80
advsetwindow "05"

langjp「Ｓはともかく、Ｎばっかりというのは辛いわねぇ。」\
;＜絵羽
langen:dwave 0, "voice\05\81000343.ogg":^"`O' is one thing, but eating `I' all the time would be awful."^\
advsetwindow "-1"

langjp　結局、嘉音はＮ料理責めに屈し、紗音に謝罪しなければならなかった。@
langen^In the end, Kanon caved under the threat of `I' cooking and was forced to apologize to Shannon.^@
advsetwindow "-1"
;br
langjp　縁寿だけが未だによく答えがわかっていない。\
langen^Ange was still confused.^\

bg black,22
advsetwindow "-1"

langjp　これ以上は考えても仕方ない。@
langen^No point thinking about it anymore.^@
advsetwindow "-1"
;br
langjp　気を取り直して、次の問題でがんばろう。\
langen^I've got to pull myself together and take a shot at the next one.^\

;★合流地点へ
goto *KANSHA_quizend



