effect 26,18,300,":c;Bmp\Efe\up.bmp"
effect 46,18,3000,":c;Bmp\Efe\up.bmp"
effect 66,15,300,":c;Bmp\Efe\up.bmp"
effect 86,15,5,":c;Bmp\Efe\up.bmp"

;上面右、下面左フェード
