bg new_moon_1b,2
;print 99,3000,"trvswave.dll/"

bgm1 167
advsetwindow "-1"

langjp　気付けばもう、自らを若者と呼べば、若者たちに笑われそうになる歳になっていた。@
langen^Before I realized it, I had reached an age at which the young would laugh at me if I tried to call myself young.^@
advsetwindow "-1"
;br
langjp　気が遠くなるような、長くても何も中身のない灰色の日々。@
langen^That dizzyingly long stretch of gray was left completely empty.^@
advsetwindow "-1"
;br
langjp　それは２０年にも及んだ。\
langen^It lasted for a full 20 years.^\
advsetwindow "-1"

langjp　２０年あれば、人は生まれ、志を持ち、社会へ飛び出すことさえ出来る。@
langen^In 20 years, a person can be born, find a purpose, and even become their own man with their own place in the world.^@
advsetwindow "-1"
;br
langjp　つまり、……社会人となって初めて人間と呼べるのだとしたら。@
langen^In short, ...if one truly becomes a human only when they have become a working adult...^\
advsetwindow "-1"
;br
langjp　私は、人間が一人、生み出せるほどの膨大な時間を、@……何もすることなく、欲深な老人たちの人形として過ごしてきたわけだ。\
langen^Then I spent a period of time long enough to create a human...^@^doing nothing but playing the part of those greedy elders' puppet.^\

bg black,22
advsetwindow "-1"

langjp　そんな日々は、体を老いさせても、皮肉にも、心は老いさせない。\
langen^Ironically, though that time aged my body, it did not age my mind.^\
advsetwindow "-1"

langjp　心だけは、小田原に呼び出される直前の、/
langjp!d400……あの充実した日々を懐かしむ、若いまま。@
langen^My mind alone...^@/
advsetwindow "-1"
langen!d400^was still as young as it had been during those rich, happy days before I was summoned to Odawara.^@
advsetwindow "-1"
;br
langjp　なのに体だけは老いを重ね、いつしか、その乖離は理解し難いほどにまで広がった。@
langen^And yet, my body alone grew older and older.^\^  Eventually, the vast gap between the two reached almost incomprehensible levels.^@
advsetwindow "-1"
;br
langjp　だから、鏡に映る、疲れ切った男が、とても自分と思えない。\
langen^So, I could hardly believe that the worn-out man in the mirror was really me.^\
advsetwindow "-1"

;bg Different_spiral_1a,8

langjp　いや、本当に自分ではないのだ。@
langen^No, it really wasn't me.^@
advsetwindow "-1"
;br
langjp　右代宮家当主などとは、名ばかり。@
langjp　何の権限もない。@自主性も必要ない。@余計なことをする必要もない。@
langen^The `Head of the Ushiromiya family' was just a name.^@
advsetwindow "-1"
langen^It had no power.^@^  It didn't require that I have any independence.^@^  There was no need for me to get involved with anything.^@
advsetwindow "-1"
;br
langjp　ひな壇に飾られたまま、埃を積もらせ、……ただただじっとしているだけの、お人形。\
langen^I was just a doll sitting there on the doll rack, gathering dust.^\

bg new_mlib_1g,2
advsetwindow "-1"

langjp　私はぼんやりと、好きな洋書を漁り、自分だけの世界に閉じ篭り、@……悪い酒と薔薇いじりを覚えただけ。@
langen^I remember nothing but lazily flipping through Western books I liked, locking myself up inside my own world,^@^ ...doing nothing but playing with roses and drinking terrible drinks.^@
advsetwindow "-1"
;br
langjp　それが、２０年も。\
langen^And it lasted a full 20 years.^\

bg black,22
advsetwindow "-1"

langjp　気付けば。@
langen^Before I knew it...^@
advsetwindow "-1"
;br
langjp　いつの間にか、知らぬ妻がいた。@
langjp　……自分が選んだ妻ではない。@
langen^I suddenly had a wife I did not know.^@
advsetwindow "-1"
langen^...It wasn't any wife I had chosen.^\
advsetwindow "-1"
;br
langjp　長老たちが、彼らの都合で選び、強いた、どこぞのやんごとなき一族の姫君らしかったが、@……どうでもいい。\
langen^It was the daughter of some noble family that the elders had chosen and forced on me for their own reasons,^@^ ...but that did not matter to me.^\
advsetwindow "-1"

langjp　妻を愛してなかったし、かといって毛嫌いもしなかった。@
langen^I did not love my wife, but neither did I dislike her.^@
advsetwindow "-1"
;br
langjp　……どうでも良かったからだ。\
langen^...I just didn't care.^\
advsetwindow "-1"

;bg Different_spiral_1a,22

langjp　子供を何人か儲けるが、それも妻を愛していたからではない。@
langen^I fathered a few children, but that wasn't out of love for my wife.^@
advsetwindow "-1"
;br
langjp　気付いたら、勝手に生まれていた。@
langjp　……それだけだ。\
langen^They were just born before I knew it.^@
advsetwindow "-1"
langen^...That's all there was to it.^\

;bg black,22
mono off
advsetwindow "-1"

langjp　全てが、どうでも良かった。@
langjp　いや、違う。@
langen^None of it mattered.^@
advsetwindow "-1"
langen^No, that's not quite right.^@
advsetwindow "-1"
;br
langjp　……全てが、私でない誰かに決められ、私はただ従うだけ。@
langen^...Everything was decided by someone other than me, and I simply obeyed.^@
advsetwindow "-1"
;br
langjp　それが、右代宮家の当主という、/
langjp!d900………仕事だったのだ……。\
langen^That was the job...^@/
advsetwindow "-1"
langen!d900^of the `Ushiromiya Family Head'...^\

bg new_different_space_2d,0
_ld c,":b;sprites\ki2\1\ki2_a11_nayamu1.png",2
_ld c,":b;sprites\ki2\1\ki2_a11_komaru1.png",80
advsetwindow "01"

langjp「あぁ、このまま自分は、静かに殺されるなと、うっすらと感じていた。」\
;＜若金蔵
langen:dwave 0, "voice\58\75600029.ogg":^"Yes.  On some level, I did feel as though I was being slowly and quietly killed."^\

bg new_different_space_2a,0
_ld l,":b;sprites\rio\1\rio_a11_odoroki1.png",23
advsetwindow "53"

langjp「信じられません。@豪胆なる名君と讃えられたお祖父さまが、そのような日々を送っていたなんて……。」\
;＜理御
langen:dwave 0, "voice\53\75300203.ogg":^"I can't believe it.^@:dwave 0, "voice\53\75300204.ogg":^  To think that you, the one who has been praised for being such a bold and wise ruler, lived life like that for so long..."^\

_ld r,":b;sprites\ki2\1\ki2_a11_nayamu4.png",24
advsetwindow "01"

langjp「……理御よ。@自ら生きぬ人生ほど希薄で長いものはない。@なのに、それはあっという間に過ぎ去るのだ。@……心せよ。」@
;＜若金蔵
langen:dwave 0, "voice\58\75600030.ogg":^"...Lion,^@:dwave 0, "voice\58\75600031.ogg":^ there is nothing so long and faint as a life you do not live for yourself.^@:dwave 0, "voice\58\75600032.ogg":^  And yet, it slides on by in the blink of an eye.^@:dwave 0, "voice\58\75600033.ogg":^  ...Do not forget this."^\

_ld l,":b;sprites\rio\1\rio_a11_fuman1.png",80
advsetwindow "53"

langjp「自ら、生きる人生……。」\
;＜理御
langen:dwave 0, "voice\53\75300205.ogg":^"A life...you live for yourself..."^\

cl r,23
;ld c,kI2_NayamuA3,0
;ld r,WIL_FutekiA1,24
_ld r,":b;sprites\wil\1\wil_a11_def1.png",24
advsetwindow "54"

langjp「生きるってことは、意思を持つということだ。@……殺された日々だったろうよ。」@
;＜ウィル
langen:dwave 0, "voice\54\75400471.ogg":^"Living means having your own will.^@:dwave 0, "voice\54\75400472.ogg":^  ...You probably were dead during that time."^\

_ld c,":b;sprites\ki2\1\ki2_a11_komaru2.png",80
advsetwindow "01"

langjp「そうだ。@私は生きたかった。@いや、死にたかった。@/
langen:dwave 0, "voice\58\75600034.ogg":^"Precisely.^@:dwave 0, "voice\58\75600035.ogg":^  I wanted to live.^@:dwave 0, "voice\58\75600036.ogg":^  No, I wanted to die.^@/
advsetwindow "01"

;ld c,KI2_KomaruA2,80

langjp……操り人形はどうすれば死ねる？」\
;＜若金蔵
langen:dwave 0, "voice\58\75600037.ogg":^  ...How can a puppet die?"^\

_ld l,":b;sprites\rio\1\rio_a11_komaru1.png",80
advsetwindow "53"

langjp「…………………。@……糸を、断ち切ることです。」\
;＜理御
langen:dwave 0, "voice\53\75300206.ogg":^"......^@:dwave 0, "voice\53\75300207.ogg":^...By cutting...the strings."^\

;ld c,KI2_DefA1,80
bg black,22
advsetwindow "01"

langjp「そうだ。@それが死ぬことであり、生きることであり、/
langjp!d1000……解放だ。」\
;＜若金蔵
langen:dwave 0, "voice\58\75600038.ogg":^"Correct.^@:dwave 0, "voice\58\75600039.ogg":^  That would be death, and it would also be life, ^@/
advsetwindow "01"
langen:delay 3000:dwave 0, "voice\58\75600040.ogg":^...since it would mean being free."^\

fede 0,2000
E_A
advsetwindow "-1"



