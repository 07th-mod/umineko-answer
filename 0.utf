_ld l,":b;sprites\mar\1\mar_b11_def1.png",0
_ld r,":b;sprites\wil\1\wil_a11_majime2.png",22
_ld r,":b;sprites\wil\1\wil_a11_def1.png",80
advsetwindow "54"
;ld r,WIL_NayamuA1,26
;ld r,WIL_MajimeA1,80



langjp「確かに、唐突だな。」\
;＜ウィル
langen:dwave 0, "voice\54\75400581.ogg":^"Yeah, that is pretty sudden."^\

_ld l,":b;sprites\mar\1\mar_b11_warai1.png",80
advsetwindow "13"

langjp「うん。とっても。@………魔女や精霊は、いつだって私たちの側にいる。@彼らが姿を見せようとしないだけで。@そして、彼らが姿を見せたなら、……それはあまりに唐突に、そして当り前に、そこにいる。@……私はそれをまさに知ったの。」\
;＜真里亞
langen:dwave 0, "voice\13\70400106.ogg":^"Yep.  Really, really sudden.^@:dwave 0, "voice\13\70400107.ogg":^  ...There are witches and spirits right next to us all the time.^@:dwave 0, "voice\13\70400108.ogg":^  They just choose not to show themselves.^@:dwave 0, "voice\13\70400109.ogg":^  And, when they do show themselves, ...it's always sudden, as though they've been there the whole time.^@:dwave 0, "voice\13\70400110.ogg":^  ...That's what I learned that day."^\

_ld r,":b;sprites\wil\1\wil_a11_majime2.png",80
advsetwindow "54"

langjp「そして、ベアトリーチェと友達に？」\
;＜ウィル
langen:dwave 0, "voice\54\75400582.ogg":^"And then, you and Beatrice became friends?"^\

_ld l,":b;sprites\mar\1\mar_b22_warai2.png",80
advsetwindow "13"

langjp「うん。@彼女は、ママの用事が終わるまで、ずっと私とお喋りをしてくれた。@魔法の話や、魔女の話。@真里亞が聖霊の子であることも。」@
;＜真里亞
langen:dwave 0, "voice\13\70400111.ogg":^"Yeah.^@:dwave 0, "voice\13\70400112.ogg":^  She stayed and chatted with me the whole time, until Mama was done with her work.^@:dwave 0, "voice\13\70400113.ogg":^  We talked about magic...and witches.^@:dwave 0, "voice\13\70400114.ogg":^  And about how I was a child of the Holy Ghost."^\

_ld r,":b;sprites\wil\1\wil_a11_majime1.png",80
advsetwindow "54"

langjp「……その時のベアトリーチェの印象は？」\
;＜ウィル
langen:dwave 0, "voice\54\75400583.ogg":^"...And what was your impression of Beatrice then?"^\

_ld l,":b;sprites\mar\1\mar_b11_odoroki1.png",80
advsetwindow "13"

langjp「こういっては悪いけど。@知識だけなら私が上だった。@最初は彼女のことを、大した魔女じゃないと見下しかけた。@/
langen:dwave 0, "voice\13\70400115.ogg":^"I don't like saying it,^@:dwave 0, "voice\13\70400116.ogg":^ but my knowledge, at least, was better than hers back then.^@:dwave 0, "voice\13\70400117.ogg":^  At first, I thought she wasn't a very good witch.^@/

_ld l,":b;sprites\mar\1\mar_b22_warai2.png",80
advsetwindow "13"

langjp……まぁ、それは私の自惚れ。@魔法大系には色んなものがある。@ましてや私のそれは独学。@ベアトの魔法大系とは異なったから、私が一方的にそういう印象を持ってしまったんだろうね。@すぐにそれを後悔して謝ることになるの。」\
;＜真里亞
langen:dwave 0, "voice\13\70400118.ogg":^  ...Well, that was just my conceit.^@:dwave 0, "voice\13\70400119.ogg":^  There are so many different kinds of magical compendiums.^\:dwave 0, "voice\13\70400120.ogg":^  Plus, mine was based on self-study.^@:dwave 0, "voice\13\70400121.ogg":^  I probably only viewed Beato that way because her magical compendium was different from mine.^@:dwave 0, "voice\13\70400122.ogg":^  It wasn't long before I came to regret that and apologized."^\

_ld r,":b;sprites\wil\1\wil_a11_nayamu1.png",80
advsetwindow "54"

langjp「謝る？@　………ベアトリーチェが何か、お前の尊敬を勝ち取ることをしてみせたのか。@/
langen:dwave 0, "voice\54\75400584.ogg":^"Apologized?^@:dwave 0, "voice\54\75400585.ogg":^  ...Did Beatrice do something to win your respect?^@/

_ld r,":b;sprites\wil\1\wil_a11_def1.png",80
advsetwindow "54"

langjp…………なるほど。@魔法を、見せたというわけか。」\
;＜ウィル
langen:dwave 0, "voice\54\75400586.ogg":^  ......I see.^@:dwave 0, "voice\54\75400587.ogg":^  So, she showed you magic."^\

;■回想に戻る。
;■場所は浜辺

textoff

bg black,2

mov %MAR_Isyou,1

mono 1
bg new_sky_1a,2

;print 99,2000,"trvswave.dll/"
wait 500
mono off
print 2

wait 1500
bg black,24
bg new_beach_1af,24

me1v 2,50
advsetwindow "-1"

langjp　私たちは浜辺へ移り、パラソル付きテーブルでたくさんを語り合った。\
langen^We moved to the beach and talked lots, sitting at a table under an umbrella.^\

_ld c,":b;sprites\bea\1\bea_a11_nayamu1.png",23
advsetwindow "27"

langjp「なるほど。@……真里亞。@そなたは実に勤勉だ。@その歳で、千年の魔女の妾にそれだけの講釈を出来るとは、実に尊敬に値する。@/
langen:dwave 0, "voice\27\70700237.ogg":^"Very interesting.^@:dwave 0, "voice\27\70700238.ogg":^  ...Maria,^@:dwave 0, "voice\27\70700239.ogg":^ I see you have been quite diligent in your studies.^@:dwave 0, "voice\27\70700240.ogg":^  At your age, to be capable of teaching a thousand-year-old witch such as myself is truly an accomplishment worthy of admiration.^@/

_ld c,":b;sprites\bea\1\bea_a11_futeki2.png",80
advsetwindow "27"

langjp………して、そなたは何の魔法を使えるのか？」\
;＜ベアト
langen:dwave 0, "voice\27\70700241.ogg":^  ...So, what sort of magic can you use?"^\

_ld r,":b;sprites\mar\1\mar_a11_odoroki1.png",24
advsetwindow "13"

langjp「……魔法？」@
;＜真里亞
langen:dwave 0, "voice\13\70400123.ogg":^"...Magic?"^\

_ld c,":b;sprites\bea\1\bea_a11_akuwarai1.png",80
advsetwindow "27"

langjp「そなたが魔女を語るならば、魔法のひとつも見せられるであろうが。」\
;＜ベアト
langen:dwave 0, "voice\27\70700242.ogg":^"If you call yourself a witch, you must be able to show me some sort of magic, correct?"^\

bg new_sky_1a,25
advsetwindow "-1"

langjp　私は、きょとんとしてしまった。@
langjp　それは、何て当り前の話だろう。\
langen^I was stunned for a second.^@
advsetwindow "-1"
langen^Of course, it should have been obvious.^\
advsetwindow "-1"

langjp　私は聖霊の子で、オカルトを勉強したからニンゲンではない、魔女だと。@その日まで当り前のように強く確信していた。@
langen^I was a child of the Holy Ghost, and since I'd studied so much of the occult, I was also a witch, not a Human.^@^  Until that day, I had been so sure of both of those things.^@
advsetwindow "-1"
;br
langjp　だから、どんな魔法が使えるのかと聞かれ、私は呆然としてまった…。\
langen^So, when I was asked what sort of magic I could use, it left me in a daze...^\

bg black,22
bg new_beach_2af,0
_ld r,":b;sprites\bea\1\bea_a11_1_warai1.png",22
_ld r,":b;sprites\bea\1\bea_a11_def2.png",80
advsetwindow "27"

langjp「魔法を知り、語るに至ってようやく見習いよ。@……そして、それを魔法という形で実践できてこそ、魔女というものではないか？」@
;＜ベアト
langen:dwave 0, "voice\27\70700243.ogg":^"When one knows of magic and can speak of it, they finally reach the rank of apprentice.^@:dwave 0, "voice\27\70700244.ogg":^  ...One is only a witch if they can put such knowledge into practice and use magic, correct?"^\

_ld l,":b;sprites\mar\1\mar_a22_komaru1.png",23
advsetwindow "13"

langjp「……真里亞は、………まだ、魔女じゃないの……？」\
;＜真里亞
langen:dwave 0, "voice\13\70400124.ogg":^"...So, ...I'm not a witch yet...?"^\

_ld r,":b;sprites\bea\1\bea_a11_futeki2.png",80
advsetwindow "27"

langjp「よく学んでいる。@そして、類稀な才能も感じる。@そなたはやがて、妾など足元にも及ばぬ偉大な魔女、@……あるいはそなたが言うように、造物主の座にさえ登りつめるだろう。@/
langen:dwave 0, "voice\27\70700245.ogg":^"You have studied well.^@:dwave 0, "voice\27\70700246.ogg":^  And, I can sense a very rare talent within you.^@:dwave 0, "voice\27\70700247.ogg":^  One day, you may become a witch so great that even I could not compare,^@:dwave 0, "voice\27\70700248.ogg":^ ...or perhaps even a Creator as you have told me.^@/
advsetwindow "27"

;ld r,BEA_MajimeA5,80

langjpしかし、まだ幼く、若い。@………そなたは、そう。@見習いだ。@魔女の見習いというところよ。」\
;＜ベアト
langen:dwave 0, "voice\27\70700249.ogg":^  However, you are still young and immature.^@:dwave 0, "voice\27\70700250.ogg":^  ...You are...yes.^@:dwave 0, "voice\27\70700251.ogg":^  You are an apprentice.^@:dwave 0, "voice\27\70700252.ogg":^  A witch apprentice, you might call it."^\

cl l,0
ut_mld c,":b;sprites\mar\1\mar_a22_warai1.png",23
advsetwindow "13"

langjp「じゃあ、ベアトは魔法を使うことが出来るの？」@
;＜真里亞
langen:dwave 0, "voice\13\70400125.ogg":^"So, does that mean you can use magic, Beato?"^\

_ld r,":b;sprites\bea\1\bea_a11_akuwarai1.png",80
advsetwindow "27"

langjp「無論であるとも。@魔法を使えずして、魔女を名乗ることなど出来ぬわ。」\
;＜ベアト
langen:dwave 0, "voice\27\70700253.ogg":^"Of course.^@:dwave 0, "voice\27\70700254.ogg":^  I could not call myself a witch otherwise."^\

ut_mld c,":b;sprites\mar\1\mar_a11_odoroki1.png",80
advsetwindow "13"

langjp「すごい……。@……見せてっ！@　ベアトの魔法、見せて！！」\
;＜真里亞
langen:dwave 0, "voice\13\70400126.ogg":^"Incredible...^@:dwave 0, "voice\13\70400127.ogg":^  ...Show me!^@:dwave 0, "voice\13\70400128.ogg":^  I wanna see your magic!!"^\

mcl a,0
mbg black,22
advsetwindow "-1"

langjp　真里亞は、自分が聖霊の子という、魔法的な概念を、今日まで疑ったことはない。@
langjp　……しかし、オカルト的事象が実在することを、他人によって示されたことはない。@
langen^Until this day, Maria had never doubted the magic-themed idea that she was the child of the Holy Ghost.^@
advsetwindow "-1"
langen^...However, no one had ever proven to her that occult phenomena actually existed.^\
advsetwindow "-1"

;br
langjp　真里亞は宇宙を１人でも生み出せる。@……しかし、より強く信じるために、もう１人を欲した。\
langen^Maria could create a universe all by herself.^@^  ...However, she wanted to share it with a second person, so that she could believe in it even more strongly.^\

ut_mld c,":b;sprites\mar\1\mar_a11_odoroki1.png",0
mcbg 22

mcl a,0
cl a,0
bg new_beach_2af,23
_ld c,":b;sprites\bea\1\bea_a11_majime1.png",26
advsetwindow "27"

langjp「かつての妾ならば、空に虹をかけ、@それを七色のキャンディーに変えて自由にかじらせることも出来た。@しかし今の妾は姿を保つことさえ満足に出来ぬほどに衰えている。」\
langen:dwave 0, "voice\27\70700255.ogg":^"Once, I could have drawn a rainbow in the sky, ^@:dwave 0, "voice\27\70700256.ogg":^transformed it into seven colors of candy, and eaten them at my leisure.^@:dwave 0, "voice\27\70700257.ogg":^  However, my power has weakened so much that I cannot even preserve my form to my satisfaction."^\

bg new_beach_1af,0
_ld r,":b;sprites\mar\1\mar_a11_fukigen2.png",24
advsetwindow "13"

;＜ベアト
langjp「さっき聞いた。@あの鎮守の社のせいで、力が出せないって。」\
;＜真里亞
langen:dwave 0, "voice\13\70400129.ogg":^"You told me about that.^@:dwave 0, "voice\13\70400130.ogg":^  You can't use your full power because of the shrine."^\

_ld l,":b;sprites\bea\1\bea_a11_nayamu1.png",80
advsetwindow "27"

langjp「力を取り戻すにはかなりの時間をかける。@虹をキャンディーにしてやることは今は出来ぬ。@/
langen:dwave 0, "voice\27\70700258.ogg":^"It will take quite some time before my power returns.^@:dwave 0, "voice\27\70700259.ogg":^  At this moment, I cannot turn rainbows to candy.^@/

_ld l,":b;sprites\bea\1\bea_a11_def1.png",80
advsetwindow "27"

langjp……しかし、ささやかな魔法にて、その一端を見せることは出来ようぞ。」@
;＜ベアト
langen:dwave 0, "voice\27\70700260.ogg":^  ...However, perhaps I can show you a bit of that power with some simpler magic."^\

_ld r,":b;sprites\mar\1\mar_a22_warai1.png",80
advsetwindow "13"

langjp「見たい…！@　ベアトの魔法、見たい…！！」\
;＜真里亞
langen:dwave 0, "voice\13\70400131.ogg":^"I wanna see...!^@:dwave 0, "voice\13\70400132.ogg":^  I wanna see your magic...!!"^\

_ld l,":b;sprites\bea\1\bea_a11_1_warai1.png",80
advsetwindow "27"

langjp「良かろう。@しかし、そなたにも協力を求めねばならぬぞ。@/
langen:dwave 0, "voice\27\70700261.ogg":^"Very well.^@:dwave 0, "voice\27\70700262.ogg":^  However, I must ask for your assistance.^@/
advsetwindow "27"

;ld l,BEA_futekiA1,80

langjp先ほども言った。@如何にそなたが穢れなき魂を持とうとも、ニンゲンはもはや穢れ、魔法を拒む毒素に満ちていると。」@
;＜ベアト
langen:dwave 0, "voice\27\70700263.ogg":^  As I have already told you, ^@:dwave 0, "voice\27\70700264.ogg":^no matter how pure your soul might be, all Humans are tainted and filled with the toxin that resists magic."^\

_ld r,":b;sprites\mar\1\mar_a22_majime1.png",80
advsetwindow "13"

langjp「うん、聞いた。@反魔法の毒素があるって聞いた。@真里亞の呼んだ本には載ってなかった。@だからそれを知ってるベアトはすごい。」\
;＜真里亞
langen:dwave 0, "voice\13\70400133.ogg":^"Yeah, I remember.^@:dwave 0, "voice\13\70400134.ogg":^  You told me about the anti-magic toxin.^@:dwave 0, "voice\13\70400135.ogg":^  It wasn't in any of the books I've read.^@:dwave 0, "voice\13\70400136.ogg":^  You must really be incredible to know so much."^\

bg black,25
bg new_beach_2af,25
advsetwindow "-1"

langjp　ベアトリーチェは空のティーカップを取ると、@種を仕掛けもございませんとでも言うように、それを真里亞の前でくるくると回す。\
langen^Beatrice lifted up an empty teacup,^@^ then turned it around in front of Maria to show that there weren't any tricks or strings.^\


bg black,22

fede 10,1000
E_MA

mov %MAR_Isyou,2
bg new_different_space_2a,0
_ld l,":b;sprites\mar\1\mar_b11_warai1.png",0
_ld r,":b;sprites\wil\1\wil_a11_nayamu1.png",22
_ld r,":b;sprites\wil\1\wil_a11_def1.png",80
advsetwindow "54"

langjp「伏せたカップに、キャンディーが現れる魔法か。」@
;＜ウィル
langen:dwave 0, "voice\54\75400588.ogg":^"Right, the magic to make candy appear inside an overturned cup."^\

_ld l,":b;sprites\mar\1\mar_b22_warai2.png",80
advsetwindow "13"

langjp「どうしてわかるの？！@　ウィルはすごいね、魔女の使う魔法もわかるんだね！」\
;＜真里亞
langen:dwave 0, "voice\13\70400137.ogg":^"How did you know?!^@:dwave 0, "voice\13\70400138.ogg":^  You're incredible, Will!  You even know about witch magic!"^\

_ld r,":b;sprites\wil\1\wil_a11_nayamu1.png",80
advsetwindow "54"

langjp「…………魔女の魔法の、基本だからな。」\
;＜ウィル
langen:dwave 0, "voice\54\75400589.ogg":^"...It's...the most basic sort of witch magic, after all."^\

_ld l,":b;sprites\mar\1\mar_b22_odoroki1.png",80
advsetwindow "13"

langjp「カップは何の仕掛けもない、普通のカップだったよ。@私は見たかった。本当の魔法を見たかった。」\
;＜真里亞
langen:dwave 0, "voice\13\70400139.ogg":^"It was just a normal cup, without any tricks in it.^@:dwave 0, "voice\13\70400140.ogg":^  I wanted to see.  I wanted to see true magic."^\


