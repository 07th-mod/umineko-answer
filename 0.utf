;＜さくたろ
langen:dwave 0, "voice\33\84200017.ogg":^"...Uryu-.^@:dwave 0, "voice\33\84200018.ogg":^  What kind of miracle?"^\

_ld r,":b;sprites\mar\1\mar_a22_def1.png",24
