bgm1 126

bg new_different_space_1a,22
_ld l,":b;sprites\bea\1\bea_a11_def2.png",22
advsetwindow "27"

langjp「もはや言うには及ぶまい。@犯人グループの、子供の犯人が誰かは、すでに明白であろう。」\
;＜ベアト
langen:dwave 0, "voice\27\80700645.ogg":^"It should be obvious by now.^@:dwave 0, "voice\27\80700646.ogg":^  The name of the child culprit in this culprit group is clear."^\

_ld r,":b;sprites\but\1\but_d11_majime6.png",24
advsetwindow "10"

langjp「だな。@子供は、たった１人の例外を除いて全員、シロが確定している。」\
;＜戦人
langen:dwave 0, "voice\10\80100888.ogg":^"Pretty much.^@:dwave 0, "voice\10\80100889.ogg":^  All of the kids have been proven innocent, with one exception."^\

_ld l,":b;sprites\bea\1\bea_a11_majime1.png",80
advsetwindow "27"

