advsetwindow "13"

langjp「白き魔女になるか、黒き魔女になるか。@……それは縁寿が決めるよ。@私は、その両方を伝えた。」\
;＜真里亞
langen:dwave 0, "voice\13\80400169.ogg":^"Will she become a white witch or a black witch?^@:dwave 0, "voice\13\80400170.ogg":^  ...That's for Ange to choose.^@:dwave 0, "voice\13\80400171.ogg":^  I've shown her both sides."^\

cl c,0
_ld r,":b;sprites\ros\1\ros_a11_komaru1.png",23
advsetwindow "12"

langjp「きっと、彼女を辛い人生が待ってる。@縁寿ちゃんはきっと、世界一自分が孤独だと信じると思う。@……でも、私たちはあなたのすぐ後ろにいて、いつも応援しているからね。@それを、忘れないでね……。」\
;＜楼座
langen:dwave 0, "voice\12\81400076.ogg":^"I'm sure a painful life lies ahead for you.^@:dwave 0, "voice\12\81400077.ogg":^  You'll probably believe that you're all alone in this world.^@:dwave 0, "voice\12\81400078.ogg":^  ...But we will always be there right behind you, cheering you on.^@:dwave 0, "voice\12\81400079.ogg":^  Don't forget that..."^\

mcl l,0

bg black,24
bg new_mhal_h1c,0
_ld r,":b;sprites\jes\1\jes_a11_majime1.png",24
advsetwindow "04"

langjp「縁寿……。@忘れるんじゃないぜ。@自分も、幸せも、運命も。@作るのは自分なんだ。@自分だけが決められる。@それは誰かに与えられるものでも、そして誰かに隠されて探すものでもない。@……それを、忘れるんじゃないぜ。」\
;＜朱志香
langen:dwave 0, "voice\04\80200083.ogg":^"Ange,^@:dwave 0, "voice\04\80200084.ogg":^ ...don't forget.^@:dwave 0, "voice\04\80200085.ogg":^  Your self, your happiness, your fate...^@:dwave 0, "voice\04\80200086.ogg":^  These are all things you create for yourself.^@:dwave 0, "voice\04\80200087.ogg":^  Only you can choose them.^@:dwave 0, "voice\04\80200088.ogg":^  No one else can give you them, and no one else can hide them from you.^@:dwave 0, "voice\04\80200089.ogg":^  ...Don't forget that."^\

_ld l,":b;sprites\kan\1\kan_a11_def2.png",80
advsetwindow "16"
langjp「きっと、伝わったと信じます。」@
;＜嘉音
langen:dwave 0, "voice\16\80600077.ogg":^"I'm sure your message reached her."^\

_ld r,":b;sprites\jes\1\jes_a11_tohoho3.png",80
advsetwindow "04"

langjp「……だといいけど。」\
;＜朱志香
langen:dwave 0, "voice\04\80200090.ogg":^"...I hope so."^\

_ld l,":b;sprites\kan\1\kan_a11_warai1.png",80
advsetwindow "16"

langjp「僕とお嬢様の物語は、絶対に縁寿さまにそれを伝えています。」@
;＜嘉音
langen:dwave 0, "voice\16\80600078.ogg":^"I'm certain the tale of the two of us will help Ange-sama understand."^\

_ld r,":b;sprites\jes\1\jes_a11_def2.png",80
advsetwindow "04"

langjp「……………うん。」\
;＜朱志香
langen:dwave 0, "voice\04\80200091.ogg":^"......Yeah."^\

