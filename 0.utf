advsetwindow "27"

langjp「そうか、わかったぞ！@　戦人、ト書きだ！@　セリフ以外のト書き部分にウソはないことになっていたぞ！」@
;＜ベアト
langen:dwave 0, "voice\27\80700459.ogg":^"Yes, I've got it!^@:dwave 0, "voice\27\80700460.ogg":^  Battler, it's the narrated parts!^@:dwave 0, "voice\27\80700461.ogg":^  We've been told that there are no lies in the narrated sections!"^\

_ld l,":b;sprites\but\1\but_d11_futeki3.png",23
advsetwindow "10"

langjp「おう、俺も今、気付いたとこだ。@ベルンカステルは赤き真実で、ト書き部分にはウソがないことを宣言している。」\
;＜戦人
langen:dwave 0, "voice\10\80100674.ogg":^"Ah, I just realized that too.^@:dwave 0, "voice\10\80100675.ogg":^  Bernkastel announced in red that there are no lies in the narration."^\

bg black,24
bg new_different_space_1c,0
_ld l,":b;sprites\lam\1\lam_a11_akuwarai2.png",24
advsetwindow "29"

langjp「あら、気付かれちゃったみたいよ…？」@
;＜ラムダ
langen:dwave 0, "voice\29\82200123.ogg":^"Oh, looks like they figured it out..."^\

_ld r,":b;sprites\ber\1\ber_a21_def2.png",24
advsetwindow "28"

langjp「……気付かなくちゃ始まらないわよ。」\
;＜ベルン
langen:dwave 0, "voice\28\82100162.ogg":^"...They wouldn't get anywhere if they didn't."^\

bg black,23
bg new_different_space_1a,0
_ld l,":b;sprites\bea\1\bea_a13_1_majime5star.png",23
advsetwindow "27"

langjp「ト書きで、死亡を宣告されているヤツはおらぬか？！@　そいつは、本当に死んでいると断言できることになる！」\
;＜ベアト
langen:dwave 0, "voice\27\80700462.ogg":^"Are there any deaths confirmed by the narration?!^@:dwave 0, "voice\27\80700463.ogg":^  That would mean we can say for sure that the person in question is dead!"^\

_ld r,":b;sprites\but\1\but_d11_nayamu2.png",24
advsetwindow "10"

langjp「そしてそいつは、自動的に犯人でないということになる。」\
;＜戦人
langen:dwave 0, "voice\10\80100676.ogg":^"And that automatically means they aren't the culprit."^\

_ld l,":b;sprites\bea\1\bea_a13_futeki1.png",80
advsetwindow "27"

langjp「のみならず、そやつの紫は信頼できるということになる！」\
;＜ベアト
langen:dwave 0, "voice\27\80700464.ogg":^"And on top of that, it means we can trust their purple!"^\

_ld r,":b;sprites\but\1\but_d11_futeki3.png",80
advsetwindow "10"

langjp「ト書きで死亡を語られている人物を探してみよう。@“横たわっていた”、みたいな、生きてるようにも死んでるようにも見える曖昧な表現でないヤツをだ。」\
;＜戦人
langen:dwave 0, "voice\10\80100677.ogg":^"Let's look for deaths that are mentioned in the narration.^@:dwave 0, "voice\10\80100678.ogg":^  Ones that aren't vague about whether the person is alive or dead, like `X was lying on the ground'."^\

cl l,23
ut_mld c,":b;sprites\bea\1\bea_a11_1_majime6.png",23
advsetwindow "27"

langjp「うむッ、頭からもう一度探すぞ！」\
;＜ベアト
langen:dwave 0, "voice\27\80700465.ogg":^"Yes, let's read through it once more from the start!"^\

mcl c,0

bg black,2

fede 0,1000
E_A

