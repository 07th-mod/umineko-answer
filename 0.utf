;＜嘉音
langen:dwave 0, "voice\16\80600043.ogg":^"It seems the others still have some brain-twisters waiting for you.^@:dwave 0, "voice\16\80600044.ogg":^  Please be careful."^\

_ld c,":b;sprites\eva\1\eva_a11_hohoemi1.png",24
advsetwindow "05"

