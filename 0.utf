;＜夏妃
langen:dwave 0, "voice\03\80900058.ogg":^"...That was no reason...^@:dwave 0, "voice\03\80900059.ogg":^for me to push you off a cliff..."^\
advsetwindow "27"

;ld c,BEA_DefA1,80

langjp「そうであるな。@それは、そなたが生涯、背負うべき十字架であろう。」\
;＜ベアト
langen:dwave 0, "voice\27\80700247.ogg":^"True.^@:dwave 0, "voice\27\80700248.ogg":^  You will have to carry that cross for the rest of your life."^\
advsetwindow "03"

;ld c,NAT_DefA1,80

langjp「……はい。@その覚悟です…。」\
;＜夏妃
langen:dwave 0, "voice\03\80900060.ogg":^"...Yes.^@:dwave 0, "voice\03\80900061.ogg":^  I am prepared to do so..."^\

