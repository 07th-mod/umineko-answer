_ld r,":b;sprites\kan\1\kan_a11_nayamu1.png",24
advsetwindow "16"

langjp「……空気を読むってとこは、あったかもしれない。」@
;＜嘉音
langen:dwave 0, "voice\16\70600012.ogg":^"...I think there was a need to blend with the community."^\

_ld c,":b;sprites\goh\1\goh_a11_omakase2.png",24
