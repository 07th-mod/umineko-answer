langen:dwave 0, "voice\11\82000278.ogg":^"Stupid...^@:dwave 0, "voice\11\82000279.ogg":^  Stupid...!^@:dwave 0, "voice\11\82000280.ogg":^  I won't accept it...^@:dwave 0, "voice\11\82000281.ogg":^  I'll never...acknowledge this farce as the truth...!!"^\

