locate 0, 5 ;<CENTER_TEXT>
langen:dwave 0, "voice\10\70100130.ogg":^You can bet that Mom's crying in heaven!!^@:dwave 0, "voice\10\70100131.ogg":^  You bastard, you're embarrassing!!^@
;advsetwindow "10"
;locate 0,4;utmeta-break
