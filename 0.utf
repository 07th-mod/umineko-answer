goto *quiz
;■霧江の出題
;　三人の女の子がいます。@
;美代子「私が一番年上よ。」@
;沙都子「梨花は一番年上じゃありませんわ。」@
;梨花「美代子は嘘吐きなのですよ。@にぱー。」@
; There were three girls.
; Miyoko: "I'm the oldest."
; Satoko: "Rika isn't the oldest."
; Rika: "Miyoko is a liar.  Nipa-."

;　この中の、一番年上の子だけが本当のことを言っています。@
;　さて、一番年上の子は一体、誰…？@
; Only the oldest of the three girls is speaking the truth.
; So, who is the oldest...?

;選択肢３つ。@「美代子」「沙都子」「梨花」
; A. "Miyoko" B. "Satoko" C. "Rika"


;■ヒント

*eva_hinto_11
mov %play_scene,80020 ;シーン変数の入力
mov %r_hyouji_side,0
mov %r_hyouji_cha,en2

bg new_mhal_h1a,24
_ld r,":b;sprites\eva\1\eva_a11_hohoemi1.png",24
advsetwindow "05"

langjp「あぁ、典型的な嘘吐き問題ってヤツね。@伯母さん得意よ。」@
;＜絵羽
langen:dwave 0, "voice\05\81000413.ogg":^"Ah, it's a classic liar puzzle.^@:dwave 0, "voice\05\81000414.ogg":^  Those are the ones I'm best at."^\

_ld l,":b;sprites\rud\1\rud_a11_def2.png",23
advsetwindow "08"

langjp「得意なのは嘘を吐く方だけどな？」\
;＜留弗夫
langen:dwave 0, "voice\08\81200045.ogg":^"Don't you mean lying is what you're best at?"^\

;留弗夫と絵羽の演出

cl r,0
_ld c,":b;sprites\eva\1\eva_b25_warai1.png",24
se1 47
quakey 1,300
_ld l,":b;sprites\rud\1\rud_a11_naku2.png",80
advsetwindow "-1"

langjp　すごい。@お父さんの耳って、あんなに伸びるんだ。\
langen^Wow.^@^  I didn't think Dad's ears could stretch that far.^\

bg new_mhal_h1c,24
_ld r,":b;sprites\kir\1\kir_a11_def1.png",24
advsetwindow "09"

langjp「１人だけが本当のことを言ってる。@そして、他は全員、嘘を吐いているということ。@だから、２人の言い分が本当になるような解釈は間違いってことね。」\
;＜霧江
langen:dwave 0, "voice\09\81300040.ogg":^"Only one of them is speaking the truth.^@:dwave 0, "voice\09\81300041.ogg":^  And both of the others are lying.^@:dwave 0, "voice\09\81300042.ogg":^  So, if you find an answer where two of them are telling the truth, it's wrong."^\

_ld l,":b;sprites\en2\1\en2_a11_def2b.png",23
advsetwindow "11"

langjp「………よく、わかんない。@もっとヒントほしい。」@
;＜縁寿
langen:dwave 0, "voice\11\82000693.ogg":^"...I don't really get it.^@:dwave 0, "voice\11\82000694.ogg":^  I want some more hints."^\

_ld r,":b;sprites\kir\1\kir_a11_warai2.png",80
advsetwindow "09"

langjp「私のヒントはここまで。@あとは絵羽伯母さんと相談してご覧なさい。」\
;＜霧江
langen:dwave 0, "voice\09\81300043.ogg":^"That's all for my hint.^@:dwave 0, "voice\09\81300044.ogg":^  If you want more, try talking to Aunt Eva."^\

_ld l,":b;sprites\en2\1\en2_a11_def1.png",80
advsetwindow "11"

langjp「絵羽伯母さんっ。」\
;＜縁寿
langen:dwave 0, "voice\11\82000695.ogg":^"Aunt Eva!"^\

ut_mld c,":b;sprites\eva\1\eva_a11_hohoemi1.png",24
advsetwindow "05"

langjp「ポイントは梨花ね。@梨花は美代子が嘘吐きだと言ってるわ。@ということは、美代子が本当のことを言ってるなら梨花は嘘吐きだし、美代子が嘘を吐いてるなら梨花は本当のことを言っている。@……つまり、矛盾し合う２人は、確実にどちらかが嘘吐きで、同時に確実にどちらかが真実を語っているということになるわけ。」\
;＜絵羽
langen:dwave 0, "voice\05\81000415.ogg":^"Rika is the key.^@:dwave 0, "voice\05\81000416.ogg":^  Rika says that Miyoko is a liar.^@:dwave 0, "voice\05\81000417.ogg":^  So, if Miyoko is speaking the truth, then Rika is a liar, and if Miyoko is lying, then Rika is speaking the truth.^@:dwave 0, "voice\05\81000418.ogg":^  ...In other words, since that pair contradicts each other, we know that one of them is lying and one is telling the truth."^\

_ld r,":b;sprites\kir\1\kir_a27_futeki1.png",80
advsetwindow "09"

langjp「さすが絵羽姉さん。@そういうことね。@嘘吐き問題では、矛盾する証言同士は、その中のどちらかが真実であることを確定させるの。@その時点で、沙都子は漏れるから嘘吐きが確定。@/
langen:dwave 0, "voice\09\81300045.ogg":^"That's Eva nee-san for you.^@:dwave 0, "voice\09\81300046.ogg":^  Exactly.^@:dwave 0, "voice\09\81300047.ogg":^  In liar games like this one, when you see a pair that contradicts each other, you know that one of them must be telling the truth.^@:dwave 0, "voice\09\81300048.ogg":^  Neither of them is Satoko, so she's already confirmed as a liar.^@/

_ld r,":b;sprites\kir\1\kir_a11_def1.png",80
advsetwindow "09"

langjp……くす、もう答えが出ちゃったわね。」\
;＜霧江
langen:dwave 0, "voice\09\81300049.ogg":^  ...*giggle*  Looks like the answer's already popped up."^\

_ld l,":b;sprites\en2\1\en2_a11_def3a.png",80
advsetwindow "11"

langjp「えっと、…………？？？」\
;＜縁寿
langen:dwave 0, "voice\11\82000696.ogg":^"Ummm, ......???"^\

mcl c,0
bg black,22

return



