_ld r,":b;sprites\goh\1\goh_a11_def1.png",24

bgm1 64
advsetwindow "-1"

langjp　それを出迎えるのは郷田だけでなく、嘉音の姿もあった。\
langen^Gohda wasn't the only one to greet them.^@^  Kanon was there too.^\

_ld r,":b;sprites\goh\1\goh_a11_omakase1.png",80
advsetwindow "17"

langjp「皆様、ご無沙汰をしております。@六軒島へようこそいらっしゃいました。」@
;＜郷田
langen:dwave 0, "voice\17\61700001.ogg":^"It has been quite some time, everyone.^@:dwave 0, "voice\17\61700002.ogg":^  Allow me to welcome you to Rokkenjima."^\

_ld l,":b;sprites\kan\1\kan_a12_nayamu1.png",80
advsetwindow "16"

langjp「……長旅、お疲れ様でした。@六軒島へようこそ……。」\
;＜嘉音
langen:dwave 0, "voice\16\60600103.ogg":^"...I hope that your long journey went smoothly.^@:dwave 0, "voice\16\60600104.ogg":^  Welcome to Rokkenjima..."^\

_ld r,":b;sprites\goh\1\goh_a11_omakase2.png",80
advsetwindow "17"

langjp　そうそう、お上手ですよ。@
langjp　郷田が小声で嘉音を褒める。@
langen:dwave 0, "voice\17\61700003.ogg":^Ah, good, good.^\
advsetwindow "-1"
langen^Gohda complimented Kanon in a whisper.^@
;br

_ld l,":b;sprites\kan\1\kan_a12_majime1.png",80
advsetwindow "-1"

langjp　それを嘉音はちょっぴりだけ不機嫌そうに無視して、親族たちへの会釈を続けていた。\
langen^Kanon ignored this, looking just a little sour, and continued to greet the incoming relatives.^\

bg black,22
fede 10,1000

bg new_ship_s1b,23
_ld r,":b;sprites\geo\1\geo_a11_warai1.png",23
advsetwindow "07"

