advsetwindow "-1"

langjp「しっかりしなさいよ、あんたに任せたでしょ？！@　何やってんのよ、鈍臭い！」@
;＜サタン
langen:dwave 0, "voice\40\72500014.ogg":^"Come on, that's your responsibility!^@:dwave 0, "voice\40\72500015.ogg":^  What have you been doing, idiot?!"^\

_ld l,":b;sprites\sha\1\sha_a11_komaru1.png",80
advsetwindow "15"

langjp「ほら、急いで探しておいで…。@奥様に見つかる前に、急いで急いで…。」\
;＜紗音
langen:dwave 0, "voice\15\70500117.ogg":^"Quickly, go and find it...^@:dwave 0, "voice\15\70500118.ogg":^  You have to do it before Madam finds out..."^\

