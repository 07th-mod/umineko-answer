		if ?r[%scenario_Number][%r_hyouji_cha_ma][condition] <= 0 goto *rmenu_custom_btlp_50_ep5_2
			mov %tmp,?r[%scenario_Number][%r_hyouji_cha_ma][condition] : inc %tmp : mov ?r[%scenario_Number][%r_hyouji_cha_ma][condition],%tmp
			seplay 9,1100
		*rmenu_custom_btlp_50_ep5_2
		
		if %r_hyouji_cha_ma != 0 && %r_killeveryone != 1 goto *rmenu_custom_btlp_100_ep5_2
