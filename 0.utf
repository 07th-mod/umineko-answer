;＜金蔵
langen:dwave 0, "voice\01\51500156.ogg":^".........Indeed.^@:dwave 0, "voice\01\51500157.ogg":^  ...She has done well supporting my foolish son."^\

mcl l,24
ut_mld l,":b;sprites\bea\1\bea_a11_def2.png",23
