langen:dwave 0, "voice\52\75200024.ogg":^"Ahahahaha!^@:dwave 0, "voice\52\75200025.ogg":^  No one knows the truth!"^\

_ld r,":b;sprites\cla\1\cla_a11_nayamu1.png",80
advsetwindow "02"

langjp「島に子供は朱志香しかいない。@使用人たちはよく娘と遊んでくれたようだが、やはり娘は歳の近い友人を望んでいたよ。@学校だけでなく、家でも遊べる友人をね。」\
;＜蔵臼
langen:dwave 0, "voice\02\70800035.ogg":^"Jessica was the only child on the island.^@:dwave 0, "voice\02\70800036.ogg":^  The servants would often play with my daughter, but she wanted a friend of her own age.^@:dwave 0, "voice\02\70800037.ogg":^  Someone she could play with at home, as well as at school."^\


mcl l,0

