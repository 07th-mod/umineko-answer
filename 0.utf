langen:dwave 0, "voice\19\51900003.ogg":^"It's the other way around.^@:dwave 0, "voice\19\51900004.ogg":^  ...We should be glad that he was in high spirits until the very end."^\

_ld l,":b;sprites\cla\1\cla_a11_nayamu1.png",80
advsetwindow "02"

