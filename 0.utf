bg new_mhal_h1a,22
_ld c,":b;sprites\mar\1\mar_a11_akuwarai1.png",23
advsetwindow "13"

langjp「きっひひひひひひひひ！@　縁寿にはすごい難しい問題を出しちゃうよ！@　取って置きの難しい問題でいじめて、メダルなんか絶対にあげなーい！」@
;＜真里亞
langen:dwave 0, "voice\13\80400079.ogg":^"Kihhihihihihihihi!^@:dwave 0, "voice\13\80400080.ogg":^  I'm gonna give Ange a reeeeally hard one!^@:dwave 0, "voice\13\80400081.ogg":^  I'll trick her with my extra-hard puzzle and make sure she neeever gets my medal!"^\

_ld r,":b;sprites\en2\1\en2_a11_def2b.png",80
advsetwindow "11"

langjp「縁寿、解けるもん、@絶対、解けるもん…！」\
;＜縁寿
langen:dwave 0, "voice\11\82000660.ogg":^"I'll solve it.^@:dwave 0, "voice\11\82000661.ogg":^  I'll definitely solve it...!"^\
advsetwindow "-1"

langjp　真里亞と縁寿は目を合わせるなり、いきなり喧嘩を始める。@
langjp　歳が近いこの二人は、とても仲良しだが、同時にとてもよく喧嘩する。@
langen^As soon as Maria and Ange crossed gazes, they started fighting.^@
advsetwindow "-1"
langen^The two girls so close in age were really good friends, but they also fought a lot.^@
advsetwindow "-1"
;br
langjp　特に、お互いが競い合うタイプのゲームの際には、いつも大騒ぎなのだ。\
langen^Especially when they were opponents in a game.^\

bg new_mhal_h1c,23
_ld l,":b;sprites\eva\1\eva_a11_hohoemi1.png",23
advsetwindow "05"

langjp「真里亞ちゃんは色々なクイズを知ってそうね。@楽しみだわ。@よろしくね。」@
;＜絵羽
langen:dwave 0, "voice\05\81000366.ogg":^"Maria-chan probably knows tons of different quizzes.^@:dwave 0, "voice\05\81000367.ogg":^  This should be interesting.^@:dwave 0, "voice\05\81000368.ogg":^  Let's have it."^\

_ld r,":b;sprites\mar\1\mar_a11_akuwarai2.png",24
advsetwindow "13"

