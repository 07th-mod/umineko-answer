	lspnewold %tmp,$?r[%scenario_Number][%r_hyouji_cha_ma][?r[%scenario_Number][%r_hyouji_cha_ma][condition]],"/2,0,3",?r[%scenario_Number][%r_hyouji_cha_ma][itiran_x],?r[%scenario_Number][%r_hyouji_cha_ma][itiran_y]
return
