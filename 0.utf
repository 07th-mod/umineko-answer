*return_rmenu_main
	if %scenario_Number = 5 goto *rmenu_main_ep5
	if %scenario_Number = 6 goto *rmenu_main_ep6
	if %scenario_Number = 7 goto *rmenu_main_ep7
	if %scenario_Number = 8 goto *rmenu_main_ep8

mesbox "シナリオ番号エラー","シナリオ番号がおかしいです"

;********************************************************************************
; 右クリックシステムを抜ける処理
*r_exit_ep5
	btndef ""
	gosub *r_gazou_shokika_ep5
	csp r_bg_lsp
	csp r_black_lsp
	seplay 9,1100
	print 1
	texton
	if %monoflg = 1 mono 1
	if %monoflg = 2 mono 2

return ;右クリックシステムを抜ける

