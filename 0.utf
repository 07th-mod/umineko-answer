return

~
mov %free1, ?r[%scenario_Number][%r_hyouji_cha_ma][r_ishou]
itoa $Free1,%Free1
add$Free1,","
mov %free1, ?r[%scenario_Number][%r_hyouji_cha_ma][condition]
itoa $Free2,%Free1
add $Free1,$Free2
caption $Free1
click
end

