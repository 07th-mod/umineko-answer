langen:dwave 0, "voice\16\80600026.ogg":^"...It is as you say.^@:dwave 0, "voice\16\80600027.ogg":^  It seems you've already found the answer."^\

_ld c,":b;sprites\eva\1\eva_a11_hohoemi1.png",80
advsetwindow "05"

langjp「これは縁寿ちゃんには無理な問題だわ。@最低でも中学生以上の問題よ。@これ、私が答えるわ！@　縁寿ちゃん、いい？」\
;＜絵羽
langen:dwave 0, "voice\05\81000296.ogg":^"This puzzle is impossible for Ange-chan.^@:dwave 0, "voice\05\81000297.ogg":^  You'd need to have gone to middle school at the very least.^@:dwave 0, "voice\05\81000298.ogg":^  I'll answer!^@:dwave 0, "voice\05\81000299.ogg":^  Is that all right, Ange-chan?"^\

